                "description": "開始日 (YYYY-MM-DD形式)"
              },
              "filter_rokuyo": {
                "type": "string",
                "description": "六曜フィルター（大安・仏滅・先勝・友引・先負・赤口）"
              },
              "filter_rekichu": {
                "type": "string",
                "description": "暦注フィルター（一粒万倍日・天赦日・不成就日等）"
              }
            }
