          "name": "find_best_days",
          "canonical_hash": "sha256:91c923c1209e6fd3bb5f804743d971041287f067f140789128d766a76de4845a",
          "description": "指定した用途（結婚・開業・引っ越し等）に最適な日を\n期間内から探してランキングで返します。\n六曜と暦注を総合的に評価し、最も縁起の良い日から順に返します。\n\n使用場面:\n- 「来月で結婚式に最適な日はいつ？」\n- 「今年中に開業するなら何日がベスト？」\n- 「4月の大安の一粒万倍日はある？」\n- 「引っ越しに良い日を3つ教えて」\n\nFinds the best auspicious days for a specific purpose (wedding, business opening,\nmoving, etc.) within a date range. Returns ranked results combining Rokuyo and\nRekichu evaluations.",
          "is_mutating": false,
          "property_keys": [
            "end_date",
            "limit",
            "purpose",
            "start_date"
          ],
          "required_keys": [],
          "parameter_types": {
            "limit": "integer",
            "purpose": "string",
            "end_date": "string",
            "start_date": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "default": 5,
                "maximum": 20,
                "minimum": 1,
                "description": "取得件数（デフォルト: 5、最大: 20）"
              },
              "purpose": {
                "enum": [
                  "wedding",
                  "funeral",
                  "moving",
                  "construction",
                  "business",
                  "car_delivery",
                  "marriage_registration",
                  "travel"
                ],
                "type": "string",
                "description": "用途 (wedding/funeral/moving/construction/business/car_delivery/marriage_registration/travel)"
              },
              "end_date": {
                "type": "string",
                "description": "検索終了日 (YYYY-MM-DD形式)"
              },
              "start_date": {
                "type": "string",
                "description": "検索開始日 (YYYY-MM-DD形式)"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:cbac89376e69e6119b1949d425d2f4223ccf4a06e6d87a23e013d17ba87956ef"
        },
        {
          "name": "get_calendar_range",
          "canonical_hash": "sha256:6d02adf18fa1584d0794266172a5f9905265a2f86ba69b9d5275c79bf338b0b8",
          "description": "日付範囲内の暦情報を一括取得します。\n六曜や暦注でフィルタリングできます。\n\n使用場面:\n- 「来月の大安を全部教えて」\n- 「今年の天赦日一覧」\n- 「今月の一粒万倍日はいつ？」\n\nRetrieves calendar information for a date range with optional filtering\nby Rokuyo or Rekichu type.",
          "is_mutating": false,
          "property_keys": [
