          "property_keys": [
            "content",
            "memory_type",
            "metadata"
          ],
          "required_keys": [
            "content"
          ],
          "parameter_types": {
            "content": "string",
            "memory_type": "string",
            "metadata": "object"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "description": "Memory content to store (required)."
              },
              "memory_type": {
                "type": "string",
                "description": "Memory type (e.g. long_term, short_term)."
              },
              "metadata": {
                "type": "object",
                "description": "Arbitrary metadata object attached to the memory."
              }
            },
            "required": [
              "content"
            ]
          },
