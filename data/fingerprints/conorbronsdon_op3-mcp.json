          "name": "op3_downloads_timeseries",
          "canonical_hash": "sha256:be9756f2e77339e4513b9af06f67d7a23287da32f2cd8119ebb53b8162735f1e",
          "description": "Fetch raw download records for a show from OP3 over a date range. Returns individual download events (time, country, app, device). This is the low-level feed behind the other tools. Use it when you need to filter by episode or a specific date window. Keep limit low (records are verbose). For totals or geography summaries, prefer op3_show_downloads / op3_top_countries.",
          "is_mutating": false,
          "property_keys": [
            "end",
            "episode_id",
            "limit",
            "show_uuid",
            "start"
          ],
          "required_keys": [
            "show_uuid"
          ],
          "parameter_types": {
            "show_uuid": "string",
            "start": "string",
            "end": "string",
            "episode_id": "string",
            "limit": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "show_uuid": {
                "type": "string",
                "description": "OP3 show UUID (32 hex chars)."
              },
              "start": {
                "type": "string",
                "description": "Start time, ISO date or datetime (e.g. 2026-06-01 or 2026-06-01T00:00:00Z)."
              },
              "end": {
                "type": "string",
                "description": "End time, ISO date or datetime."
              },
              "episode_id": {
                "type": "string",
                "description": "Filter to a single episode by its OP3 episodeId."
              },
              "limit": {
                "type": "string",
                "description": "Max records to return (default 20, cap 200). Records are verbose; keep this small.",
                "default": 20
              }
            },
