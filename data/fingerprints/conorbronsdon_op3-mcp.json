        {
          "name": "op3_episode_downloads",
          "canonical_hash": "sha256:6b61e1c6d206c19cc5a35858f929b84f6623c520c3bb68791689ddadf4bc87a5",
          "description": "Get per-episode download counts for a show from OP3: for each recent episode, downloads in the first 1/3/7/30 days after publish and all-time. Good for comparing how episodes perform. Needs a show UUID. Use limit to cap how many episodes come back.",
          "is_mutating": false,
          "property_keys": [
            "limit",
            "show_uuid",
            "sort_by"
          ],
          "required_keys": [
            "show_uuid"
          ],
          "parameter_types": {
            "show_uuid": "string",
            "limit": "string",
            "sort_by": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "show_uuid": {
                "type": "string",
                "description": "OP3 show UUID (32 hex chars)."
              },
              "limit": {
                "type": "string",
                "description": "Max episodes to return, newest first (default 10).",
                "default": 10
              },
              "sort_by": {
                "type": "string",
                "description": "Order results: recent (default), all-time downloads, or 7-day downloads.",
                "default": "recent",
                "enum": [
                  "recent",
                  "downloads_all",
                  "downloads7"
                ]
              }
            },
            "required": [
              "show_uuid"
            ]
