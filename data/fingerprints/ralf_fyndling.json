                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 2
                },
                "maxItems": 6,
                "description": "Exclude recipes that contain any of these ingredients (partial match). E.g. [\"Ingwer\"] to skip ginger dishes. German names preferred."
              }
            }
