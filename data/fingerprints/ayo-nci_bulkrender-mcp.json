          "name": "acp_create_session",
          "canonical_hash": "sha256:c4357acaa3c15a69bd581a29449760681fcfe8d65360adc3a78e821697e4aca4",
          "description": "[No account needed] Create a pay-per-session document generation job. Pricing: $0.10/credit, DOCX = 1 credit, PDF = 2 credits, $1.00 minimum. Pass records[] (max 200). Returns session_id, amount_due, checkout_url (Stripe), and expires_at. Poll acp_get_session after payment. Errors: 400 = invalid template_id or missing required fields.",
          "is_mutating": false,
          "property_keys": [
            "agentEmail",
            "bearerToken",
            "outputFormat",
            "records",
            "templateBuffer",
            "templateId",
            "templateName",
            "templateType"
          ],
          "required_keys": [
            "agentEmail",
            "bearerToken",
            "records",
            "templateType"
          ],
          "parameter_types": {
            "bearerToken": "string",
            "templateType": "string",
            "templateId": "string",
            "templateBuffer": "string",
            "templateName": "string",
            "records": "string",
            "agentEmail": "string",
            "outputFormat": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "bearerToken": {
                "type": "string",
                "description": "Any non-empty string — acts as your session bearer token"
              },
              "templateType": {
                "type": "string",
                "enum": [
                  "B",
                  "C"
                ]
              },
              "templateId": {
                "type": "string",
                "description": "Required for template_type B — UUID from acp_list_public_templates"
              },
              "templateBuffer": {
                "type": "string",
                "description": "Required for template_type C — base64-encoded DOCX content"
              },
              "templateName": {
                "type": "string",
                "description": "Required for template_type C — filename e.g. my-doc.docx"
              },
              "records": {
                "type": "string",
                "description": "Array of data objects, one per document (max 200). Each object fills one document using the template variables. All documents use the same template and output_format. Keys must match the template field_schema variables — missing keys render as empty strings."
              },
              "agentEmail": {
                "type": "string",
                "description": "Email address to associate with this session"
              },
              "outputFormat": {
                "type": "string",
                "description": "Output format for ALL documents in this session — docx (1 credit/$0.10) or pdf (2 credits/$0.20). $1.00 minimum applies.",
                "default": "docx",
                "enum": [
