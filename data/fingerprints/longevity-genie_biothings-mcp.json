      "tool_signatures": [
        {
          "name": "download_entrez_data",
          "canonical_hash": "sha256:467b2e6c619b35af6860191af505cce47c529568c99e99a5abacb41f16fedcd6",
          "description": "Download data from NCBI Entrez databases using Bio.Entrez.\n            \n            Downloads data records from specified NCBI Entrez databases. This tool is designed to be called \n            by automated agents (like LLMs) or other services.\n\n            **Critical Configuration:**\n            The server hosting this API *must* have the `ENTREZ_EMAIL` environment variable set\n            to a valid email address. NCBI requires this for Entrez queries to monitor usage\n            and prevent abuse. Without it, NCBI may block requests.\n\n            **Parameters:**\n            - `ids` (List[str], required): A list of unique identifiers for the records to fetch\n              from the specified Entrez database. Example: `[\"NM_000546.6\", \"AY123456.1\"]`\n            - `db` (DB_LITERAL, required): The target NCBI Entrez database.\n              Common choices for sequences: 'nucleotide', 'protein'.\n              Other examples: 'gene', 'pubmed', 'taxonomy'.\n              Ensure the `ids` provided are appropriate for the selected `db`.\n            - `reftype` (Literal[\"fasta\", \"gb\"], required): The desired format for the\n              downloaded data.\n                - \"fasta\": Returns data in FASTA format.\n                - \"gb\": Returns data in GenBank format.\n              Ensure the chosen `reftype` is compatible with the selected `db`.\n\n            **Returns:**\n            On success: Returns the downloaded data as a single raw string with the\n            data fetched from Entrez in the specified `reftype`.\n            \n            **Example Usage:**\n            To fetch the FASTA sequence for human TP53 mRNA (NM_000546.6):\n            ```\n            download_entrez_data(\n                ids=[\"NM_000546.6\"],\n                db=\"nucleotide\",\n                reftype=\"fasta\"\n            )\n            ```\n            ",
          "is_mutating": false,
          "property_keys": [
            "db",
            "ids",
            "reftype"
          ],
          "required_keys": [
            "db",
            "ids",
            "reftype"
          ],
          "parameter_types": {
            "ids": "array",
            "db": "string",
            "reftype": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "ids": {
                "type": "array"
              },
              "db": {
                "type": "string"
              },
              "reftype": {
                "type": "string"
              }
            },
            "required": [
              "db",
              "ids",
              "reftype"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:1b59e09f4fef9cecc59a506aaaf98e3f9cfc00015c65cc81863f04f41338c6b2"
        },
        {
          "name": "download_entrez_data_local",
          "canonical_hash": "sha256:82a60f6cf2f15e14443b702f3cf041f32fe63df1879fef1794c22025385edeea",
          "description": "Download data from NCBI Entrez databases and save to local file.\n            \n            Same as download_entrez_data but saves the result to a local file instead of returning the content.\n            This is useful for large downloads or when you want to persist the data.\n\n            **Parameters:**\n            - `ids` (List[str], required): A list of unique identifiers for the records to fetch\n            - `db` (DB_LITERAL, required): The target NCBI Entrez database\n            - `reftype` (Literal[\"fasta\", \"gb\"], required): The desired format for the downloaded data\n            - `output_path` (Optional[str]): Custom output path. If None, generates unique filename\n            \n            **Returns:**\n            LocalFileResult containing:\n            - `path`: Path to the saved file\n            - `format`: File format used\n            - `success`: Whether the operation succeeded\n            - `error`: Error message if failed\n            \n            **Example Usage:**\n            ```\n            download_entrez_data_local(\n                ids=[\"NM_000546.6\"],\n                db=\"nucleotide\",\n                reftype=\"fasta\",\n                output_path=\"tp53_sequence.fasta\"\n            )\n            ```\n            ",
          "is_mutating": false,
          "property_keys": [
            "db",
            "ids",
            "output_path",
            "reftype"
          ],
          "required_keys": [
            "db",
            "ids",
            "reftype"
          ],
          "parameter_types": {
            "ids": "array",
            "db": "string",
            "reftype": "string",
            "output_path": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "ids": {
                "type": "array"
              },
              "db": {
                "type": "string"
              },
              "reftype": {
                "type": "string"
              },
              "output_path": {
                "type": "string"
              }
            },
            "required": [
              "db",
              "ids",
              "reftype"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:4ffee96cf800ff2ec5723c5486f08532258e4a3d3b0d1adb3f9491bab56ebd6b"
        }
