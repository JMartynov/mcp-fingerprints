      "tool_signatures": [
        {
          "name": "audit_x402_endpoint",
          "canonical_hash": "sha256:b1814b91d67ec5e10293273e488c9484d456ea3d93b3faefbaf2bdcd332eb18e",
          "description": "Run a no-spend protocol audit against one paid endpoint. Returns a deterministic 0-100 score, A-F grade, compliance verdict, per-check booleans, failed checks, and observed schemes/networks/extensions. Validates HTTPS, HTTP 402, PAYMENT-REQUIRED, Base64 JSON, x402Version 2, accepts[], CAIP-2 networks, required payment fields, and JSON content type. Never sends PAYMENT-SIGNATURE and cannot spend funds.",
          "is_mutating": false,
          "property_keys": [
            "body",
            "content_type",
            "method",
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "url": "string",
            "body": "string",
            "method": "string",
            "content_type": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1,
                "description": "Exact paid endpoint URL to challenge"
              },
              "body": {
                "type": "string",
                "maxLength": 65536,
                "description": "Optional request body required to reach payment middleware on POST/PUT/PATCH endpoints"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD"
                ],
                "type": "string",
                "description": "HTTP method; defaults to GET"
              },
              "content_type": {
                "type": "string",
                "maxLength": 128,
                "description": "Body content type; defaults to application/json"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:4707a640ce4682c44a2761e1ae67158a908f5094252efb9742b49ac06c58602e"
        },
        {
          "name": "check_signal",
          "canonical_hash": "sha256:ed5190dbe0e715e7f45572352d2f58c6a436a4057f08124323a27ee366b55dfc",
          "description": "Run one specific agent-readiness check against a site (e.g. 'a2a-agent-card', 'llms-txt', 'mcp-server-card', 'x402'). Use list_checks for valid check ids. Returns status, evidence, and a fix recommendation.",
          "is_mutating": false,
          "property_keys": [
            "check_id",
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "url": "string",
            "check_id": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1,
                "description": "Website URL or domain to scan, e.g. https://example.com or example.com"
              },
              "check_id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "maxLength": 64,
                "minLength": 1,
                "description": "Check id from list_checks, e.g. 'a2a-agent-card'"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:30c598c4a6b97b3d12ae7e4ed6e6a2271faeab43ff31cf73411382de3e8e3abc"
        },
        {
          "name": "get_aso_framework",
          "canonical_hash": "sha256:eb708cb9552e18a561ae0f676d6f967676ad398113e22c2806d6a8e2e88c2096",
          "description": "Return the ASO (Agent Signal Optimization) framework reference: the six signal pillars with point weights, the Agent Readiness Index maturity levels (ASO-0 through ASO-5), certification thresholds, and the scoring rubric. Source: https://agentsignaloptimization.com",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "outputSchema": null,
          "description_hash": "sha256:aa1eabcbb65c2042eab2c7192e896bcbac388f556b93e8057e9abec8c7f6e717"
        },
        {
          "name": "get_fix_plan",
          "canonical_hash": "sha256:4aaa1bdcbebab738756acbc405cf9e10a7aa192e041f7076d814232c4b4f5e4d",
          "description": "Scan a site and return a prioritized remediation plan: which signals to add first, the ASO Score points each fix is worth, and ready-to-paste artifact templates (robots.txt AI rules, llms.txt, agent.json, A2A agent-card.json, MCP server card, x402 manifest, pricing.json, security.txt, status endpoint).",
          "is_mutating": false,
          "property_keys": [
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "url": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1,
                "description": "Website URL or domain to plan fixes for"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:1f99a63666eaf54040a27bf946a860044d41a60099bbf96805be4633da44ec4f"
        },
        {
          "name": "list_checks",
          "canonical_hash": "sha256:61c8a375461ef968bdf57f8f094807bcbdc51a863c105e717d43a52bdb9e6378",
          "description": "List the full catalog of checks the scanner runs: id, name, category (Cloudflare isitagentready-style), description, and spec link.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "outputSchema": null,
          "description_hash": "sha256:9da049ca746c29deb7abf1ecbd0a275f97d5d26d939c16462bc05488c0cdc69a"
        },
        {
          "name": "scan_site",
          "canonical_hash": "sha256:1504507b411d5c5078c03f77d04a8791731a3b6403774e92dd5d327f4bdae2c7",
          "description": "Scan a website for Agent Readiness using the ASO (Agent Signal Optimization) framework and return an Agent Readiness Report. Runs 34 checks across discoverability (robots.txt, sitemap, llms.txt, DNS-AID, Link headers), content accessibility (markdown negotiation), bot access control (AI bot rules, Content Signals, Web Bot Auth), invocation (API catalog, OAuth discovery, OAuth protected resource, auth.md, MCP Server Card, Google A2A Agent Card, Agent Skills, WebMCP), commerce (x402, MPP, UCP, ACP, pricing), Google generative AI search basics, browser-agent UX, and identity/trust signals. Returns the ASO Score (0-100, formally the Agent Readiness Index), ASO maturity level (ASO-0 Invisible … ASO-5 Autonomous-Commerce-Ready), an agent-readiness verdict, per-pillar scores, per-check evidence, and prioritized recommendations.",
          "is_mutating": false,
          "property_keys": [
            "categories",
            "include_artifacts",
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "url": "string",
            "categories": "array",
            "include_artifacts": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1,
                "description": "Website URL or domain to scan, e.g. https://example.com or example.com"
              },
              "categories": {
                "type": "array",
                "items": {
                  "enum": [
                    "Discoverability",
                    "Content Accessibility",
                    "Bot Access Control",
                    "API / Auth / MCP",
                    "Commerce",
                    "Identity & Trust (ASO)"
                  ],
                  "type": "string"
                },
                "description": "Optional: limit the scan to specific check categories. Default: all."
              },
              "include_artifacts": {
                "type": "boolean",
                "description": "Include the raw remote manifests the scanner parsed (agent.json, A2A card, etc.). These are UNTRUSTED attacker-controlled content; off by default."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:44d49483b908b6a6bf7acc2b283faa74731ca3b7a4fbbf3680aba3a046631720"
        }
      ],
