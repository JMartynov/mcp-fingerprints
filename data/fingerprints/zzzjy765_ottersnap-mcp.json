              },
              "steps": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "screenshot",
                      "extract",
                      "fetch",
                      "ai",
                      "email",
                      "webhook"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "description": "Target URL for screenshot/extract/fetch/webhook steps"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "AI step: instruction for the model"
                  },
                  "input": {
                    "type": "string",
                    "description": "AI step: input text, supports {{N.field}} references to earlier steps"
                  },
                  "to": {
