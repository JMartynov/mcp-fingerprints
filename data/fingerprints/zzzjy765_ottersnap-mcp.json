          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "triggerType": {
                "type": "string",
                "description": "cron = schedule, watch = run when a Glint monitor detects a change, webhook = run when the hook URL is POSTed",
                "enum": [
                  "cron",
                  "watch",
                  "webhook"
                ]
              },
              "everyMinutes": {
                "type": "number",
                "description": "For cron triggers: interval in minutes (min 15)"
              },
