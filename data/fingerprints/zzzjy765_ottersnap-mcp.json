          "name": "workflow_create",
          "canonical_hash": "sha256:f602575971ce467f6b405b088861e63299c351d4c5708dd239d0f28a61f03d69",
          "description": "Create a Glint workflow — an automation that runs steps (screenshot, extract, fetch, AI, email, webhook) on a trigger (schedule / page-change monitor / inbound webhook). 1 credit per run.",
          "is_mutating": false,
          "property_keys": [
            "everyMinutes",
            "name",
            "steps",
            "triggerType",
            "watchId"
          ],
          "required_keys": [
