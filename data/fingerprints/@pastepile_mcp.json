        {
          "name": "pastepile_restore",
          "canonical_hash": "sha256:74e6655bb6925c34caca23d2b824e98d02c2efb35e5375a166f5987541a9ada3",
          "description": "Put an earlier version of a memory back as the current one. This is not destructive: what is current now is preserved as a new version first, so a restore can itself be undone. Use it when a memory was overwritten with something worse, or to return to a known-good state after an experiment. Name the memory by",
          "is_mutating": false,
          "property_keys": [
            "session",
            "slug",
            "version"
          ],
          "required_keys": [
            "version"
          ],
