                "type": "string",
                "description": "UUID of the contract"
              },
              "profile": {
                "type": "string"
              }
            },
            "required": [
              "contract_id",
              "profile"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:b532e825bceb37b173d71e808f56b539365c3021c7f20f56898648b58a054f54",
