                  "www.amazon.sa",
                  "www.amazon.se",
                  "www.amazon.sg",
                  "www.amazon.com.tr",
                  "www.amazon.co.za"
                ],
                "type": "string",
                "description": "Amazon domain to use. Default is www.amazon.com."
              },
              "language": {
                "enum": [
                  "AR",
                  "BN",
                  "CS",
                  "DA",
                  "DE",
                  "EN",
                  "ES",
                  "FR",
                  "HI",
