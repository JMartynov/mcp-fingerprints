            "domains": "string",
            "batchSize": "string",
            "skipCache": "string",
            "failOnMostlyEmpty": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "max_charge_usd": {
                "type": "number"
              },
              "domain": {
                "type": "string",
                "description": "Bare company domain to enrich, e.g. stripe.com. Provide this or domains."
              },
              "company_name": {
                "type": "string",
                "description": "Optional company name, used as a fallback label when the page does not expose one."
              },
              "domains": {
                "type": "string",
                "description": "List of bare domains for batch processing. Takes precedence over domain."
              },
              "batchSize": {
                "type": "string",
                "description": "Domains enriched concurrently per wave in batch mode. Default 5, maximum 10."
              },
              "skipCache": {
                "type": "string",
                "description": "Force a fresh enrichment and ignore the 7 day result cache."
              },
              "failOnMostlyEmpty": {
                "type": "string",
                "description": "By default the run ends FAILED when more than half the rows resolve no firmographic field (industry, employee count, HQ, or founded year); the rows are still saved, each with resolution_status and empty_reason. Set false to end SUCCEEDED with a warning instead, so this tool returns the rows rather than an error. Default: true."
              }
            },
