          "canonical_hash": "sha256:3f1545eef2770451168ace1acf33d914b55020797d1b035d49e7d2a229d9d8b0",
          "description": "Enrich a company domain into structured firmographics: employee band, industry, HQ, founded year, revenue estimate, logo, and description, with source provenance. Parsed from the company",
          "is_mutating": false,
          "property_keys": [
            "batchSize",
            "company_name",
            "domain",
            "domains",
            "failOnMostlyEmpty",
            "max_charge_usd",
