        {
          "name": "compute_bazi_chart",
          "canonical_hash": "sha256:f275045c9f0c9ad9d3db9855b4f4e027cc5682522282bbfb8e8a7e4a94acf22f",
          "description": "Compute a full Chinese Bazi (八字, Four Pillars of Destiny) chart from a birth date, time, and place. Returns the four pillars, Day Master, Ten Gods, Hidden Stems, Five Elements, Na Yin, Growth Stages, Shen Sha, branch relations, Luck Pillars, and the current year, computed with True Solar Time and historical daylight-saving handling. Provide a birth city (use search_cities to resolve it) for accurate true solar time, or pass longitude and utcOffset directly.",
          "is_mutating": false,
          "property_keys": [
            "city",
            "day",
            "dayRule",
            "gender",
            "hour",
            "longitude",
            "minute",
            "month",
            "timeUnknown",
            "trueSolarTime",
            "utcOffset",
            "year",
            "yearRule"
          ],
          "required_keys": [
            "day",
            "gender",
            "month",
            "year"
          ],
          "parameter_types": {
            "year": "number",
            "month": "number",
            "day": "number",
            "hour": "number",
            "minute": "number",
            "gender": "string",
            "timeUnknown": "boolean",
            "city": "string",
            "longitude": "number",
            "utcOffset": "number",
            "trueSolarTime": "boolean",
            "dayRule": "string",
            "yearRule": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "year": {
                "type": "number",
                "description": "Birth year, e.g. 1990"
              },
              "month": {
                "type": "number",
                "description": "Birth month 1-12"
              },
              "day": {
                "type": "number",
                "description": "Birth day 1-31"
              },
              "hour": {
                "type": "number",
                "description": "Birth hour 0-23 (local clock time as recorded)",
                "default": 0
              },
              "minute": {
                "type": "number",
                "description": "Birth minute 0-59",
                "default": 0
              },
              "gender": {
                "type": "string",
                "description": "Needed for the luck-pillar direction",
                "enum": [
                  "male",
                  "female"
                ]
              },
              "timeUnknown": {
                "type": "boolean",
                "description": "True if the birth time is unknown; the hour pillar is then tentative",
                "default": false
              },
              "city": {
                "type": "string"
              },
              "longitude": {
                "type": "number",
                "description": "Birth longitude in degrees East (negative = West). Use instead of city."
              },
              "utcOffset": {
                "type": "number",
                "description": "UTC offset in hours (e.g. 8 for China). Use with longitude when no city is given."
              },
              "trueSolarTime": {
                "type": "boolean",
                "description": "Apply true-solar-time correction (recommended)",
                "default": true
              },
              "dayRule": {
                "type": "string",
                "description": "When a new day begins: 23:00 Zi hour (default) or midnight",
                "default": "zi23",
                "enum": [
                  "zi23",
                  "midnight"
                ]
              },
              "yearRule": {
                "type": "string",
                "description": "Year boundary: Li Chun (default) or Lunar New Year",
                "default": "lichun",
                "enum": [
                  "lichun",
                  "cny"
                ]
              }
            },
            "required": [
              "day",
              "gender",
              "month",
              "year"
            ]
          },
