          "canonical_hash": "sha256:5f0d7b868603f6f213ec24e160749bf633412e30ab5bcc9133a93d60da51c2a8",
          "description": "Use Cursor Agent as a model-neutral, read-only consultation harness. The provider and exact Cursor catalog model ID are separate required fields. Runs ",
          "is_mutating": false,
          "property_keys": [
            "destructiveHint",
            "idempotentHint",
            "openWorldHint",
            "readOnlyHint",
            "title"
