        {
          "name": "ask-codex",
          "canonical_hash": "sha256:1405e07160f42aea5e9a98c58e33579c82b3b0b3ea5c817c8ea10aa6b5f5a137",
          "description": "Send a prompt to OpenAI Codex CLI (defaults to ${FACTORY_DEFAULT_MODEL} with automatic fallback on quota errors). Use for code review, second opinions, analysis, and AI-to-AI collaboration. Do not override the model parameter unless the user explicitly asks. Returns both human-readable text and a structured response (provider, model, sessionId, usage) via outputSchema. Calls are ephemeral by default; pass sessionId:",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
