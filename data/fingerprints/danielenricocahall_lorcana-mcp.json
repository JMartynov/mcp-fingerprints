        {
          "name": "deck_stats",
          "canonical_hash": "sha256:c512eddf2a16ad9473981c9147e46900766bfacf8f0dfef9172055008c6b5bee",
          "description": "Compute summary stats for a Lorcana deck: ink curve (copies at each cost), color split (copies per color — dual-ink contributes to BOTH buckets, so the sum may exceed total_cards), inkable/uninkable counts, type breakdown (Character/Action/Item/Song/Location), `keyword_counts` (copies per keyword — Evasive, Ward, Bodyguard, Shift, Singer, ...), `subtype_counts` (copies per subtype — Floodborn, Hero, Puppy, ...), and `card_keywords` (per-card keyword tags, so archetype questions like 'how many Evasive bodies does this run?' are answerable without a follow-up search_cards call). Each entry is `{name: str, count: int}` where `name` is the card's `full_name`. Names that don't resolve are listed under `unresolved` and excluded from the per-card stats (but still counted in total_cards).",
          "is_mutating": false,
          "property_keys": [
            "deck"
          ],
          "required_keys": [
            "deck"
          ],
          "parameter_types": {
            "deck": "array"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "deck": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "deck"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:936a7bc06c26f147ea6358e05d86730837a90f74cc4dd38691a37f11ef11ad33",
