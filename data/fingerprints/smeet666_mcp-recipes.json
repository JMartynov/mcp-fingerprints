          "inputSchema": {
            "type": "object",
            "properties": {
              "factor": {
                "type": "number",
                "maximum": 1000,
                "description": "What to multiply by. Give exactly one of: 'factor', or both 'from_servings' and 'to_servings'.",
                "exclusiveMinimum": 0
              },
              "language": {
                "enum": [
                  "auto",
                  "fr",
                  "en",
                  "es"
                ],
                "type": "string",
                "default": "auto",
                "description": "'auto' reads each line on its own, which is what a list holding more than one language needs. Name a language to read every line that way."
              },
              "ingredients": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                },
                "maxItems": 200,
                "minItems": 1,
                "description": "The lines as written, one ingredient each, such as '200 g de farine' or '3 eggs'. One line, not a whole recipe."
              },
              "to_servings": {
