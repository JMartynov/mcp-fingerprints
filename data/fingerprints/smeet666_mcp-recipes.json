        {
          "name": "search_recipes",
          "canonical_hash": "sha256:7354ada894030a2ed9a9e46d01c5d729187e61813a7ff3d21a1ce76ca3936912",
          "description": "Search every recipe site at once and get one merged list.",
          "is_mutating": false,
          "property_keys": [
            "fan_out",
            "limit_per_source",
            "query",
            "sources"
          ],
          "required_keys": [],
          "parameter_types": {
            "query": "string",
            "fan_out": "boolean",
            "sources": "array",
            "limit_per_source": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1,
                "description": "A dish or an ingredient, in any of the languages the sources publish in."
              },
              "fan_out": {
                "type": "boolean",
                "default": true,
                "description": "Whether a question may also be sent in shorter wordings derived from it. On, because these indexes answer the words they are handed: a question written as a sentence comes back empty from a corpus holding several of the dish. Turn it off to send exactly the words typed; 'per_source' then names the wordings that were withheld."
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sources to ask, by id. Left out, they are all asked, which is the point of this tool. The ids are the ones 'per_source' reports."
              },
              "limit_per_source": {
                "type": "integer",
                "default": 5,
                "maximum": 25,
                "minimum": 1,
                "description": "Rows to take from each source, so one source cannot fill the whole list."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:79cea3c1183abc3783b007be24fe69ba1b8598b3a6adb3526051e47e15c43e75",
