          "name": "compare_recipes",
          "canonical_hash": "sha256:7dc04e1fd2cad5cd620e15ba53441be082d75db3e2b48edabbc5595c865796da",
          "description": "One dish, as each site writes it, side by side.",
          "is_mutating": false,
          "property_keys": [
            "dish",
            "max_step_chars",
            "max_steps",
            "sections",
            "servings",
            "sources"
          ],
          "required_keys": [],
          "parameter_types": {
            "dish": "string",
            "sources": "array",
            "sections": "array",
            "servings": "integer",
            "max_steps": "integer",
            "max_step_chars": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "dish": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1,
                "description": "The dish to compare, in any of the languages the sources publish in."
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sources to compare, by id. Left out, every source is read, which is the point of this tool. Name two or three to put particular traditions side by side. The ids are the ones 'per_source' reports."
              },
              "sections": {
                "type": "array",
                "items": {
                  "enum": [
                    "ingredients",
                    "steps",
                    "times",
                    "nutrition",
                    "tips",
                    "equipment"
                  ],
                  "type": "string"
                },
                "default": [
                  "ingredients"
                ],
                "description": "Which parts of each version to return. Several full recipes is a lot of text."
              },
              "servings": {
                "type": "integer",
                "maximum": 500,
                "minimum": 1,
                "description": "Rescale every version to this many, which is what makes the lists comparable."
              },
              "max_steps": {
                "type": "integer",
                "default": 10,
                "maximum": 100,
                "minimum": 1,
                "description": "Steps to return per version."
              },
              "max_step_chars": {
                "type": "integer",
                "default": 600,
                "maximum": 4000,
                "minimum": 80,
                "description": "Characters kept per step. Raise it only if a step was cut mid-sentence."
              }
            }
          },
