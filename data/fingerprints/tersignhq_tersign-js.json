                "type": "string",
                "description": "0x-prefixed keccak256 digest of the receipt being refunded — the digest returned by issue_receipt, and it must already exist on your chain"
              },
              "amount": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "description": "why the refund was issued, in your own words; recorded verbatim for whoever reads the chain later"
