                "default": null,
                "description": "SearXNG only. Specific search engines to use. Default: None (all available)"
              },
              "language": {
                "type": "string",
                "default": "en",
                "description": "Language code for results (e.g., 'en', 'de', 'fr'). Default: 'en'"
              },
              "providers": {
