            "targets": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string",
                "description": "Base asset key or Yahoo Finance symbol (default: btc → BTC-USD)"
              },
              "action": {
                "enum": [
                  "correlation",
                  "assets_list",
                  "heatmap"
                ],
                "type": "string",
                "description": "correlation=compute correlation between base and targets, assets_list=list available asset keys and Yahoo symbols, heatmap=full correlation matrix for a set of assets"
              },
              "assets": {
                "type": "string",
                "description": "Comma-separated assets for heatmap (default: btc,gold,dxy,ndx,spx,t10y,oil)"
              },
              "period": {
                "enum": [
                  "30d",
                  "90d",
                  "180d",
                  "1y",
                  "2y",
                  "5y"
                ],
                "type": "string",
                "description": "Lookback period (default: 1y)"
              },
              "window": {
                "type": "integer",
                "maximum": 252,
                "minimum": 5,
                "description": "Rolling window in trading days (default: 30, range: 5-252)"
              },
              "targets": {
                "type": "string",
                "description": "Comma-separated target asset keys or Yahoo symbols. Default: gold,dxy,ndx,spx,t10y,vix. Use assets_list action to see available keys."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:211d05f68f51183e94b327961baedc5df3e34201821cd7a8dab18ee5973f5ffd"
