        {
          "name": "backtest",
          "canonical_hash": "sha256:d04c169ffadc155d69a9a0a12f3ad102c5de114ff03321bd60c7463fcc38defd",
          "description": "Run historical backtests on trading strategies using VectorBT. Fetches OHLCV from exchange (ccxt), computes indicators (RSI/MACD/BB/EMA/ATR), evaluates entry/exit signals, simulates portfolio, returns structured metrics (return%, Sharpe, max drawdown, win rate, profit factor). Optionally generates equity curve chart. Supports pre-fetched OHLCV via ohlcv_json for coingecko/yfinance data.",
          "is_mutating": false,
          "property_keys": [
            "action",
            "exchange",
            "generate_chart",
            "metrics_json",
            "ohlcv_json",
            "period",
            "starting_balance",
            "strategy_config"
          ],
          "required_keys": [],
          "parameter_types": {
            "action": "string",
            "period": "string",
            "exchange": "string",
            "ohlcv_json": "string",
            "metrics_json": "string",
            "generate_chart": "boolean",
            "strategy_config": "string",
            "starting_balance": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "run",
                  "chart"
                ],
                "type": "string",
                "description": "run=execute backtest, chart=regenerate chart from previous metrics"
              },
              "period": {
                "type": "string",
                "description": "Lookback period, e.g. '6m', '1y', '30d'. Default: 6m"
              },
              "exchange": {
                "enum": [
                  "binance",
                  "bitget",
                  "okx",
                  "bybit",
                  "coinbase",
                  "kraken",
                  "kucoin"
                ],
                "type": "string",
                "description": "Exchange for OHLCV data. Default: binance"
              },
              "ohlcv_json": {
                "type": "string",
                "description": "Pre-fetched OHLCV as JSON string (from coingecko/yfinance tools). Format: {\"SYMBOL\": [{\"timestamp\":ms,\"open\":...,\"close\":...}, ...]}"
              },
              "metrics_json": {
                "type": "string",
                "description": "For action=chart: JSON metrics from a previous run."
              },
              "generate_chart": {
                "type": "boolean",
                "description": "Generate equity curve chart (requires playwright). Default: false"
              },
              "strategy_config": {
                "type": "string",
                "description": "JSON string with strategy config. Keys: name, symbols (list), timeframe, indicators (list of {name, params, key}), entry_conditions (list of {indicator, field, operator, value}), exit_conditions, direction (long/short/both), stop_loss_pct, take_profit_pct, trade_size_pct, fees."
              },
              "starting_balance": {
                "type": "number",
                "description": "Initial cash. Default: 100000"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:f9ebb692fc5d0fd79f4d9cf3e5225c9e493f9848c9342a178dbc09c0401cba4f"
        },
