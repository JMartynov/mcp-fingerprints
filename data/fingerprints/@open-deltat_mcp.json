          "name": "find_slots",
          "canonical_hash": "sha256:3dfbb52ff69a93aafed5ec884f170903be827f4a9d8c0307cb7ce7bd515154a3",
          "description": "Use this first, before offering anyone a time. Lists the genuinely free slots between two RFC 3339 instants (offset required, e.g. 2026-06-01T09:00:00Z). With several calendars it lists only the times when every one of them is free. A slot listed here is not reserved for you: another caller can take it a moment later, so call hold_slot before you promise it to anyone. Availability is materialized about 60 days ahead, so searching further out returns nothing rather than an error.",
          "is_mutating": false,
          "property_keys": [
            "calendar_ids",
            "from",
            "min_minutes",
            "timezone",
            "to"
