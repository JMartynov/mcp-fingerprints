            "label": "string",
            "timezone": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "hold_ids": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "who the booking is for"
              },
              "timezone": {
                "type": "string",
                "description": "IANA timezone for rendering any alternative times",
                "default": "UTC"
              }
            },
            "required": [
              "hold_ids"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:e9c41dc02e10f85d1aace00a0989c4d87ba8d71b583dcc8f69c3867121579c5c",
