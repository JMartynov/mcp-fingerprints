        {
          "name": "sinogate_submit_video",
          "canonical_hash": "sha256:deed69ed6c7d345e0122d64ecd1bee88c28ffcf398d3da31c650c9de193e5b3a",
          "description": "Start an asynchronous text-to-video or image-to-video job and return immediately with id and status. Does NOT wait for completion and does NOT auto-retry. Poll with sinogate_get_video_status, or pass callback_url for a terminal webhook.",
          "is_mutating": false,
          "property_keys": [
            "callback_url",
            "duration",
            "extra",
            "idempotency_key",
            "image_url",
            "model",
            "prompt",
            "ratio",
            "resolution"
          ],
          "required_keys": [
            "model",
            "prompt"
          ],
          "parameter_types": {
            "model": "string",
            "prompt": "string",
            "duration": "number",
            "resolution": "string",
            "ratio": "string",
            "callback_url": "string",
            "image_url": "string",
            "extra": "string",
            "idempotency_key": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Video model ID (modalities includes video), for example wan2.6-t2v."
              },
              "prompt": {
                "type": "string",
                "description": "Video description (Chinese or English)."
              },
              "duration": {
                "type": "number",
                "description": "Length in seconds (2–15, default 5)."
              },
              "resolution": {
                "type": "string",
                "description": "720P or 1080P (default 1080P).",
                "enum": [
                  "720P",
                  "1080P"
                ]
              },
              "ratio": {
                "type": "string",
                "description": "Aspect ratio (default 16:9).",
                "enum": [
                  "16:9",
                  "9:16",
                  "1:1",
                  "4:3",
                  "3:4"
                ]
              },
              "callback_url": {
                "type": "string",
                "description": "Optional public HTTPS webhook URL for terminal status. localhost/private networks are rejected by the API."
              },
              "image_url": {
                "type": "string",
                "description": "Optional i2v first-frame / reference image (public HTTPS). Required for models whose id contains -i2v."
              },
              "extra": {
                "type": "string",
                "description": "Optional provider passthrough (bailian allowlist). Unknown keys are rejected by the API."
              },
              "idempotency_key": {
                "type": "string",
                "description": "Optional Idempotency-Key header to prevent duplicate charges on replay. Reusing a key with different params returns 422."
              }
            },
            "required": [
              "model",
              "prompt"
            ]
