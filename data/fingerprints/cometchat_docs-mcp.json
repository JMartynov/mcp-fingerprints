        {
          "name": "search_cometchat_docs",
          "canonical_hash": "sha256:da0914dd0b052da16382a3fbe349028cd301587b47f23b5dbe0352ff50a4362c",
          "description": "Searches CometChat documentation including SDK guides (JavaScript, React, iOS, Android, Flutter, React Native), UI Kit references, REST API documentation, integration tutorials, and OpenAPI specs. Returns ranked snippets with titles and direct links to source pages. Pages for the current version of each SDK and UI Kit are preferred over older versions, and each result reports its version label and whether it is current. To reach older docs, pass the `version` filter with that version's label.",
          "is_mutating": false,
          "property_keys": [
            "limit",
            "query",
            "version"
          ],
          "required_keys": [],
          "parameter_types": {
            "limit": "number",
            "query": "string",
            "version": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "number",
                "maximum": 25,
                "minimum": 1,
                "description": "Maximum number of results to return. Default 10, maximum 25."
              },
              "query": {
                "type": "string",
                "description": "Search query. 1–500 characters."
              },
              "version": {
                "type": "string",
                "description": "Optional version label from the docs version picker, e.g. 'v7' or 'v5'. Each SDK and UI Kit numbers its versions independently, so a label matches every product that uses it. Omit to search all versions, with current versions preferred."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "url",
                    "snippet",
                    "section",
                    "isCurrent"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "Direct link to the source page."
                    },
                    "title": {
                      "type": "string",
                      "description": "Page title."
                    },
                    "section": {
                      "type": "string",
                      "description": "Documentation section the page belongs to."
                    },
                    "snippet": {
                      "type": "string",
                      "description": "Matched excerpt with context."
                    },
                    "version": {
                      "type": "string",
                      "description": "Version label of the page's SDK or UI Kit, e.g. 'v7'. Omitted for pages that are not versioned."
                    },
                    "isCurrent": {
                      "type": "boolean",
                      "description": "False when the page documents an older version of its SDK or UI Kit."
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Ranked search results."
              },
              "totalAvailable": {
                "type": "number",
                "description": "Total matching pages available (may exceed the returned count)."
              }
            },
            "required": [
              "results",
              "totalAvailable"
            ]
          },
          "description_hash": "sha256:029cbe4451f41fb47e66d09b60f137ca00ab500ffcea10d139644272989dbfb1",
          "parameters": [
            {
              "name": "limit",
