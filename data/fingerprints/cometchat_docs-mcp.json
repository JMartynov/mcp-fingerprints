        {
          "name": "fetch_cometchat_doc_page",
          "canonical_hash": "sha256:ab6646d044e2e0af57ac33a02dc7003a009a98eb08f44e8efc676fb9781f9654",
          "description": "Fetches the full content of a single CometChat documentation page by URL or path. Returns the page content as markdown along with title and section metadata. Path can be passed as a full https://www.cometchat.com/docs URL or as a relative path such as '/sdk/javascript/overview'.",
          "is_mutating": false,
          "property_keys": [
            "path"
          ],
          "required_keys": [],
          "parameter_types": {
            "path": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Documentation path or full URL. Relative paths like '/sdk/javascript/overview' and full URLs both work."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "Canonical page URL."
              },
              "title": {
                "type": "string",
                "description": "Page title."
              },
              "content": {
                "type": "string",
                "description": "Full page content as markdown (truncated if very large)."
              },
              "section": {
                "type": "string",
                "description": "Documentation section the page belongs to."
              },
              "contentLength": {
                "type": "number",
                "description": "Content length in bytes after truncation."
              },
              "redirectedFrom": {
                "type": "string",
                "description": "Path originally requested, present only when that page has moved. url and section describe the page it moved to."
              }
            },
            "required": [
              "title",
              "url",
              "section",
              "content",
              "contentLength"
            ]
          },
          "description_hash": "sha256:2dd39557cf46744f220d866ae998680bb27ce6e32b9237836a18402e03f74db0",
          "parameters": [
            {
              "name": "path",
              "type": "string",
              "description": "Documentation path or full URL. Relative paths like '/sdk/javascript/overview' and full URLs both work.",
              "required": false,
              "default": null,
              "enum": null,
              "format": null,
              "items_type": null,
              "nested_properties": null
            }
          ],
          "annotations": {}
        },
        {
          "name": "get_cometchat_implementation_bundle",
          "canonical_hash": "sha256:0ee67a4fa6ba7c931508d13eae8a7d9e0611b6af4503b9bec8db218ab46fa1de",
          "description": "Returns a curated implementation bundle for a named CometChat integration scenario. Each bundle includes prerequisites, install commands, configuration, working code examples, and common pitfalls. Available bundles cover common integration patterns across React, Flutter, iOS, Android, React Native, and the JavaScript SDK.",
          "is_mutating": false,
          "property_keys": [
            "bundle"
          ],
          "required_keys": [],
          "parameter_types": {
            "bundle": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "bundle": {
                "type": "string",
                "description": "Bundle name in lowercase kebab-case, e.g. 'react-uikit-quickstart'."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Human-readable bundle title."
              },
              "bundle": {
                "type": "string",
                "description": "Bundle identifier."
              },
              "content": {
                "type": "string",
                "description": "The full implementation recipe as markdown."
              },
              "framework": {
                "type": "string",
                "description": "Target framework/platform."
              },
              "last_verified": {
                "type": "string",
                "description": "Date the bundle was last verified against live SDK versions."
              },
              "prerequisites": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Prerequisites before applying the bundle."
              }
            },
            "required": [
              "bundle",
              "title",
              "framework",
              "prerequisites",
              "last_verified",
              "content"
            ]
          },
          "description_hash": "sha256:0a6caef3312423bcf687eb60fd7f4b3430e47e97285515e058735195547a9e5c",
          "parameters": [
            {
              "name": "bundle",
