        {
          "name": "For a targeted mutation, first use email_read with action",
          "canonical_hash": "sha256:a47306c76099466ca2a18e8f93aef4c76eca3d1b242a3e3ac6bc9511cbdf6923",
          "description": "\"search\", then pass the returned message_id or message_ids to email_organize or email_delete. Search fields are accepted only by email_search_and_move and email_delete's search_and_delete action.",
