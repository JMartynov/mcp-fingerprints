          "name": "search_discourse_communities",
          "canonical_hash": "sha256:75d6298549dee35affdf31534c7344952512f7bed6bc8435bd0444334485af21",
          "description": "Discover Discourse forum communities by topic or find similar communities. Use 'query' for semantic text search (e.g., 'note taking productivity') or 'similar_to' to find communities similar to a known one by URL or ID. Provide exactly one of 'query' or 'similar_to'. Returns communities with confidence scores and engagement metrics.",
          "is_mutating": false,
          "property_keys": [
            "engagement_tier",
            "limit",
            "locale",
            "min_users",
            "query",
            "similar_to"
          ],
          "required_keys": [],
          "parameter_types": {
            "limit": "integer",
            "query": "string",
            "locale": "string",
            "min_users": "integer",
            "similar_to": "string",
            "engagement_tier": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "maximum": 50,
                "minimum": 1,
                "description": "Maximum number of results to return (default: 10, max: 50)"
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "Semantic text search query (e.g., 'note taking productivity')"
              },
              "locale": {
                "type": "string",
                "description": "Filter by locale code (e.g., 'en', 'de', 'fr')"
              },
              "min_users": {
                "type": "integer",
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "description": "Filter by minimum total user count"
              },
              "similar_to": {
                "type": "string",
                "description": "Find communities similar to this one. Accepts a community URL (e.g., 'https://forum.obsidian.md') or ID (e.g., 'discover_1376')"
              },
              "engagement_tier": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "type": "string",
                "description": "Filter by engagement level: high (>5% MAU), medium (>1% MAU), low (<1% MAU)"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:5e4a29e601fe3427317d237b8e362b649523ba4088a73d22db5dbc35cf9d2713"
