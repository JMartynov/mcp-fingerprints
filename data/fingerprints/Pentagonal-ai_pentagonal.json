          "name": "pentagonal_lookup",
          "canonical_hash": "sha256:6bb108674b205b30fe57ed7859eb48020aa9d8c6105da455413cb6085bf02834",
          "description": "Look up any token or smart contract by address. Returns the full intelligence report: price, market cap, ATH, 24h volume, transactions, holders, liquidity, LP lock status, pool count, security flags (honeypot, mintable, pausable, hidden owner, taxes), social links, and source code if verified. Use this before auditing to understand the full token landscape. Supports EVM and Solana tokens. Chain is auto-detected if omitted.",
          "is_mutating": false,
          "property_keys": [
            "address",
            "chain",
            "fields"
          ],
          "required_keys": [
            "address"
          ],
          "parameter_types": {
            "address": "string",
            "chain": "string",
            "fields": "array"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "description": "Contract address. EVM: 0x... checksum or lowercase. Solana: base58 program address."
              },
              "chain": {
                "type": "string",
                "description": "Target blockchain. If omitted, auto-detects the chain from the contract address.",
                "enum": [
                  "ethereum",
                  "polygon",
                  "arbitrum",
                  "base",
                  "optimism",
                  "bsc",
                  "avalanche",
                  "solana"
                ]
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": "['all']",
                "enum": [
                  "price",
                  "market",
                  "liquidity",
                  "holders",
                  "security",
                  "socials",
                  "code",
                  "all"
                ]
              }
            },
