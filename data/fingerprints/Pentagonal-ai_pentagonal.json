          "name": "pentagonal_audit",
          "canonical_hash": "sha256:bbad60520e24907233957e3c8dd233958b234a63c9aea56a36fe9c9cd3ff43c1",
          "description": "Run an 8-agent security pen test on a smart contract. Each agent specializes in a different attack vector: reentrancy, flash loans, access control, gas griefing, oracle manipulation, front-running, integer overflow, and economic exploits. Findings are returned with severity ratings and line numbers. New security rules are automatically learned from each audit.",
          "is_mutating": false,
          "property_keys": [
            "chain",
            "code",
            "use_learned_rules"
          ],
          "required_keys": [
            "code"
          ],
          "parameter_types": {
            "code": "string",
            "chain": "string",
            "use_learned_rules": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The full smart contract source code to audit"
              },
              "chain": {
                "type": "string",
                "description": "Which blockchain the contract targets",
                "default": "ethereum",
                "enum": [
                  "ethereum",
                  "polygon",
                  "arbitrum",
                  "base",
                  "optimism",
                  "bsc",
                  "avalanche",
                  "solana"
                ]
              },
              "use_learned_rules": {
                "type": "boolean",
