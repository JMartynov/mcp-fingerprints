        {
          "name": "subscribe_once",
          "canonical_hash": "sha256:c9bf57a8cd6e37b2e66dc04ed9cd137e917808aef46099d6f6b4f8882cb5527d",
          "description": "Subscribe to a ROS topic and return the first message received.\nExample:\nsubscribe_once(topic='/cmd_vel', msg_type='geometry_msgs/msg/TwistStamped')\nsubscribe_once(topic='/slow_topic', msg_type='my_package/SlowMsg', timeout=10.0)  # Use longer timeout for slow topics\nsubscribe_once(topic='/high_rate_topic', msg_type='sensor_msgs/Image', timeout=5.0, queue_length=5, throttle_rate_ms=100)  # Control message buffering and rate\nsubscribe_once(topic='/camera/image_raw', msg_type='sensor_msgs/Image', expects_image='true')  # Hint that this is an image for faster processing\nsubscribe_once(topic='/point_cloud', msg_type='sensor_msgs/PointCloud2', expects_image='false')  # Skip image detection for non-image data",
          "is_mutating": false,
          "property_keys": [
