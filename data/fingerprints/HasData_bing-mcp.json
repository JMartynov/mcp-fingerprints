                  "tr",
                  "gb",
                  "us"
                ],
                "type": "string",
                "description": "The two-letter country code for the country to search from."
              },
              "lat": {
                "type": "string",
                "description": "GPS latitude for the search origin."
              },
              "lon": {
                "type": "string",
                "description": "GPS longitude for the search origin."
              },
              "mkt": {
                "enum": [
                  "es-ar",
                  "en-au",
                  "de-at",
