        {
          "name": "check_exposed_files",
          "canonical_hash": "sha256:93b4a768d7854e8c43c35e2fc636f064f557f99f1e26a484c97cfbcf1a5c6466",
          "description": "Answers: is this domain publicly serving files it should not be? Requests a small, fixed list of well-known sensitive paths — things like .env, .git/config, backup archives and exposed configuration — and reports which return real content rather than a 404. Returns a 0-100 score plus a finding per exposed path. How it works, stated plainly: it makes ordinary GET requests for a small FIXED list of well-known paths. It does not brute-force, fuzz, or enumerate — the list never grows and never adapts to what it finds. Note that these are paths an ordinary crawler would not request (.env, .git/config), so the requests are recognisable in a target",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:302727b6c739178909337af57fd5427fbd5d0b5a20c0b89946d530dd5ca892de",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "check_security_headers",
          "canonical_hash": "sha256:3546b0f33e8ced95f4b44f0ea6fbbc239992d88a13916f85699117a3a6cd9788",
          "description": "Answers: does this site send the HTTP response headers that protect visitors in the browser? Checks for Content-Security-Policy, Strict-Transport-Security, X-Content-Type-Options, X-Frame-Options / frame-ancestors, Referrer-Policy and Permissions-Policy — whether each is present and whether its value is actually protective rather than nominal. Returns a 0-100 score plus a finding per header explaining what a missing or weak value exposes.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:d7ad56c14e4525a5cecf436b7468182f96dec5e6b8e1ed70ef85de7641f9a254",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "check_subdomain_takeover",
          "canonical_hash": "sha256:f45e912db8d5469f25b52c240baefa65981c925a3c69f139fcc3ccc75bbad30b",
          "description": "Answers: does this domain have DNS records pointing at services someone else could claim? Inspects published DNS records for dangling CNAMEs — entries still pointing at a de-provisioned cloud or SaaS host (an unclaimed bucket, an expired app instance) that an attacker could register and then serve content from a hostname users already trust. Returns a 0-100 score plus a finding per at-risk record, naming the record and the service it points to. How it works, stated plainly: it resolves a small fixed list of common subdomain names (www, mail, dev, staging and similar) and, for any that resolve to a known cloud or SaaS host, makes one ordinary HTTPS GET to check for that provider",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:08d3f485868955fbc9571a2a782afed6a2a81d4ad405b6a719f4d2a7246356e3",
          "parameters": [],
          "annotations": {}
        },
