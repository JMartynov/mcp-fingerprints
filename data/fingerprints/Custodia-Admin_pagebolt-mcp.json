        {
          "name": "async — render via an async job and poll to completion. Long recordings are enqueued (202 { job_id }) and this tool waits for the result, so they don't hit MCP client / API request timeouts. The async result is a private hosted video URL (its bytes can't be pulled back via the API key). Set false to force a single blocking synchronous request that returns the video inline (base64 embedded + saved to saveTo). Default",
          "canonical_hash": "sha256:c6324d9173dc9b10f15632f836009864609d5141f40c77694bb1c24df89fe36c",
          "description": "true, except when you pass saveTo (then the synchronous path is used so the file is actually produced on disk). Falls back to sync automatically if async is unavailable. Quota is charged only on success; max 5 pending jobs per account.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:45dc4733f0f41c314db924a1d9d908fed32ffddd61ef3bd2378dbab052fd064e"
        },
