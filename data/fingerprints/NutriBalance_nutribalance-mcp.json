                "minimum": 0,
                "description": "Fibre eaten today (grams) — optional"
              },
              "water_ml": {
                "type": "number",
                "maximum": 10000,
                "minimum": 0,
                "description": "Water consumed today (ml) — optional"
              },
              "protein_g": {
                "type": "number",
                "maximum": 500,
                "minimum": 0,
                "description": "Protein eaten today (grams)"
              },
              "calorie_target": {
                "type": "number",
                "maximum": 6000,
                "minimum": 800,
                "description": "Daily calorie target"
              },
              "calories_eaten": {
                "type": "number",
                "maximum": 10000,
                "minimum": 0,
                "description": "Total calories eaten today"
              },
              "protein_target_g": {
                "type": "number",
                "maximum": 400,
                "minimum": 0,
                "description": "Daily protein target (grams)"
              },
              "vegetable_servings": {
                "type": "integer",
                "maximum": 20,
                "minimum": 0,
                "description": "Number of vegetable/fruit servings today — optional (1 serving = ~80g)"
              }
            }
          },
          "outputSchema": null,
