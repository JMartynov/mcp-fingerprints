        {
          "name": "kibela_create_note",
          "canonical_hash": "sha256:9860f19c17ce5bf7a63ea6b98648bcb0e91897de9060a89b3e6a84c9b32c5e36",
          "description": "Create a new note in Kibela.",
          "is_mutating": false,
          "property_keys": [
            "authorId",
            "coediting",
            "content",
            "draft",
            "folders",
            "groupIds",
            "title"
          ],
          "required_keys": [],
          "parameter_types": {
            "draft": "boolean",
            "title": "string",
            "content": "string",
            "folders": "array",
            "authorId": "string",
            "groupIds": "array",
            "coediting": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "draft": {
                "type": "boolean",
                "description": "Whether to create the note as a draft"
              },
              "title": {
                "type": "string",
                "description": "required: Title of the note"
              },
              "content": {
                "type": "string",
                "description": "required: Content of the note in markdown format"
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of the folders to add the note to."
              },
              "authorId": {
                "type": "string",
                "description": "ID of the author of the note. If not specified, the note will be created by the authenticated user."
              },
              "groupIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "required: IDs of the groups to create the note in."
              },
              "coediting": {
                "type": "boolean",
                "description": "required: Whether to enable co-editing for the note"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:25101456879f757c94ec1ae12e6265dee6ddcb4d0976253ab99c8915d5b89dd1"
        },
        {
