        {
          "name": "convert",
          "canonical_hash": "sha256:97913d6022c9952c4ffa5b1a237ac31ebc0423b5d89d6cefded4f0bcc0068b64",
          "description": "Convert an amount from one currency to another using NBP mid-rate (Table A, or B if not in A). Primary use case: converting a foreign-currency invoice to PLN for Polish bookkeeping. Polish tax law requires using the NBP mid-rate from the last business day BEFORE the invoice date — pass the invoice date as `before_date` and the server uses the last table NBP published strictly before it. `rate_date` instead uses the table published on exactly that date (no data on weekends/holidays). Returns the amount, the rate used, and the effective date.",
          "is_mutating": false,
          "property_keys": [
            "amount",
            "before_date",
            "from_currency",
            "rate_date",
            "to_currency"
          ],
          "required_keys": [
            "amount",
            "from_currency"
