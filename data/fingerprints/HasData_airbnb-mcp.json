          "name": "hasdata_airbnb_listing_getAirbnbListings",
          "canonical_hash": "sha256:6907b61e818030493d6fa7fc815807188ee097d116011f131412bfffbec13cb0",
          "description": "Get Airbnb Listings\n\nSearches Airbnb for available stays by location and date range (check-in/check-out) with guest composition (adults, children, infants, pets) and nextPageToken pagination. Returns listing id/url, title, price per night and total, rating, review count, coordinates, photos, host info, room/bed/bath counts, and amenities summary. Use for travel planning agents, short-term rental market analysis, pricing/occupancy research, and lead lists for property management.",
          "is_mutating": false,
          "property_keys": [
            "adults",
            "checkIn",
            "checkOut",
            "children",
            "infants",
            "location",
            "nextPageToken",
            "pets"
          ],
          "required_keys": [],
          "parameter_types": {
            "pets": "number",
            "adults": "number",
            "checkIn": "string",
            "infants": "number",
            "checkOut": "string",
            "children": "number",
            "location": "string",
            "nextPageToken": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "pets": {
                "type": "number",
                "description": "Number of pets.\n"
              },
              "adults": {
                "type": "number",
                "description": "Number of adults.\n"
              },
              "checkIn": {
                "type": "string",
                "description": "The check-in date for the listings."
              },
              "infants": {
                "type": "number",
                "description": "Number of infants.\n"
              },
              "checkOut": {
                "type": "string",
                "description": "The check-out date for the listings."
              },
              "children": {
                "type": "number",
                "description": "Number of children.\n"
              },
              "location": {
                "type": "string",
                "description": "The location to search for listings."
              },
              "nextPageToken": {
                "type": "string",
                "description": "The token used to retrieve the next page of results."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:a6ce1dae9687867adfbd4c6c45f43b819b35a0624be53f2e857cc138017623bd"
