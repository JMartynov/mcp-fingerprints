          "name": "run_pipeline",
          "canonical_hash": "sha256:dd3a67a0a28d3cf3f46b38742484c766ecca7ee3056fe0011d927da20890e742",
          "description": "Run a whole pipeline — an ordered list of steps, in the string-utility-belt v2 schema, which may include branches (parallel forks merged back together) and macros (named sub-pipelines) — on `input`. Returns {output, outputEncoding?, errors, timings, skipped, halted}: `errors` maps step id to its error message, `timings` maps step id to milliseconds. Provide exactly one of `steps` or `share` (a `#/p/<payload>` share link, a full URL containing one, or the bare payload). Untrusted step data is sanitized first, so malformed entries are dropped rather than rejected. Refused outright: pipelines with more than 100 steps (branches/macros counted), unknown utility ids, enabled steps with invalid params, and any step that would run arbitrary user JavaScript (e.g. \"custom_js\") — LLM-driven code execution is out of scope. Input is capped at 1,000,000 bytes, output text past 1,000,000 characters is cut off (flagged `truncated`, with `fullLength`), and the call is stopped after 20s.",
          "is_mutating": false,
          "property_keys": [
            "input",
            "inputEncoding",
            "share",
            "steps"
          ],
          "required_keys": [],
          "parameter_types": {
            "input": "string",
            "share": "string",
            "steps": "array",
            "inputEncoding": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "input": {
                "type": "string",
                "description": "The pipeline's source input."
              },
              "share": {
                "type": "string",
                "description": "A share link (or its bare payload) for a previously built pipeline; used instead of `steps`."
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "description": "Pipeline steps (v2 schema). Each entry is either a utility step {id, utilityId, params?, enabled?, condition?, onError?}, a fork {type:\"branch\", id, branches:[[...steps], [...steps]], merge:{mode:\"concat\"|\"zip\"|\"json\"|\"pick\", ...}}, or a sub-pipeline {type:\"macro\", id, name, steps:[...steps]}. `condition` gates a step on its input ({kind:\"always\"|\"nonEmpty\"|\"regex\"|\"type\", ...}); `onError` is \"passthrough\" (default: record the error, pass the input on), \"stop\" or \"empty\". Use [] for the identity pipeline; omit when using `share`."
              },
              "inputEncoding": {
                "enum": [
                  "text",
                  "base64",
                  "hex",
                  "json"
                ],
                "type": "string",
                "description": "How to decode `input`. Default \"text\"."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "object",
                "description": "Step id -> error message, for steps that failed.",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "halted": {
                "type": "boolean",
                "description": "True when a step with onError \"stop\" failed and ended the pipeline."
              },
              "output": {
                "type": "string",
                "description": "The result: text as-is, JSON pretty-printed, bytes as base64."
              },
              "skipped": {
                "type": "object",
                "description": "Step id -> why it did not run (disabled, condition, halted, aborted).",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timings": {
                "type": "object",
                "description": "Step id -> milliseconds it took.",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "truncated": {
                "type": "boolean",
                "description": "True when `output` was cut off at the output limit."
              },
              "fullLength": {
                "type": "number",
                "description": "Length `output` would have had untruncated, when `truncated`."
              },
              "outputEncoding": {
                "type": "string",
                "const": "base64",
                "description": "Present when `output` is base64-encoded bytes."
              }
            },
            "required": [
              "output",
              "errors",
              "timings",
              "skipped",
              "halted"
            ]
          },
          "description_hash": "sha256:7a366ada63f736479efb5664151298f1b76aeec52a93bc9af4c013679767c779",
