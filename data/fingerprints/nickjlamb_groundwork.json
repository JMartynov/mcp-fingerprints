        {
          "name": "check_extraction",
          "canonical_hash": "sha256:83cafc6c1a873fa19c082b8c7205e77c2c025573e15e2dd9e0d811d8a92bf7af",
          "description": "Deterministically check a structured extraction against its hand-labelled gold record: schema validity (nullable fields are the abstention contract), field accuracy with per-field normalisers (dates → ISO, money → minor units) and aliases, and fabrication — a non-null value in a field whose gold is null (a guessed date of birth the document never stated). Same logic as the CI gate — no model, no network. Returns pass/fail with named issues and a per-field verdict.",
          "is_mutating": false,
          "property_keys": [
            "aliases",
            "gold",
            "normalize",
            "record",
            "schema"
          ],
          "required_keys": [
            "gold",
            "record"
          ],
          "parameter_types": {
            "record": "string",
            "gold": "string",
            "schema": "string",
            "normalize": "string",
            "aliases": "array"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "record": {
                "type": "string",
                "description": "The record the system extracted ({ field: value | null })"
              },
              "gold": {
                "type": "string"
              },
              "schema": {
                "type": "string",
                "description": "The JSON Schema the record must validate against (type a must-find field non-nullable, a may-be-absent field nullable)"
              },
              "normalize": {
                "type": "string",
                "description": "Per-field normaliser applied to both sides before comparing",
                "enum": [
                  "date",
                  "money",
                  "number",
                  "text"
                ]
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Per-field acceptable alternative gold values (matched after normalisation)"
              }
            },
            "required": [
              "gold",
              "record"
            ]
          },
