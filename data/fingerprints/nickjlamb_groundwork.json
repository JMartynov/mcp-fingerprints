            "answerable": "boolean",
            "abstain_markers": "array"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "description": "The question that was asked"
              },
              "context": {
                "type": "string",
                "description": "The retrieved passage(s) the answer must be grounded in"
              },
              "answer": {
                "type": "string",
                "description": "The answer to check"
              },
              "answer_anchors": {
                "type": "object",
