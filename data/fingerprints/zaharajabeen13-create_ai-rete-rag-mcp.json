        {
          "name": "decide",
          "canonical_hash": "sha256:266240cf91cf44bbd41bc4046fdc602ab5b7a15582d81691e508b8835c118b4f",
          "description": "Make a deterministic, auditable decision in a domain.",
          "is_mutating": false,
          "property_keys": [
            "as_of",
            "domain",
            "extract_from_retrieval",
            "fact_sources",
            "facts",
            "filter_retrieval_with_rules",
            "query",
            "response_mode",
            "unstructured_text"
          ],
          "required_keys": [
            "domain",
            "query"
          ],
          "parameter_types": {
            "domain": "string",
            "query": "string",
            "facts": "string",
            "unstructured_text": "string",
            "response_mode": "string",
            "filter_retrieval_with_rules": "boolean",
            "extract_from_retrieval": "boolean",
            "fact_sources": "string",
            "as_of": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "description": "Rule-set domain, e.g. \"loan\", \"fraud\", \"clinical\"."
              },
              "query": {
                "type": "string",
                "description": "Natural-language question or decision request."
              },
              "facts": {
                "type": "string",
                "description": "Structured facts for working memory, e.g. {\"credit_score\": 710, \"annual_income\": 85000}. Use `get_parameters` to see which fields a domain's rules test. Facts you read yourself from photos, document scans, voice notes or video go here, under those field names; explicit facts always win over anything extracted server-side.",
                "default": null
              },
              "unstructured_text": {
                "type": "string",
                "description": "Optional free text (an application, a case note, a voice-note transcript, what a photo or video shows); facts are extracted from it automatically and merged.",
                "default": null
              },
              "response_mode": {
                "type": "string",
                "description": "\"verdict_only\" (fastest), \"verdict_with_explanation\", or \"full_audit\" (every rule evaluation + retrieved chunks, available on every plan including the free tier). rule_firings come back in causal order: a rule that matched a fact asserted by an earlier firing appears after it, with the derived facts listed under `asserted_facts`.",
                "default": "verdict_with_explanation",
                "enum": [
                  "verdict_only",
                  "verdict_with_explanation",
                  "full_audit"
                ]
              },
              "filter_retrieval_with_rules": {
                "type": "boolean",
                "description": "Pattern 01 — run the rules first and let a fired rule's `retrieval_scope` action narrow which documents the retrieval searches before it runs.",
                "default": false
              },
              "extract_from_retrieval": {
                "type": "boolean",
                "description": "Pattern 02 — parse the retrieved documents into facts and assert them into working memory, so rules fire on what was actually read (not just the facts you passed).",
                "default": false
              },
              "fact_sources": {
                "type": "string",
                "description": "Where each fact in `facts` came from, e.g. {\"monthly_income\": \"payslip.jpg\", \"claim_usd\": \"voice note 1\"}. Always set this for facts you read from a file, photo, recording or video: it is stored in the decision's audit record so a reviewer can tell typed facts from ones read off evidence. Facts without a source are recorded as \"request\".",
                "default": null
              },
              "as_of": {
                "type": "string",
                "description": "Read the domain's policy documents as of this day, as YYYY-MM-DD (default: today). Use the date a case was filed to decide it under the policy in force then; the rules themselves are always the current ones.",
                "default": null
              }
            },
            "required": [
              "domain",
              "query"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:e04f5f2f7104f158cb413218984681ad099274b6bcd054b8811e98e5c963bcaf",
