            "content",
            "memory_type",
            "title"
          ],
          "parameter_types": {
            "memory_type": "string",
            "title": "string",
            "content": "string",
            "confidence": "number",
            "tags": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "memory_type": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "description": "Short title for the memory (1-100 characters)."
              },
              "content": {
                "type": "string",
                "description": "The memory content to store (1-10000 characters). Be concise and atomic."
              },
              "confidence": {
                "type": "number",
                "description": "Confidence score from 0.0 to 1.0. The agent must evaluate the certainty of the memory. Use 1.0 for verified explicit facts, 0.7-0.85 for observations/estimates, and lower for unverified information."
              },
              "tags": {
                "type": "string",
                "description": "Comma-separated tags for categorization (e.g. 'market,ai,trend'). Use lowercase.",
                "default": ""
              }
