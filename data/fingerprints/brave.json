        {
          "name": "brave_video_search",
          "canonical_hash": "sha256:39d650b245a5c6e3b0ca6a24d18d69160970357f015d76afb8e1b2a9019704d9",
          "description": "Searches for videos using Brave's Video Search API. Returns structured video results with metadata.",
          "is_mutating": false,
          "property_keys": [
            "count",
            "country",
            "freshness",
