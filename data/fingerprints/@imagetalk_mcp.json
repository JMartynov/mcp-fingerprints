          "name": "check_liveness",
          "canonical_hash": "sha256:50323cc6da7f2f4fe8d70e71011c0d0df141372dc5e203661a50523cd6d13e5d",
          "description": "Cheap heartbeat: returns ok if the ImageTalk backend HTTP server is up. Does not check any downstream dependency (vision model, databases). Use this as a quick reachability probe before other calls. If you need to know whether the backend can actually serve work, call check_readiness instead.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
