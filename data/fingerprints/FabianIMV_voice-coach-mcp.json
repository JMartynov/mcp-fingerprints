          "name": "analyze_pitch",
          "canonical_hash": "sha256:61e6db3ca14636ef23eb88f9829008bc0b9a7aac7648b8fe3f9d4cb12518efe6",
          "description": "Measures the pitch accuracy of sung audio (solo voice, one melodic line).",
          "is_mutating": false,
          "property_keys": [
            "audio",
            "key",
            "midi_track",
            "reference_midi"
          ],
          "required_keys": [
            "audio"
          ],
          "parameter_types": {
            "audio": "string",
            "reference_midi": "string",
            "key": "string",
            "midi_track": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "audio": {
                "type": "string",
                "description": "audio path (wav/flac/mp3/m4a) or a name returned by record_audio."
              },
              "reference_midi": {
                "type": "string",
                "description": "optional path to a .mid with the expected melody. Tolerates singing an octave up/down, starting at another moment and a somewhat different tempo.",
                "default": null
              },
              "key": {
                "type": "string",
                "description": "optional when there is no MIDI, e.g. \"A minor\", \"G major\", \"F#\" (Spanish names such as \"La menor\" also work): each note is compared with the nearest note of that scale. Without it, with the nearest equal-tempered note.",
                "default": null
              },
              "midi_track": {
                "type": "string",
                "description": "index of the MIDI track to use (default: the non-drum track with most notes).",
                "default": null
              }
            },
            "required": [
              "audio"
            ]
          },
