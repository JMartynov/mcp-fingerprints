        {
          "name": "search_newspapers",
          "canonical_hash": "sha256:8aa5cefa5dbdc53533c6e793d87c2b8b9257fcb7796f9f1aa94af58b0da4e45b",
          "description": "Find a phrase in the text of scanned newspaper pages.",
          "is_mutating": false,
          "property_keys": [
            "limit",
            "location",
            "max_excerpt_chars",
            "max_excerpts_per_match",
            "page",
            "publication",
            "query",
            "year_from",
            "year_to"
          ],
          "required_keys": [],
          "parameter_types": {
            "page": "integer",
            "limit": "integer",
            "query": "string",
            "year_to": "integer",
            "location": "string",
            "year_from": "integer",
            "publication": "string",
            "max_excerpt_chars": "integer",
            "max_excerpts_per_match": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "default": 1,
                "maximum": 100,
                "minimum": 1,
                "description": "Which page of matches, from 1."
              },
              "limit": {
                "type": "integer",
                "default": 10,
                "maximum": 25,
                "minimum": 1,
                "description": "Matches to return."
              },
              "query": {
                "type": "string",
                "maxLength": 300,
                "minLength": 1,
                "description": "Words or a quoted phrase, such as '\"cure for influenza\"'. The index reads the text off the pages themselves and holds single characters, so a query of one character is a query it answers."
              },
              "year_to": {
                "type": "integer",
                "maximum": 9999,
                "minimum": 1000,
                "description": "Latest year, inclusive."
              },
              "location": {
                "type": "string",
                "maxLength": 120,
                "description": "The state a paper was published in, written as the Library writes it: 'new york', 'district of columbia'. It is the value 'state' carries on the matches this tool returns."
              },
              "year_from": {
                "type": "integer",
                "maximum": 9999,
                "minimum": 1000,
                "description": "Earliest year, inclusive."
              },
              "publication": {
                "type": "string",
                "maxLength": 200,
                "description": "One newspaper, named with its town and the years it ran: 'new-york tribune (new york [n.y.]) 1866-1924'. Take the wording from 'publication' on a match here, or from a title in search_items with media_type 'newspapers'."
              },
              "max_excerpt_chars": {
                "type": "integer",
                "default": 300,
                "maximum": 1200,
                "minimum": 80,
                "description": "Budget for one passage. Read it together with 'max_excerpts_per_match': the size of the answer is the product of the two and the number of matches."
              },
              "max_excerpts_per_match": {
                "type": "integer",
                "default": 3,
                "maximum": 10,
                "minimum": 1,
                "description": "Passages to keep per match. A page holding the words several times yields several, and the later ones rarely say anything the first did not."
              }
            }
          },
          "outputSchema": null,
