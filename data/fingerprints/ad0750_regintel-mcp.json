          "name": "get_aasb_s2_obligations",
          "canonical_hash": "sha256:3c0378ebf8e04acd0984da7a39d7affd28ee36721f6b862564462769b48a63e5",
          "description": "List Australian AASB-S2 (Climate-related Financial Disclosures) disclosure obligations",
          "is_mutating": false,
          "property_keys": [
            "category_code",
            "group",
            "reporting_year"
          ],
          "required_keys": [],
          "parameter_types": {
            "group": "string",
            "category_code": "string",
            "reporting_year": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "description": "Filter by entity Group tier (1 = largest entities reporting from FY commencing 1 Jan 2025; 2 = mid-tier from 1 Jul 2026; 3 = smaller from 1 Jul 2027). The tool does NOT determine which Group an entity is in — the caller must classify based on the entity's facts (employee count, revenue, gross assets, NGER status).",
                "default": null
              },
              "category_code": {
                "type": "string",
                "description": "Filter to specific disclosure category, e.g. \"AASB-S2-MET-GHG-S3\" for Scope 3 emissions, \"AASB-S2-GOV\" for governance. Optional. See the 13 category codes in the API documentation.",
                "default": null
              },
              "reporting_year": {
                "type": "string",
                "description": "Reporting year of interest (e.g. 2026). When supplied, the response indicates whether each obligation is applicable that year given phase-in relief and what assurance level applies.",
                "default": null
              }
            },
            "required": []
          },
