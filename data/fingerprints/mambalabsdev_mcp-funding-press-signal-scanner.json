        {
          "name": "get_funding_press_signals",
          "canonical_hash": "sha256:b8a88f35a68ad95b0c35797f96c748ce88920aa943c7c6c7fe0d72671af11b4a",
          "description": "Scan Google News and PR wires for funding rounds, executive moves, product launches, and acquisitions at any company domain. Returns deduplicated, dated events in flat Clay-ready JSON. Use it to find a trigger for outbound (a fresh raise, a new executive) or to qualify an account before a call. Pass signal_types to report one kind of event, lookback_days to set the window, and domains to scan a list in one call. Requires APIFY_TOKEN; consumes Apify credits.",
          "is_mutating": false,
          "property_keys": [
            "company_name",
            "domain",
            "domains",
            "lookback_days",
            "max_charge_usd",
            "signal_types"
          ],
          "required_keys": [
            "domain"
          ],
          "parameter_types": {
            "max_charge_usd": "number",
            "domain": "string",
            "company_name": "string",
            "signal_types": "string",
            "domains": "string",
            "lookback_days": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "max_charge_usd": {
                "type": "number"
              },
              "domain": {
                "type": "string",
                "description": "Company domain to scan, without https or www, e.g. stripe.com."
              },
              "company_name": {
                "type": "string",
                "description": "Optional company name hint, used when the domain does not match the brand name, e.g. Deel for deel.com."
              },
              "signal_types": {
                "type": "string",
                "description": "Report only these event types. Narrowing narrows the search as well as the answer, so a funding only scan issues one news query instead of four. Omit for every type.",
                "enum": [
                  "funding_round",
                  "ipo",
                  "acquisition",
                  "exec_move",
                  "product_launch",
                  "partnership"
                ]
              },
              "domains": {
                "type": "string",
                "description": "Optional list of company domains to scan in one run, one row per company. When set and non-empty it overrides domain; still pass the first domain as domain, which the schema requires."
              },
              "lookback_days": {
                "type": "string",
                "description": "How far back to search, in days. Default 365. Shorten it for trigger based outbound, where a raise from eleven months ago is not a trigger."
              }
            },
            "required": [
              "domain"
            ]
          },
