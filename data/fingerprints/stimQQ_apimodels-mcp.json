            "tags",
            "target_lang",
            "title",
            "video_url",
            "wait_seconds"
          ],
          "required_keys": [
            "model",
            "wait_seconds"
          ],
          "parameter_types": {
            "model": "string",
            "prompt": "string",
            "lyrics": "string",
            "tags": "string",
            "title": "string",
            "instrumental": "boolean",
            "duration_seconds": "number",
            "inputs": "object",
            "audio_url": "string",
            "video_url": "string",
            "source_url": "string",
            "target_lang": "string",
            "source_lang": "string",
            "extra": "string",
            "wait_seconds": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "suno-v5, eleven-sfx-v3, kling-sound-effects, kling-video-to-audio, eleven-dialogue, eleven-dubbing or eleven-isolator. Call list_models for the full audio list."
              },
              "prompt": {
                "type": "string"
              },
              "lyrics": {
                "type": "string",
                "description": "suno-v5: your own lyrics (use write_lyrics to draft them). Leave out for lyrics written by the model."
              },
              "tags": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "description": "suno-v5: song title."
              },
              "instrumental": {
