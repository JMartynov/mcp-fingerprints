          "name": "generate_audio",
          "canonical_hash": "sha256:2b6316d80dccbebdae4de72bb86ba21a291f018da0c68a2a647f6231bdbf70f1",
          "description": "Music, sound effects and audio processing on /v1/audio/generations: suno-v5 (songs with vocals or instrumental, from a description or your own lyrics), eleven-sfx-v3 and kling-sound-effects (sound effects from text), kling-video-to-audio (soundtrack for a video), eleven-dialogue (multi-speaker dialogue), eleven-dubbing (translate the speech in an audio / video file), eleven-isolator (strip background noise and music, keep the voice). For plain text-to-speech use text_to_speech; to turn speech into text use transcribe_audio. Returns the audio URL(s), valid 30 days; long jobs (music, dubbing) hand back a task id for get_task.",
          "is_mutating": false,
          "property_keys": [
            "audio_url",
            "duration_seconds",
            "extra",
            "inputs",
            "instrumental",
            "lyrics",
            "model",
            "prompt",
            "source_lang",
