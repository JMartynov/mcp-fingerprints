                    "type": "string"
                  },
                  "voice_id": {
                    "type": "string"
                  }
                }
              },
              "audio_url": {
                "type": "string",
                "description": "eleven-isolator: the audio to clean. Public URL, LOCAL FILE PATH, localhost URL or data: URI (local files up to 10 MB are uploaded for you)."
              },
              "video_url": {
                "type": "string",
                "description": "kling-video-to-audio: the video to add sound to. Same accepted forms; local videos up to 100 MB."
              },
              "source_url": {
                "type": "string",
                "description": "eleven-dubbing: the audio or video whose speech to translate. Same accepted forms."
              },
              "target_lang": {
                "type": "string",
                "description": "eleven-dubbing: target language code, e.g. es, ja, zh."
              },
              "source_lang": {
                "type": "string",
                "description": "eleven-dubbing: source language code (optional, detected if omitted)."
              },
              "extra": {
                "type": "string"
              },
              "wait_seconds": {
