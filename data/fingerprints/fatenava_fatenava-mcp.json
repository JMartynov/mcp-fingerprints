          "name": "cast_chart",
          "canonical_hash": "sha256:d090479fc6720392d80b0d7fbc073d97c7d68af2173f4a5d36ed65c57d668246",
          "description": "Cast up to three deterministic destiny charts from one birth: BaZi (Four Pillars, True Solar Time corrected), Zi Wei Dou Shu (Purple Star Astrology), and a Western natal chart (tropical zodiac, Placidus houses). Free and anonymous - no account, nothing stored. Chart data is computed, not AI-generated.",
          "is_mutating": false,
          "property_keys": [
            "birthTimeKnown",
            "day",
            "gender",
            "hour",
            "latitude",
            "longitude",
            "minute",
            "month",
            "systems",
            "text",
            "timeZoneId",
            "year"
          ],
          "required_keys": [],
          "parameter_types": {
            "day": "integer",
            "hour": "integer",
            "text": "string",
            "year": "integer",
            "month": "integer",
            "gender": "string",
            "minute": "integer",
            "systems": "array",
            "latitude": "number",
            "longitude": "number",
            "timeZoneId": "string",
            "birthTimeKnown": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "day": {
                "type": "integer",
                "description": "Birth day 1-31"
              },
              "hour": {
                "type": "integer",
                "description": "Birth hour 0-23; pass with birthTimeKnown=false if unknown"
              },
              "text": {
                "type": "string",
                "description": "One-line birth description: date, time (omit if unknown), birthplace city, gender. Example: \"1995-08-10 12:00 Taipei female\". City names in English, Chinese, Japanese or Korean. Use EITHER this OR the structured fields."
              },
              "year": {
                "type": "integer",
                "description": "Birth year (structured input)"
              },
              "month": {
                "type": "integer",
                "description": "Birth month 1-12"
              },
              "gender": {
                "enum": [
                  "male",
                  "female"
                ],
                "type": "string",
                "description": "Required with structured input"
              },
              "minute": {
                "type": "integer",
                "description": "Birth minute 0-59"
              },
              "systems": {
                "type": "array",
                "items": {
                  "enum": [
                    "bazi",
                    "ziwei",
                    "astro"
                  ],
                  "type": "string"
                },
                "description": "Which chart systems to return. Default: all three."
              },
              "latitude": {
                "type": "number",
                "description": "Birthplace latitude"
              },
              "longitude": {
                "type": "number",
                "description": "Birthplace longitude; used for True Solar Time correction"
              },
              "timeZoneId": {
                "type": "string",
                "description": "IANA timezone of the birthplace, e.g. \"Asia/Taipei\""
              },
              "birthTimeKnown": {
                "type": "boolean",
                "description": "Set false when the exact birth time is unknown - BaZi still returns three pillars; hour-dependent parts are omitted honestly"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "birth": {
                "type": "object",
                "description": "Echo of the parsed birth input (date, time, gender, place)"
              },
              "charts": {
                "type": "object",
                "description": "Per-system slot: { ok: true, view: {...} } or { ok: false, reason }. Field names are English; traditional terms (stems, branches, palaces, stars) are native Chinese characters."
              },
              "_source": {
                "type": "object",
                "description": "Provider attribution (FateNava) and computation note"
              },
              "timeKnown": {
                "type": "boolean",
                "description": "Whether the birth hour was known and used"
              }
            }
          },
