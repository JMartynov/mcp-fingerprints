          "name": "briefkit_generate_database_schema",
          "canonical_hash": "sha256:42503f1db5c4428fcd4ca4fc9bbe9af87499800f6bd1ab1e478f77f2a28fb1b1",
          "description": "Generate a complete Supabase/PostgreSQL database schema for a SaaS product — tables with column types, foreign keys, indexes, and a security baseline. Ready to run in Supabase SQL editor.\n\nArgs:\n  - product_name (string): Name of the SaaS product\n  - saas_type (string): Type of SaaS — b2b, devtool, productivity, marketplace, or microsaas\n  - custom_tables (array of strings): Additional product-specific table names beyond the standard ones\n\nReturns: Complete SQL schema with CREATE TABLE statements, indexes, and security baseline (REVOKE statements for sensitive tables).\n\nExamples:\n  - ",
          "is_mutating": false,
          "property_keys": [
            "custom_tables",
            "product_name",
            "saas_type"
          ],
          "required_keys": [
            "product_name"
          ],
          "parameter_types": {
            "product_name": "string",
            "saas_type": "string",
            "custom_tables": "array"
