        {
          "name": "briefkit_generate_design_system",
          "canonical_hash": "sha256:e78591c56edaa11e631206604b29b66b1eb11e97acdc0d7b4e19a14049e930ce",
          "description": "Generate a complete DESIGN.md specification for a SaaS product — colors, typography, spacing, components, dark mode, and constraints. Ready to paste into Lovable, Claude Code, or Cursor.\n\nArgs:\n  - product_name (string): Name of the SaaS product\n  - palette (string): Color palette — one of: trust-blue, forest-green, warm-gold, cool-purple, slate-minimal, coral-energy\n  - fonts (string): Font pairing — one of: geometric, serif-modern, clean-sans, editorial, rounded\n  - border_radius (number): Border radius in px (0-20, default 8)\n  - density (string): Layout density — compact, balanced, or spacious\n\nReturns: Complete DESIGN.md in markdown format with CSS custom properties, type scale, spacing, component specs, and dark mode mapping.\n\nExamples:\n  - ",
          "is_mutating": false,
          "property_keys": [
            "border_radius",
            "density",
            "fonts",
            "palette",
            "product_name"
          ],
          "required_keys": [
