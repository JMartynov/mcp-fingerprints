          "name": "bridge_flow_trace",
          "canonical_hash": "sha256:4c70cca8c33014ebbd914474b119ab58b253bebefae5cb8faccd7deb1627d568",
          "description": "Multi-hop cross-chain forensic trace for a wallet address. Auto-detects bridge solvers (NEAR Intents, Wormhole, deBridge, Stargate, Across, Synapse, Hop), follows relay chains across chains, and returns a graph of nodes (solver / relay / user / exchange / bridge) and edges with on-chain tx signatures plus same_intent_correlation. EVM chains, Solana and Kaia only.",
          "is_mutating": false,
          "property_keys": [
            "address",
            "chain",
            "max_depth"
          ],
          "required_keys": [
            "address"
          ],
          "parameter_types": {
            "address": "string",
            "chain": "string",
            "max_depth": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "description": "Wallet address to start the trace from"
              },
              "chain": {
                "type": "string",
                "description": "Source chain (default: solana)",
                "enum": [
                  "bitcoin",
                  "ethereum",
                  "polygon",
                  "bsc",
                  "base",
                  "arbitrum",
                  "optimism",
                  "avalanche",
                  "solana",
