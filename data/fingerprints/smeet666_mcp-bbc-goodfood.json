        {
          "name": "get_recipe",
          "canonical_hash": "sha256:9f921532f401d11c2419b7a5c39b9909fbcea1bf33935ae513637bece7897403",
          "description": "Read one recipe: its ingredients, steps, times, rating and nutrition, from the page path a search row carries, in either of the two renditions the site writes.",
          "is_mutating": false,
          "property_keys": [
            "id",
            "servings",
            "unit_system"
          ],
          "required_keys": [],
          "parameter_types": {
            "id": "string",
            "servings": "integer",
            "unit_system": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1,
                "description": "The page's own path, as a search_recipes row carries it."
              },
              "servings": {
                "type": "integer",
                "maximum": 100,
                "minimum": 1,
                "description": "Put the ingredients to this many people. Quantities are then recomputed by this server, not published by the site, and each line says so under 'scaling'."
              },
              "unit_system": {
                "enum": [
                  "metric",
                  "us"
                ],
                "type": "string",
                "description": "Which of the site's own two renditions to read: 'metric' as it writes for its own readers, 'us' as it restates for readers in the United States. Both are the site's words. A recipe it restated nowhere comes back as it published it, said in 'unit_system' and in the notes."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:8705a54d2b3e014fa9cc8b662fd7e98c32db5bafd64656b7449a040661c8e8fd",
