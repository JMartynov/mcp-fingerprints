          "name": "capture_browser",
          "canonical_hash": "sha256:f323def9236fceca3afa3a0145f59afefd3f545eddeaa24e2574a1c56be7a774",
          "description": "Take a screenshot of a URL using headless Chromium. Uses system Chrome profile when available (set SNAPMCP_CHROME_PROFILE) for authenticated sessions, cookies, and extensions. SSRF protection is enabled by default (SNAPMCP_SSRF_PROTECTION=true) - blocks private IPs, localhost, and DNS-rebounding attacks. Supports full-page or viewport captures.",
          "is_mutating": false,
          "property_keys": [
            "fullPage",
            "height",
            "output",
            "url",
            "width"
          ],
          "required_keys": [
            "url"
          ],
          "parameter_types": {
            "url": "string",
            "fullPage": "boolean",
            "width": "number",
            "height": "number",
            "output": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "URL to capture (http/https). Must pass SSRF validation: no private IPs (10/8, 172.16/12, 192.168/16, fc00::/7), no localhost variants, no DNS-rebinding. Redirects are also validated."
              },
              "fullPage": {
                "type": "boolean",
                "description": "Capture full scrollable page (true) or just the viewport (false). Full page may take longer and use more memory.",
                "default": false
              },
              "width": {
                "type": "number",
                "description": "Viewport width in pixels (320-3840). Ignored if fullPage=true.",
                "default": 1280
              },
              "height": {
                "type": "number",
                "description": "Viewport height in pixels (240-4096). Ignored if fullPage=true.",
                "default": 800
              },
              "output": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          },
