            "day": "integer",
            "hour": "integer",
            "year": "integer",
            "month": "integer",
            "gender": "string",
            "minute": "integer",
            "second": "integer",
            "timezone": "number",
            "dstOffset": "number",
            "longitude": "number",
            "timezoneId": "string",
            "isLeapMonth": "boolean",
            "calendarType": "string",
