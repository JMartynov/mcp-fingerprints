          "name": "webpeel_act",
          "canonical_hash": "sha256:e7fc629bd2fc17d9077efcc573a5cd00f61fbfe796a30957ae5946c01c2021f5",
          "description": "Automate interactions with any web page using a real browser. Click buttons, fill forms, select dropdowns, scroll, wait for elements, and press keys. Returns extracted content and optionally a screenshot after all actions complete. Use for: logging into sites, submitting forms, navigating multi-step flows, interacting with dynamic content that requires user input. Actions: click, type, fill, scroll, wait, press, hover, select.",
          "is_mutating": false,
          "property_keys": [
            "actions",
            "extract_after",
            "screenshot_after",
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "url": "string",
            "actions": "array",
            "extract_after": "boolean",
            "screenshot_after": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "URL to interact with"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "click",
                        "type",
                        "fill",
                        "scroll",
                        "wait",
                        "press",
                        "hover",
                        "select"
                      ],
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "selector": {
                      "type": "string"
                    },
                    "milliseconds": {
                      "type": "number"
                    }
                  }
                },
                "description": "Actions to perform, e.g. [{type:\"click\",selector:\".btn\"}, {type:\"type\",selector:\"#q\",value:\"hello\"}]"
              },
              "extract_after": {
                "type": "boolean",
                "default": true,
                "description": "Extract content after actions complete"
              },
