        {
          "name": "fetch",
          "canonical_hash": "sha256:1e0ecbd29bf5fbe781ca27aea8c3641eda1bd795ab4d98e8288f5dd2798c284b",
          "description": "Fetch a URL and return its content as clean markdown. Handles Twitter/X tweets, YouTube videos (with transcripts), arXiv papers, PDFs, Wikipedia articles, and GitHub repos/files/issues/PRs/releases directly. Direct image URLs (png/jpeg/gif/webp) are returned as an image block for vision. Otherwise checks a shared cache, then falls back through a multi-tier chain: Jina Reader, web archives (Wayback, archive.ph, Arquivo.pt), raw fetch, RSS, CrossRef, Semantic Scholar, HackerNews, Reddit, OG meta. Long pages are truncated at maxLength characters — paginate with startIndex. Results are cached for the session; pass noCache to force a live fetch.",
          "is_mutating": false,
          "property_keys": [
            "maxLength",
            "maxTier",
            "noCache",
            "startIndex",
            "url"
          ],
          "required_keys": [
            "url"
          ],
          "parameter_types": {
            "url": "string",
            "maxTier": "string",
            "maxLength": "string",
            "startIndex": "string",
            "noCache": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "The URL to fetch"
              },
              "maxTier": {
                "type": "string",
                "description": "Stop at this tier (1-5, default 5). Lower = faster but fewer fallbacks."
              },
              "maxLength": {
                "type": "string",
                "description": "Maximum characters to return (default ${DEFAULT_MAX_LENGTH})"
              },
              "startIndex": {
                "type": "string",
                "description": "Character offset to start from, for paginating long content (default 0)"
              },
              "noCache": {
                "type": "string",
                "description": "Skip session and shared caches and fetch live content"
              }
            },
            "required": [
              "url"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:9fe0c30ff92510520f19c48188ad81cecd2c5a124222b6303b3f926ce84a03bf",
