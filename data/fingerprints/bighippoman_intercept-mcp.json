        {
          "name": "extract",
          "canonical_hash": "sha256:e83c46587aef48ea3de349ed500cfab3fe06935a7e7f36271b4dbf963717f95a",
          "description": "Extract specific values from a web page as JSON instead of markdown prose. Provide CSS selectors to pull named fields (text or an attribute, first match or all), and/or set tables:true to convert every HTML table to arrays of row objects. Use this when you need particular data (prices, lists, specs, tabular data) rather than the whole page. Honors per-domain auth and proxies.",
          "is_mutating": false,
          "property_keys": [
            "selectors",
            "tables",
            "url"
          ],
          "required_keys": [
            "url"
          ],
          "parameter_types": {
            "url": "string",
            "selectors": "object",
            "tables": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "The URL to extract from"
              },
              "selectors": {
                "type": "object",
                "properties": {
                  "selector": {
                    "type": "string"
                  },
                  "attr": {
                    "type": "string",
                    "description": "Extract this attribute (e.g. href, src) instead of text"
                  },
                  "all": {
                    "type": "boolean",
                    "description": "Return every match as an array instead of the first"
                  }
                }
              },
              "tables": {
                "type": "boolean",
                "description": "Extract all HTML tables as arrays of row objects (default true when no selectors are given)"
              }
            },
            "required": [
              "url"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:8addb1e46da9638bf56063f41ab9a5796b054611dc904ac24c14f984e67a6e61",
          "parameters": [
            {
              "name": "selectors",
