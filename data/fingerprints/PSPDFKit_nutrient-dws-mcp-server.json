        {
          "name": "ai_redactor",
          "canonical_hash": "sha256:ce38ddf4980341e32439b84092548480876e7d7c638d93728e4b579f91ecfa00",
          "description": "Detect and permanently redact sensitive content using the Nutrient AI Redaction API. Reads input files from the local file system or sandbox (if enabled) and writes redacted output back locally.\n\nAutomatically detects and permanently removes sensitive information from documents using AI analysis.\nDetected content types include:\n• Personally identifiable information (names, addresses, phone numbers)\n• Financial data (credit card numbers, bank accounts, SSNs)\n• Email addresses and URLs\n• Protected health information (PHI)\n• Any custom criteria you specify\n\nBy default (when neither stage nor apply is set), redactions are detected and immediately applied. Set stage to true to detect and stage redactions without applying them. Set apply to true to apply previously staged redactions.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:b31ee4b1cdfd675d9e5d3ac86b07053447129ef4798da80e587e3839b5f6296e",
          "parameters": [],
          "annotations": {}
        },
