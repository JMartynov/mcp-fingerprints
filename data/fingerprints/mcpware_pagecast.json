        {
          "name": "smart_export",
          "canonical_hash": "sha256:cf28d31807b4ca1ae425cfa9e8a964d0c7f6979f4708516b69a498f563750970",
          "description": "Convert a recorded .webm to GIF or MP4 with tooltip overlays on interactions.\n\nThe full viewport stays visible. When an interaction happens (click, type, hover),\na clean tooltip inset appears showing a magnified close-up of that area with a small\narrow pointing toward the interaction. Modern, minimal design (Linear/Figma style).\n\nThe tooltip positions itself on the opposite side of the screen from the interaction.\n\nPerfect for product demos where viewers need to see both the full UI context AND the detail.\n\nExample workflow:\n1. record_page → interact_page (clicks, typing, etc.) → stop_recording\n2. smart_export with the webmPath and timelinePath from stop_recording\n3. Get a polished GIF/MP4 with tooltip overlays on every interaction\n\nCompare with cinematic_export which crops the entire frame to follow the action.",
          "is_mutating": false,
          "property_keys": [
            "format",
            "fps",
            "holdPerTarget",
            "magnifyScale",
            "timelinePath",
            "tooltipSize",
            "webmPath",
            "width"
          ],
          "required_keys": [
            "timelinePath",
            "webmPath"
          ],
          "parameter_types": {
            "webmPath": "string",
            "timelinePath": "string",
            "format": "string",
            "magnifyScale": "number",
            "tooltipSize": "number",
            "holdPerTarget": "number",
            "fps": "number",
            "width": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "webmPath": {
                "type": "string",
                "description": "Path to the .webm file from stop_recording"
              },
              "timelinePath": {
                "type": "string",
                "description": "Path to the -timeline.json file from stop_recording"
              },
              "format": {
                "type": "string",
                "description": "Output format (default: gif)",
                "default": "gif",
                "enum": [
                  "gif",
                  "mp4"
                ]
              },
              "magnifyScale": {
                "type": "number",
                "description": "How much to magnify inside the tooltip (default 1.6x)",
                "default": 1.6
              },
              "tooltipSize": {
                "type": "number",
                "description": "Size of the tooltip inset in pixels (default 380)",
                "default": 380
              },
              "holdPerTarget": {
                "type": "number",
                "description": "How long to show each tooltip (seconds)",
                "default": 1.2
              },
              "fps": {
                "type": "number",
                "description": "Frame rate for GIF output",
                "default": 12
              },
              "width": {
                "type": "number",
                "description": "Output width for GIF (height auto-scaled)",
                "default": 800
              }
            },
            "required": [
