        {
          "name": "ps_apply_image",
          "canonical_hash": "sha256:5854fa3a756b0ebdc76d4a2729686353bbb55dd9ca4291d6b35035e3f5d3177f",
          "description": "Composite a source layer + channel onto the ACTIVE layer using a calculation blend mode (Image ▸ Apply Image). **Reach for this** for luminosity blends, frequency-separation re-blends, texture overlays, or pulling one channel into another. Source = a layer (merged or named) and a channel (rgb/red/green/blue/alpha). Bakes into pixels, so by default it runs on a DUPLICATE of the active layer (set apply_to_active_layer=true to bake in place). The active layer must be a normal pixel layer. (AM-only; verified live on PS 27.2.0.)",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:ddad5c8f8289348b31542a09847ba0ee7b385d4580812adfc79f5d1936eaaab7",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "ps_calculations",
          "canonical_hash": "sha256:9a80f36901d7bb634acade85904543ddc6485c4be9085c345946b7dc2b9f78fa",
          "description": "Blend TWO sources (each a layer + single channel) into a NEW alpha channel via a calculation blend mode (Image ▸ Calculations). **Reach for this** to build advanced selections/masks from channel math — e.g. difference of two channels to isolate edges, or multiply two channels for a luminosity mask. Non-destructive: adds a new channel (delete it to revert); the result is loadable as a selection via ps_selection_channel op=load. (AM-only; verified live on PS 27.2.0.)",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
