          "name": "get_ohlcv",
          "canonical_hash": "sha256:21fe69eaf70e20457c28cdaf853c32d9e512cc0d5cdf6519c170911b832933e9",
          "description": "Get stored end-of-day OHLCV candles for a stock, ETF, or crypto ticker, daily or weekly. Use this for exact-return calculations, charts, and backtests after get_summary identifies a setup. Results are paginated; pass next_cursor back as cursor to continue. Equity and ETF bars are split-and-dividend adjusted; crypto bars are unadjusted. Credit cost is 1 credit per 100 bars returned, rounded up, with a 1 credit minimum.",
          "is_mutating": false,
          "property_keys": [
            "cursor",
            "end",
            "limit",
            "order",
            "start",
            "ticker",
            "timeframe"
          ],
          "required_keys": [
            "ticker"
          ],
