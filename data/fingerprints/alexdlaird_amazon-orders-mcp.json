              "site": {
                "type": "string",
                "description": "The Amazon site to check, e.g. `amazon.de`. By default, the default site and every other site with a saved session are checked.",
                "default": null
              },
              "account": {
                "type": "string",
                "description": "The Amazon account to check, e.g. `spouse`. By default, the default account.",
                "default": null
              }
            },
