        {
          "name": "find_charge",
          "canonical_hash": "sha256:31a816d97d60c4f97714e6ffc4701bcbe155df989a666f901c6c6ae5ae36de73",
          "description": "Find the Amazon Transactions behind a card or bank charge, by its amount and date, each with its Order and the Items in it. A Transaction matches when its amount equals `amount` and it completed within `window_days` of `charge_date`, since Amazon can complete a charge on a different day than a statement shows it.",
          "is_mutating": false,
          "property_keys": [
            "account",
            "amount",
            "charge_date",
            "last_four",
            "site",
            "window_days"
          ],
          "required_keys": [
            "amount",
            "charge_date",
            "window_days"
          ],
          "parameter_types": {
            "amount": "number",
            "charge_date": "string",
            "last_four": "string",
            "window_days": "integer",
            "site": "string",
            "account": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "description": "The charge or refund's amount, e.g. `12.99`. Its sign is ignored, since statements and Amazon show charges and refunds with different signs."
              },
              "charge_date": {
                "type": "string",
                "description": "The date the charge shows, e.g. `2026-11-10`."
              },
              "last_four": {
                "type": "string",
                "description": "The last four digits of the card it was charged to, to match only that card's Transactions.",
                "default": null
              },
              "window_days": {
                "type": "integer",
                "description": "How many days either side of `charge_date` a Transaction can have completed."
              },
              "site": {
                "type": "string",
                "default": null
              },
              "account": {
                "type": "string",
                "default": null
              }
            },
            "required": [
              "amount",
              "charge_date",
              "window_days"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:56f2beda31fa877a9ecdf852d5aa0a4f103737e340941932f50498bdc0156532",
