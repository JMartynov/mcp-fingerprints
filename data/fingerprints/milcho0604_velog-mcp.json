        {
          "name": "velog_render_diagram",
          "canonical_hash": "sha256:612fedbdae04de5398ea9f760ee5f943c890ae5a62666470960a11c8763741f2",
          "description": "구성도·흐름도를 그려 PNG 로 만들고 벨로그에 올린다. 본문에 붙일 마크다운을 돌려준다.\\n",
          "is_mutating": false,
          "property_keys": [
            "// ★ id 가 겹치면 관통 감사를 피할 수 있다. NMAP 은 마지막 것만 남기는데\n\t\t\t\t//   '자기 노드 제외' 집합은 id 문자열로 같은 id 를 전부 빼기 때문이다.\n\t\t\t\t//   생략 시 자동 부여되는 n0·n1 과의 충돌도 같은 문제라 함께 본다.\n\t\t\t\tnodes",
            "// ★ 글자에도 상한이 필요하다. 좌표만 묶어두면 제목 하나에 10MB 를 넣어\n\t\t\t\t//   HTML·SVG·getBBox·stdout 을 동시에 부풀릴 수 있다 (코덱스 4차).\n\t\t\t\ttitle",
            "alt",
            "edges",
            "groups",
            "legend",
            "planes",
            "post_id",
            "subtitle",
            "upload"
          ],
          "required_keys": [
            "// ★ id 가 겹치면 관통 감사를 피할 수 있다. NMAP 은 마지막 것만 남기는데\n\t\t\t\t//   '자기 노드 제외' 집합은 id 문자열로 같은 id 를 전부 빼기 때문이다.\n\t\t\t\t//   생략 시 자동 부여되는 n0·n1 과의 충돌도 같은 문제라 함께 본다.\n\t\t\t\tnodes",
            "// ★ 글자에도 상한이 필요하다. 좌표만 묶어두면 제목 하나에 10MB 를 넣어\n\t\t\t\t//   HTML·SVG·getBBox·stdout 을 동시에 부풀릴 수 있다 (코덱스 4차).\n\t\t\t\ttitle"
          ],
          "parameter_types": {
            "// ★ 글자에도 상한이 필요하다. 좌표만 묶어두면 제목 하나에 10MB 를 넣어\n\t\t\t\t//   HTML·SVG·getBBox·stdout 을 동시에 부풀릴 수 있다 (코덱스 4차).\n\t\t\t\ttitle": "string",
            "subtitle": "string",
            "// ★ id 가 겹치면 관통 감사를 피할 수 있다. NMAP 은 마지막 것만 남기는데\n\t\t\t\t//   '자기 노드 제외' 집합은 id 문자열로 같은 id 를 전부 빼기 때문이다.\n\t\t\t\t//   생략 시 자동 부여되는 n0·n1 과의 충돌도 같은 문제라 함께 본다.\n\t\t\t\tnodes": "string",
            "groups": "array",
            "edges": "array",
            "planes": "string",
            "legend": "boolean",
            "alt": "string",
            "upload": "boolean",
            "post_id": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "// ★ 글자에도 상한이 필요하다. 좌표만 묶어두면 제목 하나에 10MB 를 넣어\n\t\t\t\t//   HTML·SVG·getBBox·stdout 을 동시에 부풀릴 수 있다 (코덱스 4차).\n\t\t\t\ttitle": {
                "type": "string",
                "description": "그림 제목 (좌상단)"
              },
              "subtitle": {
                "type": "string",
                "description": "한 줄 설명·근거"
              },
              "// ★ id 가 겹치면 관통 감사를 피할 수 있다. NMAP 은 마지막 것만 남기는데\n\t\t\t\t//   '자기 노드 제외' 집합은 id 문자열로 같은 id 를 전부 빼기 때문이다.\n\t\t\t\t//   생략 시 자동 부여되는 n0·n1 과의 충돌도 같은 문제라 함께 본다.\n\t\t\t\tnodes": {
                "type": "string"
              },
