        {
          "name": "list_sections",
          "canonical_hash": "sha256:5a57c1c7f957ae953831d2765bfb66a42013c4a3d83185d14763efea6fd186eb",
          "description": "List all section headers in a doc file. Use before get_section() to find the right header.\n\nEspecially useful for large files like ta.md, strategy.md, collections.md, drawing.md, general.md\nwhich have 50-115 sections each.",
          "is_mutating": false,
          "property_keys": [
            "path"
          ],
          "required_keys": [],
          "parameter_types": {
            "path": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Documentation file path (e.g., \"reference/functions/ta.md\")"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:cd90bce6eb28c2ca28d200bc00f13a1e6e045c6d1a746466f6c9bad04bd1bf4b"
        },
        {
          "name": "resolve_topic",
          "canonical_hash": "sha256:56e6f6bae5b1177e2a4afc72a60538e384a122f5765798162bc901c82e2eb24e",
          "description": "Fast lookup for exact Pine Script API terms and known concepts.\n\nUse for exact function names and Pine Script vocabulary\n(e.g., \"ta.rsi\", \"strategy.entry\", \"repainting\", \"request.security\").\n\nFor natural language questions, read the docs://manifest resource\nfor routing guidance, then use get_doc() or list_sections() + get_section().",
          "is_mutating": false,
          "property_keys": [
            "query"
          ],
          "required_keys": [],
          "parameter_types": {
            "query": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "Exact Pine Script term or known concept keyword."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "matched_keywords",
                    "score"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "score": {
                      "type": "integer"
                    },
                    "read_with": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": []
                    },
                    "matched_keywords": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "A matched documentation topic."
                }
              },
              "suggestion": {
                "type": "string"
              }
            },
            "required": [
              "matches",
              "query",
              "suggestion"
            ]
          },
          "description_hash": "sha256:b865229b94ec6fe5b9d512d44f170e33e7526b2384ab7227a832d43f3ad265b6"
        },
        {
          "name": "search_docs",
          "canonical_hash": "sha256:f8d252658a41833f7988bce429ab5f792fdb1c931034339c5b5c14e02379dbb1",
          "description": "Search Pine Script v6 documentation and return matching sections.\n\nFinds sections containing the query and returns previews with\nget_section() call hints so you can read the full content.",
          "is_mutating": false,
          "property_keys": [
            "max_results",
            "query"
          ],
          "required_keys": [],
          "parameter_types": {
            "query": "string",
            "max_results": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "Exact string to search for (case-insensitive)."
              },
              "max_results": {
                "type": "integer",
                "default": 5,
                "description": "Maximum sections to return (default: 5)"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:a39ab2768f0def08189a508570aaaf1e240c611387cbbef17d5208c3bd3b7f4e"
        },
        {
          "name": "validate_function",
          "canonical_hash": "sha256:b297cd6fce464074bb39cfc293509bf89ff2d27c021506368c0b5e2f45e7701c",
          "description": "Check if a Pine Script v6 function name is valid.",
          "is_mutating": false,
          "property_keys": [
            "fn_name"
          ],
          "required_keys": [],
          "parameter_types": {
            "fn_name": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "fn_name": {
                "type": "string",
                "description": "Function name to validate (e.g., \"ta.sma\", \"strategy.entry\", \"plot\")"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "enum": [
                      "namespaced",
                      "toplevel"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "valid": {
                "type": "boolean"
              },
              "function": {
                "type": "string"
              },
              "suggestion": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "valid",
              "type",
              "function"
            ]
          },
          "description_hash": "sha256:71dd4770390bb851c2499185cab7896d0a4116e789be04e3d9c4d5b9fb80925b"
        }
