        {
          "name": "get_doc",
          "canonical_hash": "sha256:f1135b75ba324afd7763b0598a8e979c46dad4b8389a129136bbd367b6d0a13f",
          "description": "Read a specific Pine Script v6 documentation file.\n\nFor large files (ta.md, strategy.md, collections.md, drawing.md,\ngeneral.md) prefer list_sections() + get_section() to avoid\nloading 1000-2800 line files into context.",
          "is_mutating": false,
          "property_keys": [
            "limit",
            "offset",
            "path"
          ],
          "required_keys": [],
          "parameter_types": {
            "path": "string",
            "limit": "integer",
            "offset": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative path to the documentation file (e.g., \"reference/functions/ta.md\")"
              },
              "limit": {
                "type": "integer",
                "default": 0,
                "description": "Maximum characters to return. Use 30000 for large files to avoid token limits."
              },
              "offset": {
                "type": "integer",
                "default": 0,
                "description": "Character offset to start reading from (default: 0)"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:0664b6bdde6829cdc828d2a6237bd41477b9173567e35a99355c01884a85413a"
        },
        {
          "name": "get_functions",
          "canonical_hash": "sha256:cff6ac1e44557847bb6e52231178ebad9a8612b1b2436449ebc56baa2ca2ffc8",
          "description": "Get valid Pine Script v6 functions, optionally filtered by namespace.\n\nUse before writing Pine Script to see which functions exist.\nFor checking a single function name, use validate_function() instead.",
          "is_mutating": false,
          "property_keys": [
            "namespace"
          ],
          "required_keys": [],
          "parameter_types": {
            "namespace": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "default": "",
                "description": "Filter by namespace (e.g., \"ta\", \"strategy\", \"request\").\n       Empty string returns all functions grouped by namespace."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:3407fa8717a686b5d10910dd9e9d225e8e6c525a329d50d1dadec56336d8d6ed"
        },
        {
          "name": "get_prompt",
          "canonical_hash": "sha256:4a732639fe2774bdb6401233cab8013993af1550887c71c2f631af98f931a89e",
          "description": "Get a prompt by name with optional arguments.\n\nReturns the rendered prompt as JSON with a messages array.\nArguments should be provided as a dict mapping argument names\nto values.",
          "is_mutating": false,
          "property_keys": [
            "arguments",
            "name"
          ],
          "required_keys": [],
          "parameter_types": {
            "name": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of the prompt to get"
              },
              "arguments": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Optional arguments for the prompt"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "result": {
                "type": "string"
              }
            },
            "required": [
              "result"
            ]
          },
          "description_hash": "sha256:4273db400dc335a51df6fae9d3914cf7eb7ee995a583321309576b903b1c1d4d"
        },
        {
          "name": "get_section",
          "canonical_hash": "sha256:41d782366ee37ac0ef01fe8ffef9d3c1a36edf1cb2daae871cc815c0910f3cb4",
          "description": "Get a specific section from a documentation file by its header.\n\nUse after list_sections() shows available headers, or after\nresolve_topic() / search_docs() identifies the relevant file.",
          "is_mutating": false,
          "property_keys": [
            "header",
            "include_children",
            "path"
          ],
          "required_keys": [],
          "parameter_types": {
            "path": "string",
            "header": "string",
            "include_children": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Documentation file path (e.g., \"reference/functions/strategy.md\")"
              },
              "header": {
                "type": "string",
                "description": "Header text to find (e.g., \"strategy.exit()\" or \"## strategy.exit()\")"
              },
              "include_children": {
                "type": "boolean",
                "default": true,
                "description": "Include nested subsections under the header (default: True)"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:beb0949fe664d2dc6e2c3cb8b40c89f6c763b033db3a2d5985c0083bae62e316"
        },
        {
          "name": "list_docs",
          "canonical_hash": "sha256:a19c864b17a48b62a8db3defd1d6cc5641d1086acb36f20e77510bf55e5294e7",
          "description": "List all available Pine Script v6 documentation files with descriptions.\n\nReturns files organised by category with descriptions.\nFor small files use get_doc(path). For large files\n(ta.md, strategy.md, collections.md, drawing.md, general.md)\nuse list_sections(path) then get_section(path, header).",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "outputSchema": null,
          "description_hash": "sha256:daefbb0382dc81efae4736253464161103eee75aad8b7a116a41a4fe6c36c256"
        },
        {
          "name": "list_prompts",
          "canonical_hash": "sha256:b0e4472fa3b4d982189861368f595b6a8b257bc79a219d14f479eaba1626d858",
          "description": "List all available prompts.\n\nReturns JSON with prompt metadata including name, description,\nand optional arguments.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
