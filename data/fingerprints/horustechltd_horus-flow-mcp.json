        {
          "name": "getCompositeIntelligence",
          "canonical_hash": "sha256:d385eb07dd6916739a51e463d2e1902b68c2c6d6bf64c5d2f0b06e95bc9e74af",
          "description": "The Final Verdict — ONE number to rule them all.\n\nCombines 4 intelligence layers into a single actionable score (0-100):\n  - Climate (WiseMan): Is the market worth trading?\n  - Ignition (VBE): Is volatility about to explode?\n  - Heatmap (Liquidations): Where is price forced to go?\n  - XFlow (Spot↔Futures): Is the move real or speculative?\n\nVerdicts: `FULL_CONVICTION` (>80), `PARTIAL_CONVICTION` (60-80),\n`NEUTRAL` (40-60), `STAY_OUT` (<40).\n\n**v2.1**: Includes `confidence` (0.0–1.0) = composite_score/100.\n",
          "is_mutating": false,
          "property_keys": [
            "symbol"
          ],
          "required_keys": [],
          "parameter_types": {
            "symbol": "string"
          },
          "inputSchema": {
            "type": "object",
