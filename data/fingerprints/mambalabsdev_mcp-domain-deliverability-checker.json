      "tool_signatures": [
        {
          "name": "check_domain_deliverability",
          "canonical_hash": "sha256:35654b5e59977f4f1a94ba9860597c41fc4c218810da75bd299357e34a855ac6",
          "description": "Audit the email deliverability and DNS health of one domain or a list of domains before sending cold email from it or to it. Returns one flat, Clay-ready JSON row per domain: SPF, DKIM, and DMARC records with the DMARC policy, MX records and mail provider, DNS blacklist status, catch-all status, domain age, and a 0 to 100 health score. Results are cached for 24 hours per domain; set skipCache to force a fresh audit. It reads public DNS only: it sends no email and does not verify individual mailboxes, so use an email verifier for that. A run that does not succeed is returned as an error with its run ID and status. Read-only; requires an APIFY_TOKEN and consumes Apify credits per call.",
          "is_mutating": false,
          "property_keys": [
            "attempt_catch_all",
            "batchSize",
            "domain",
            "domains",
            "max_charge_usd",
            "skipCache"
          ],
          "required_keys": [],
          "parameter_types": {
            "max_charge_usd": "number",
            "domain": "string",
            "domains": "string",
            "batchSize": "string",
            "skipCache": "string",
            "attempt_catch_all": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "max_charge_usd": {
                "type": "number"
              },
              "domain": {
                "type": "string",
                "description": "One bare domain to audit, without https:// or a path, e.g. stripe.com. Provide this or domains."
              },
              "domains": {
                "type": "string"
              },
              "batchSize": {
                "type": "string",
                "description": "How many domains from the list are audited at the same time. Higher finishes a long list sooner. 1 to 10. Default: 5."
              },
              "skipCache": {
                "type": "string",
                "description": "Set true to ignore the 24 hour result cache and audit the domain again now, for example right after a DNS change. Default: false."
              },
              "attempt_catch_all": {
                "type": "string",
                "description": "Set true to run the SMTP catch-all probe. The Apify platform blocks outbound port 25, so on Apify the probe returns unknown; leave it off unless you run the actor where port 25 is open. Default: false."
              }
            },
            "required": []
          },
