                "description": "the drawing PDF — analysed first when it is not known yet (one daily credit), or the original PDF for a drawing_id loaded without one"
              },
              "masking": {
                "type": "string"
              },
              "output_path": {
                "type": "string",
                "description": "target .pdf path, or a directory (default: next to the drawing PDF, else the working directory)"
              },
              "overwrite": {
                "type": "boolean",
                "description": "allow replacing an existing output file"
