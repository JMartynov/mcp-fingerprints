            "drawing_id": "string",
            "pdf_path": "string",
            "masking": "string",
            "output_path": "string",
            "overwrite": "boolean",
            "share_link": "string",
            "timeout_seconds": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
