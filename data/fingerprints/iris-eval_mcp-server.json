          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "run": {
                "type": "string",
                "description": "narrow to one run; omit to read every evaluation that carries a case key"
              },
              "case_key": {
                "type": "string"
              },
              "session": {
                "type": "string",
                "description": "narrow to one session (the turns logged with that session_id)"
              },
              "group_by": {
                "type": "string",
                "description": "case_key (default): repeats of one question; session: the turns of one conversation, so a session answered both ways reads as flaky and by_case rows carry session ids",
                "enum": [
                  "case_key",
                  "session"
                ]
              },
              "min_attempts": {
                "type": "number",
                "description": "ignore cases asked fewer than this many times (default 1). A case asked once cannot be shown to be flaky"
              },
              "question": {
                "type": "string",
                "description": "read the rate for ONE question: only evaluations that judged it count, and an attempt passes when every rule answering it passed — not the composed verdict",
                "enum": [
                  "safe_output",
                  "grounded",
                  "complete",
                  "relevant",
                  "task_completed",
                  "tool_use_correct",
                  "within_budget"
                ]
              }
            },
