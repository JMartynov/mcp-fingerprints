          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string"
              },
              "packageFormat": {
                "type": "string",
                "description": "Package format for every order in the batch.",
                "default": "small-parcel",
                "enum": [
                  "letter",
                  "large-letter",
                  "small-parcel",
                  "medium-parcel",
                  "parcel"
                ]
              },
              "sender": {
                "type": "object",
                "properties": {
                  "fullName": {
                    "type": "string"
                  },
                  "companyName": {
                    "type": "string"
                  },
                  "addressLine1": {
                    "type": "string"
                  },
                  "addressLine2": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "postcode": {
                    "type": "string"
                  }
                },
                "description": "Sender address. Omit to use the address saved in your Click & Drop account."
              },
              "despatchDate": {
                "type": "string",
                "description": "Planned despatch date YYYY-MM-DD. Omit if the account does not allow future-dated orders."
              },
              "shipments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Array of orders to book. Each entry is one order with its own recipient, weight and reference."
              }
            },
            "required": [
