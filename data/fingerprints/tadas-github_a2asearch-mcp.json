        {
          "name": "list_agents",
          "description": "Browse a category by GitHub stars or newest additions, with pagination. Stars indicate popularity, not reliability or suitability. Use search_agents when you have a task in mind.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
