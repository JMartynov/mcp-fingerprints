          "name": "cpe_lookup",
          "canonical_hash": "sha256:34e2297a3df9e7f078a8cfd2b519fde05907a89a009f0801f9f979712fcc131f",
          "description": "Search for Common Platform Enumeration (CPE) entries by product name in Shodan's CVEDB. Supports pagination and can return either full CPE details or just the total count. Useful for identifying specific versions and configurations of software and hardware.",
          "is_mutating": false,
          "property_keys": [
            "count",
            "limit",
            "product",
            "skip"
          ],
          "required_keys": [],
          "parameter_types": {
            "skip": "number",
            "count": "boolean",
            "limit": "number",
            "product": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "skip": {
                "type": "number",
                "default": 0,
                "description": "Number of CPEs to skip (for pagination)."
              },
              "count": {
                "type": "boolean",
                "default": false,
                "description": "If true, returns only the count of matching CPEs."
              },
              "limit": {
                "type": "number",
                "default": 1000,
                "description": "Maximum number of CPEs to return (max 1000)."
              },
              "product": {
                "type": "string",
                "description": "The name of the product to search for CPEs."
              }
            }
          },
          "outputSchema": null,
