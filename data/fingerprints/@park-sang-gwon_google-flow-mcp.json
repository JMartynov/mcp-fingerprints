      "tool_signatures": [
        {
          "name": "flow_connect",
          "description": "Attach to the dedicated Chrome (launching it if needed), open a tab owned by this server and load Google Flow. Other tools connect on demand, so this is mainly a warm-up and login check. If logged_in is false, sign in once in the Chrome window.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:e9d622ebe13f22533b4f60870856e013538d46f0f1f19901bfa7575fb3137567"
        },
        {
          "name": "flow_generate_image",
          "description": "Generate images through the Flow agent composer (Nano Banana models) and download them. Spends Flow credits when auto_confirm=true; auto_confirm=false prepares and verifies without sending. resume=true only waits for / downloads an in-flight generation.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:067ead1d89a7054b10ac0027396d713dfc0bd68b39347e7973c85fcfb1c22cf0"
        },
        {
          "name": "flow_generate_video",
          "description": "Generate one video through the Flow agent composer and download it. Spends Flow credits when auto_confirm=true. Call with auto_confirm=false first: the prompt, settings and reference image are prepared and verified but nothing is sent. resume=true skips the composer and only waits for / downloads an in-flight generation (after a crash or timeout).",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:47380feb5a9eaf24edee03a6d4839a542637dc1906a860466fccb6345001e255"
        },
        {
          "name": "flow_inspect",
          "description": "Snapshot interactive elements, optionally perform one action (click/hover a button matched by text or aria-label regex, press a key, or navigate), then return the elements that appeared/disappeared. This is how selectors are discovered when Flow changes its UI; paste the rows into a bug report. Never generates anything.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:eb656c60c2e88e1a1f4566ccde47ed59ff3e9fa95af8dcb16fea8ab4c73f45c1"
        },
        {
          "name": "flow_media_download",
          "description": "Download one Flow media item (video or image) by its Flow media uuid using the logged-in browser session. Uuids come from flow_project_open (image tiles expose one; video tiles do not).",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:49d46bc10ad7d2692cd1efca494d66cad3dd705839bf720637c6746663a5423d"
        },
        {
          "name": "flow_project_open",
          "description": "Navigate the owned tab to a Flow project URL and report how many media items the grid shows. Generation tools call this implicitly.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:24c60add7857035cdb56d13ee02a4063929df98ccb61b856e8efda01bb351fb3"
        },
        {
          "name": "flow_scene_extend",
          "description": "Scene Builder",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:eeda9f3adb0260b3ed30e5ccd54c84a072b50fa4e992aab1fbbc9f5aca085dfb"
        },
        {
          "name": "flow_scene_status",
          "description": "Open a Scene Builder view and report its clips (index, duration) and total length, plus whether an extension is still rendering. Costs no credits.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:9f5005045e5bf8685d3db0a0b9f34a963605bd5b334d73a292ce5ba547f244f7"
        },
        {
          "name": "flow_screenshot",
          "description": "Save a PNG of the tab this server owns and return its absolute path. Useful to see what the agent or Scene Builder is showing.",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "canonical_hash": "sha256:a764cab83cc492565f17d2702543e221fde108f738a4ddef93be33b8ae0354a3"
        },
        {
          "name": "flow_status",
          "description": "Report browser connection, login state, the current Flow project/scene, the running tool and in-flight jobs. Never touches the page.",
          "inputSchema": {
            "type": "object",
