            "query": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string",
                "maxLength": 500,
                "minLength": 2,
                "description": "Company name, CIF/NIF (B82846825), EU VAT (ESB82846825), or LEI (20 chars)"
              },
              "name": {
                "type": "string",
                "description": "Alias for `q` — accepted for compatibility with clients that send `name`."
              },
              "query": {
