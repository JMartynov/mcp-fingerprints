            "hostname": "string",
            "comment": "string",
            "servicename": "string",
            "sticky": "boolean",
            "notify": "boolean",
            "with_services": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "hostname": {
                "type": "string"
              },
              "comment": {
                "type": "string",
                "description": "What is known and who works on it, e.g. a ticket number."
              },
              "servicename": {
                "type": "string",
                "description": "Exact service name on that host. Empty: acknowledge the host.",
                "default": ""
              },
              "sticky": {
                "type": "boolean",
                "description": "Keep the acknowledgement until the object is ok again, also when the problem changes state.",
                "default": false
              },
              "notify": {
                "type": "boolean",
                "description": "Tell the contacts that the problem is acknowledged.",
                "default": true
              },
