        {
          "name": "docker_proxy",
          "canonical_hash": "sha256:0787385fd1f7da9c2405313b00be81b650d79b682623ae9dd0b8afdffbeca4d6",
          "description": "Proxy a Docker Engine API request through Portainer for a given environment. The `path` is forwarded as-is to the Docker daemon (e.g. /containers/json, /images/json, /containers/{id}/json). Pass a JMESPath `select` to project just the fields you need — raw Docker payloads are large. Example for /containers/json: `[].{id:Id,name:Names[0],state:State,image:Image}`.",
          "is_mutating": false,
          "property_keys": [
            "body",
