      "tool_signatures": [
        {
          "name": "find_gifts",
          "canonical_hash": "sha256:c4a91dac9a27361eb6110c9a86adf87626ac00c66cd628e0f040d7391b7a3b01",
          "description": "Search the curated Surprise Buddy database for gift ideas matching a recipient. Returns product cards with title, image, price, why-it-fits, and a clickable product URL. Country is required and is a hard filter — results are scoped to the marketplace + currency of that country.",
          "is_mutating": false,
          "property_keys": [
            "age",
            "budget_max_cents",
            "budget_min_cents",
            "country",
            "favorite_color",
            "gender",
            "interests",
            "limit",
            "occasion",
            "profession"
          ],
          "required_keys": [],
          "parameter_types": {
            "age": "integer",
            "limit": "integer",
            "gender": "string",
            "country": "string",
            "occasion": "string",
            "interests": "array",
            "profession": "string",
            "favorite_color": "string",
            "budget_max_cents": "integer",
            "budget_min_cents": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "age": {
                "type": "integer",
                "maximum": 120,
                "minimum": 0,
                "description": "Recipient age in years. Filters gifts whose age range covers this value."
              },
              "limit": {
                "type": "integer",
                "default": 5,
                "maximum": 20,
                "minimum": 1,
                "description": "Maximum number of gifts to return (1–20, default 5)."
              },
              "gender": {
                "enum": [
                  "male",
                  "female",
                  "unisex"
                ],
                "type": "string",
                "description": "Recipient gender. Gifts tagged \"unisex\" are always included regardless of this value."
              },
              "country": {
                "type": "string",
                "description": "ISO-3166 alpha-2 country code (e.g. \"DE\", \"US\", \"MX\"). REQUIRED."
              },
              "occasion": {
                "type": "string",
                "description": "Occasion code. Common values: birthday | christmas | easter | valentines | mothers-day | fathers-day | wedding | anniversary | graduation. Locale-specific occasions are also supported (e.g. einschulung, sinterklaas, midsommar). Call list_supported_occasions for the live list."
              },
              "interests": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Interest/hobby tags used for soft-match scoring (more matches rank higher). Call list_supported_interests for the canonical vocabulary."
              },
              "profession": {
                "type": "string",
                "description": "Recipient profession used as an exact-match filter, e.g. \"teacher\", \"developer\", \"chef\", \"athlete\", \"photographer\", \"gamer\"."
              },
              "favorite_color": {
                "enum": [
                  "red",
                  "blue",
                  "green",
                  "yellow",
                  "purple",
                  "pink",
                  "orange",
                  "black",
                  "white",
                  "gold",
                  "silver"
                ],
                "type": "string",
                "description": "Recipient's favorite color. Only returns gifts that explicitly match this color; color-agnostic gifts are skipped when this filter is set."
              },
              "budget_max_cents": {
                "type": "integer",
                "minimum": 0,
                "description": "Maximum budget in cents of the country currency (e.g. 10000 = 100.00 EUR for DE)."
              },
              "budget_min_cents": {
                "type": "integer",
                "minimum": 0,
                "description": "Minimum budget in cents of the country currency (e.g. 5000 = 50.00 EUR for DE)."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "gifts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "description",
                    "product_url",
                    "price",
                    "price_cents",
                    "currency",
                    "shop",
                    "shop_display_name",
                    "country_code"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Stable UUID of the gift entry."
                    },
                    "shop": {
                      "type": "string",
                      "description": "Marketplace slug (amazon, etsy, mercadolibre, otto, bolcom, allegro, jochenschweizer, jumia)."
                    },
                    "price": {
                      "type": "string",
                      "description": "Price as a decimal string in the country currency (e.g. \"49.99\"). Snapshot from last verification, not live."
                    },
                    "title": {
                      "type": "string",
                      "description": "Product title to display in the chat card."
                    },
                    "category": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Optional product category tag."
                    },
                    "currency": {
                      "type": "string",
                      "description": "ISO-4217 currency code matching the country."
                    },
                    "image_url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Product image URL for the card thumbnail; may be null."
                    },
                    "description": {
                      "type": "string",
                      "description": "Short product description (1–2 sentences)."
                    },
                    "price_cents": {
                      "type": "integer",
                      "description": "Price in minor units of the country currency."
                    },
                    "product_url": {
                      "type": "string",
                      "description": "Full product URL ready to be rendered as a clickable link. Do not strip query parameters."
                    },
                    "why_it_fits": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Reasoning for why this gift suits the supplied filters; may be null."
                    },
                    "country_code": {
                      "type": "string",
                      "description": "ISO-2 country code of the marketplace this entry belongs to."
                    },
                    "favorite_color": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Favorite-color tag this gift matches, or null if color-agnostic."
                    },
                    "shop_display_name": {
                      "type": "string",
                      "description": "Human-readable marketplace name suitable for the card label."
                    }
                  },
                  "description": "A single curated gift entry returned by find_gifts."
                },
                "description": "Ranked list of gift entries matching the filters (may be empty)."
              }
            },
            "required": [
              "gifts"
            ]
          },
          "description_hash": "sha256:5757fc5f3fa1e154735c9cc7a1fd9e223f236c4b5a0c5ebd8b748068d4f85c09"
        },
