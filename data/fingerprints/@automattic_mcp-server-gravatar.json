        {
          "name": "get_avatar_by_id",
          "canonical_hash": "sha256:2cd78441593449b920ce32aeb829f961478d6380e07ed865e15d775f31ba874f",
          "description": "Retrieve the avatar image for a Gravatar profile using an avatar identifier. More efficient when you already have the hashed identifier. <examples>'Get the avatar image for this Gravatar ID' or 'Show me a 150px avatar for user ID abc123...'</examples>",
