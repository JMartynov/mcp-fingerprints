          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "users": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Usernames or profile URLs of public GitHub accounts, up to 100 a run. Clay users: wrap a column in a one item list."
              },
              "list": {
                "type": "string",
                "description": "followers, following, or both (default).",
                "enum": [
                  "both",
                  "followers",
                  "following"
                ]
              },
              "max_results_per_list": {
                "type": "number",
                "description": "Rows to return per list, from 1 to 100000. Default 1000. Each row is charged. Large lists also need a longer run timeout: about 400 rows a minute."
              },
              "github_token": {
                "type": "string",
                "description": "Optional. Your own GitHub token reads through the REST API at up to 5,000 requests an hour, with login, user ID, and avatar only: no name, company, location, or bio. Never stored or logged."
              },
              "max_charge_usd": {
                "type": "string",
                "description": "Optional. The run stops before a charge that would pass this amount. Summary rows are always returned."
              }
            },
