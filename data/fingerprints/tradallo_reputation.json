        {
          "name": "get_track_record",
          "canonical_hash": "sha256:5c226f434ac982808682292c6db52aa61f9790014cdcb365484c69393ef476e6",
          "description": "Fetch a verified trading track record for a Tradallo profile (human) or agent. Returns cryptographically-verified statistics (Sharpe, Sortino, win rate, max drawdown, PnL, trade count, expectancy, profit factor) across all-time and rolling 30/90/365-day windows. Response is a JCS-canonicalized + ed25519-signed envelope.\n\nExamples:\n  - get_track_record({ handle: \"alpha-momentum-v3\" })  // agent (default)\n  - get_track_record({ handle: \"aaronjordan\", principal_type: \"human\" })",
          "is_mutating": false,
          "property_keys": [
            "handle",
            "principal_type"
          ],
          "required_keys": [],
          "parameter_types": {
            "handle": "string",
            "principal_type": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "handle": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,40}$",
                "description": "Tradallo handle (lowercase letters, digits, hyphens, underscores; 1-40 chars)"
              },
              "principal_type": {
                "enum": [
                  "human",
                  "agent"
                ],
                "type": "string",
                "description": "'agent' (default) or 'human' — which namespace to look up the handle in"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean",
                "description": "Set to false on protocol-level errors. Successful envelopes do not include this."
              },
              "data": {
                "description": "The signed payload. Shape depends on the tool — see each tool's description."
              },
              "served_at": {
                "type": "string",
                "description": "ISO-8601 timestamp at which the envelope was signed."
              },
              "signature": {
                "type": "object",
                "required": [
                  "alg",
                  "key_id",
                  "sig"
                ],
                "properties": {
                  "alg": {
                    "type": "string",
                    "description": "Signature algorithm. Always 'ed25519' today."
                  },
                  "sig": {
                    "type": "string",
                    "description": "Base64-encoded ed25519 signature over the JCS-canonicalized envelope."
                  },
                  "key_id": {
                    "type": "string",
                    "description": "Tradallo signing-key ID. Resolve via /.well-known/tradallo-pubkeys.json."
                  }
                },
                "description": "ed25519 signature over the JCS-canonicalized envelope minus this field.",
                "additionalProperties": false
              },
              "schema_version": {
                "type": "string",
                "description": "Envelope schema version. Always '1' today."
              },
              "max_age_seconds": {
                "type": "number",
                "description": "Replay window — clients reject envelopes past served_at + this many seconds."
              }
            },
            "required": [
              "data"
            ]
          },
          "description_hash": "sha256:377dcc224bf5cdefb983dffee7db9c0303cc3dc7fb196583573c98e5cc2c0605",
          "parameters": [
