        },
        {
          "name": "get_photo",
          "canonical_hash": "sha256:4f15f5dd3c6581523b9f9e2b8fc1028d966d3673d11b24ae49966d933cc1a3c8",
          "description": "Retrieves the official portrait photograph of a Member of Parliament. Returns the image as a binary resource that can be displayed or saved. Use this when you need to include a visual representation of an MP in reports, presentations, or profiles.",
