            "style_engine": "string",
            "table_engine": "string",
            "text_engine": "string",
            "postprocess_engine": "string",
            "model_cache_dir": "string",
            "offline": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "pdf_path": {
                "type": "string",
                "description": "Absolute or relative path to the input PDF."
              },
              "output_path": {
                "type": "string",
                "description": "Optional path for the generated HTML file.",
                "default": null
              },
              "title": {
                "type": "string",
                "description": "Optional reader title override.",
                "default": null
              },
              "standalone": {
                "type": "boolean",
                "description": "Keep true to embed images, CSS, and JavaScript in one HTML file.",
                "default": true
              },
              "ocr": {
                "type": "boolean",
                "description": "Try optional OCR fallback for image-only PDFs.",
                "default": false
              },
              "max_pages": {
                "type": "string",
                "description": "Optional limit for very large PDFs.",
                "default": null
              },
              "theme": {
                "type": "string",
                "description": "Reader theme name. The default soft theme is calm and minimal.",
                "default": "soft"
              },
              "style_engine": {
                "type": "string",
                "description": "\"fixed\", \"pdf\", or \"sampling\". Fixed preserves the original soft reader palette. PDF derives a bounded style from local PDF visuals. Sampling asks the host LLM to choose validated style tokens from local PDF style hints.",
                "default": "pdf",
                "enum": [
                  "fixed",
                  "pdf",
                  "sampling"
                ]
              },
              "table_engine": {
                "type": "string",
                "description": "\"auto\", \"pdfplumber\", or \"gmft\". Auto uses gmft when installed.",
                "default": "auto"
              },
              "text_engine": {
                "type": "string",
                "description": "\"char_geometry\" or \"pdfplumber_words\". Defaults to geometry-based spacing.",
                "default": "char_geometry"
              },
              "postprocess_engine": {
                "type": "string",
                "description": "\"none\" or \"sampling\". Sampling asks the host LLM for boundary-only card polish operations, validates exact text preservation, and rewrites the reader.",
                "default": "none",
                "enum": [
                  "none",
                  "sampling"
                ]
              },
              "model_cache_dir": {
                "type": "string",
                "description": "Optional cache directory for local ML table model weights.",
                "default": null
              },
              "offline": {
                "type": "boolean",
                "description": "Use only already-cached optional ML models.",
                "default": false
              }
            },
            "required": [
              "pdf_path"
            ]
          },
          "outputSchema": null,
