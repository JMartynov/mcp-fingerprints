          "name": "convert_pdf_to_card_html",
          "canonical_hash": "sha256:7c9f8dc153f0c236e562c03e1ec045347973befafa226dfaea7a2ccc6c90be18",
          "description": "Convert a local PDF into a portable, source-linked HTML reader.",
          "is_mutating": false,
          "property_keys": [
            "max_pages",
            "model_cache_dir",
            "ocr",
            "offline",
            "output_path",
            "pdf_path",
