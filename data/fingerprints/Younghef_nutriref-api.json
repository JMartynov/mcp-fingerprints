        {
          "name": "nutrition_detail",
          "canonical_hash": "sha256:d7b7157289d2e581a8662f4a1342f925187a635c65c3ad2c0b9e6aae529459bf",
          "description": "Get the full per-100g nutrition profile for one specific food. Use this when you have an `fdc_id` (from nutrition_search) and the user needs micronutrients beyond just calories/protein/carbs/fat. Returns all 13 tracked nutrients: calories, protein, fat, carbs, fiber, sugar, sodium, cholesterol, saturated_fat, vitamin_c, calcium, iron, potassium. Missing nutrients are `null`, not 0. Charges $0.002 USDC per call.",
