        {
          "name": "check_mcp_trust",
          "canonical_hash": "sha256:b68ea64e9dd09c558c212eef5b5603b06cda1509a1bf49dc4df25eaf9f878a93",
          "description": "Get a multi-signal trust score for any MCP server endpoint. Analyzes security (domain reputation, SSL, SPF/DMARC), injection risk (tool description scanning), supply chain safety (toxic skill categories), reliability (uptime, latency, protocol compliance), and on-chain reputation (AgentProof ERC-8004). Returns composite trust score (0-100), tier (platinum/gold/silver/bronze/unranked), and detailed per-signal breakdown. Use this to evaluate whether an MCP server is safe to connect to.",
          "is_mutating": false,
          "property_keys": [
            "endpoint"
          ],
          "required_keys": [
            "endpoint"
          ],
          "parameter_types": {
            "endpoint": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "endpoint": {
                "type": "string",
                "description": "HTTPS URL of the MCP server endpoint to evaluate (e.g. https://example.com/mcp)"
              }
            },
            "required": [
              "endpoint"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:4a81b4c91c9d70cc05c0d0510e25f3636b3e06662095e231d0dac0923ebca983",
          "parameters": [
            {
              "name": "endpoint",
              "type": "string",
              "description": "HTTPS URL of the MCP server endpoint to evaluate (e.g. https://example.com/mcp)",
              "required": true,
              "default": null,
              "enum": null,
              "format": null,
              "items_type": null,
              "nested_properties": null
            }
          ],
          "annotations": {}
        },
        {
          "name": "check_prompt",
          "canonical_hash": "sha256:d10bbcb6266acbedebd95ad50af148b11bd32592252b87981936cf5925fa66ca",
          "description": "Detect prompt injection in text. Analyzes across 4 categories (direct injection, encoding tricks, exfiltration, indirect injection) with 200+ detection patterns. Designed for real-time inline usage before processing untrusted user input. Returns boolean verdict, confidence score (0-1), matched patterns with evidence, and decoded content if encoding obfuscation was detected. Response time <100ms p95.",
          "is_mutating": false,
          "property_keys": [
            "context",
            "prompt"
          ],
          "required_keys": [
            "prompt"
          ],
          "parameter_types": {
            "prompt": "string",
            "context": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "The text to analyze for prompt injection"
              },
              "context": {
                "type": "string",
                "description": "Context hint for sensitivity: user-input (default), skill-prompt (higher tolerance), system-prompt (highest sensitivity)",
                "enum": [
                  "user-input",
                  "skill-prompt",
                  "system-prompt"
                ]
              }
            },
            "required": [
              "prompt"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:ee90da0a4d8cbe3d70b21c043e8a0035b447bf096e5094e1d60f1d12078b1f8b",
          "parameters": [
            {
              "name": "context",
              "type": "string",
              "description": "Context hint for sensitivity: user-input (default), skill-prompt (higher tolerance), system-prompt (highest sensitivity)",
              "required": false,
              "default": null,
              "enum": [
                "user-input",
                "skill-prompt",
                "system-prompt"
              ],
              "format": null,
              "items_type": null,
              "nested_properties": null
            },
            {
              "name": "prompt",
              "type": "string",
              "description": "The text to analyze for prompt injection",
              "required": true,
              "default": null,
              "enum": null,
              "format": null,
              "items_type": null,
              "nested_properties": null
            }
          ],
          "annotations": {}
        },
        {
          "name": "full_scan",
          "canonical_hash": "sha256:0b6e9709632c1645e3e311f6c50611d6787c5454e554ff03b8ba16b9da62da73",
          "description": "Run all security checks on a target (URL, domain, IP, or email). Most comprehensive scan.",
          "is_mutating": false,
          "property_keys": [
            "target"
          ],
          "required_keys": [
            "target"
          ],
          "parameter_types": {
            "target": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "description": "Target to scan — URL, domain, IP address, or email"
              }
            },
            "required": [
              "target"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:c7daa16854209ba13e5af3a19a906571571c855fc63f1d3d81a13c3c6d3b0054",
          "parameters": [
            {
              "name": "target",
              "type": "string",
              "description": "Target to scan — URL, domain, IP address, or email",
              "required": true,
              "default": null,
              "enum": null,
              "format": null,
              "items_type": null,
              "nested_properties": null
            }
          ],
          "annotations": {}
        },
        {
          "name": "scan_skill",
          "canonical_hash": "sha256:af08011d2bd2f3aa1b05b026213e33590d0445e56191f6a302ce8ce408477592",
          "description": "Scan an AI agent skill/plugin for security issues across 8 risk categories (Snyk ToxicSkills taxonomy). Checks for prompt injection, malicious code, suspicious downloads, credential handling, secret detection, third-party content, unverifiable dependencies, and financial access patterns. Static analysis only — no code execution. Returns risk score (0-100), severity-ranked findings with file locations, and human-readable summary.",
          "is_mutating": false,
          "property_keys": [
            "files",
            "skill"
          ],
          "required_keys": [],
          "parameter_types": {
            "skill": "string",
            "files": "object"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "skill": {
                "type": "string",
                "description": "Raw SKILL.md content or skill name from ClawHub"
              },
              "files": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Filename including extension"
                  },
                  "content": {
                    "type": "string",
                    "description": "File content as string"
                  }
                },
                "description": "Additional code files to analyze (max 20 files)"
              }
            },
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:63c14aaf0d9d8c20e8a1639007d51abc9b053e0f01d01d886b9a4568c5ce5aee",
          "parameters": [
            {
              "name": "files",
              "type": "object",
              "description": "Additional code files to analyze (max 20 files)",
              "required": false,
              "default": null,
              "enum": null,
              "format": null,
