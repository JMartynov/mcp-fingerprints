          "inputSchema": {
            "type": "object",
            "properties": {
              "vars": {
                "type": "object",
                "description": "\u041f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u043f\u043e\u0434\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0432 \u0441\u043a\u0440\u0438\u043f\u0442 ({{name}}, {{date}}). \u0412\u0441\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u2014 \u0441\u0442\u0440\u043e\u043a\u0438.",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "phone": {
                "type": "string",
                "pattern": "^\\+?[0-9]{10,15}$",
                "description": "\u041d\u043e\u043c\u0435\u0440 \u0430\u0431\u043e\u043d\u0435\u043d\u0442\u0430 \u0432 E.164 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 (+7XXXXXXXXXX \u0434\u043b\u044f \u0420\u0424)."
              },
              "scenario_id": {
                "type": "string",
                "description": "ID \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u044f \u0431\u043e\u0442\u0430. \u0415\u0441\u043b\u0438 \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d \u2014 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f default-\u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0442\u0435\u043d\u0430\u043d\u0442\u0430."
              },
              "max_duration_s": {
                "type": "integer",
                "default": 300,
                "maximum": 600,
                "minimum": 30,
                "description": "\u041c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0437\u0432\u043e\u043d\u043a\u0430 \u0432 \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0445. M0: \u043f\u0438\u0448\u0435\u0442\u0441\u044f \u0432 \u0411\u0414, \u043d\u0435 enforce'\u0438\u0442\u0441\u044f (\u044d\u0442\u043e M1.1)."
              },
