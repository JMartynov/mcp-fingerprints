        {
          "name": "stexa_get_call_status",
          "canonical_hash": "sha256:69c31c9631f7977b53c80c9626e3f59a563885ff5fd8562e48cde3abbeb4fd3e",
          "description": "\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 MCP-\u0438\u043d\u0438\u0446\u0438\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0437\u0432\u043e\u043d\u043a\u0430. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f polling \u043f\u043e\u0441\u043b\u0435 stexa_call_outbound: status \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442 queued \u2192 ringing \u2192 talking \u2192 completed/failed. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 duration_s \u0438 ended_reason \u0434\u043b\u044f \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u0432.",
