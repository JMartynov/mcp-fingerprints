          "name": "hasdata_glassdoor_job_getJobDetails",
          "canonical_hash": "sha256:3cf7968c939684371496e67e9b7bece06e9fbea5f93e9669a2ed780b663d33f2",
          "description": "Get GlassDoor Job Details\n\nFetches a Glassdoor job posting by its vacancy URL. Returns job title, company name and rating, location, salary estimate, posted date, full job description, and qualifications/benefits. Use for ATS ingestion, job aggregators, comp benchmarking, enrichment of company profiles, and feeding descriptions into LLM matching or resume-tailoring pipelines.",
          "is_mutating": false,
          "property_keys": [
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "url": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "The URL of the job vacancy to retrieve details for."
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:f7b0198a6fdf6ff3643b9b1304d5774c65b1d51f2da155c449f02a49ace131a6",
          "parameters": [
            {
              "name": "url",
              "type": "string",
              "description": "The URL of the job vacancy to retrieve details for.",
              "required": false,
              "default": null,
              "enum": null,
              "format": null,
              "items_type": null,
              "nested_properties": null
            }
          ],
          "annotations": {}
        },
        {
          "name": "hasdata_glassdoor_listing_getJobListings",
          "canonical_hash": "sha256:19f41495975db268bf3b9a09f92710c9b33e9fd47bb203e9ba97ecc254df58a0",
          "description": "Get GlassDoor Job Listings\n\nSearches Glassdoor job listings by keyword and location with sort (recent/relevant), domain targeting, filters (date posted, distance, salary range, company rating, easy apply, remote), and nextPageToken pagination that keeps the filters. Returns an array of jobs with title, company, location, salary estimate, posted date, job URL, and jobId, plus per-page tokens. Use to build job feeds, monitor hiring trends for roles/companies/regions, power candidate sourcing tools, and collect URLs for downstream full-detail scraping via the Glassdoor Job endpoint.",
          "is_mutating": false,
          "property_keys": [
            "datePosted",
            "domain",
            "easyApplyOnly",
            "keyword",
            "location",
            "maxSalary",
            "minRating",
            "minSalary",
            "nextPageToken",
            "radius",
            "remoteOnly",
            "sort"
          ],
          "required_keys": [],
          "parameter_types": {
            "sort": "string",
            "domain": "string",
            "radius": "number",
            "keyword": "string",
            "location": "string",
            "maxSalary": "number",
            "minRating": "number",
            "minSalary": "number",
            "datePosted": "number",
            "remoteOnly": "boolean",
            "easyApplyOnly": "boolean",
            "nextPageToken": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "sort": {
                "enum": [
                  "recent",
                  "relevant"
                ],
                "type": "string",
                "description": "The sorting option for the search results."
              },
              "domain": {
                "enum": [
                  "www.glassdoor.com.ar",
                  "www.glassdoor.com.au",
                  "www.glassdoor.at",
                  "nl.glassdoor.be",
                  "fr.glassdoor.be",
                  "www.glassdoor.com.br",
                  "www.glassdoor.ca",
                  "fr.glassdoor.ca",
                  "www.glassdoor.fr",
                  "www.glassdoor.de",
                  "www.glassdoor.com.hk",
                  "www.glassdoor.co.in",
                  "www.glassdoor.ie",
                  "www.glassdoor.it",
                  "www.glassdoor.com.mx",
                  "www.glassdoor.nl",
                  "www.glassdoor.co.nz",
                  "www.glassdoor.sg",
                  "www.glassdoor.es",
                  "de.glassdoor.ch",
                  "fr.glassdoor.ch",
                  "www.glassdoor.co.uk"
                ],
                "type": "string",
                "description": "The domain of the Glassdoor site (optional)."
              },
              "radius": {
                "enum": [
                  0,
                  5,
                  10,
                  15,
                  25,
                  50,
                  100
                ],
                "type": "number",
                "description": "Search radius around the location, in miles. `0` keeps only jobs in the location itself. Glassdoor uses 25 miles when this is not set."
              },
              "keyword": {
                "type": "string",
                "description": "The keyword used to search for job listings."
              },
              "location": {
                "type": "string",
                "description": "The location to search for job listings."
              },
              "maxSalary": {
                "type": "number",
                "description": "Upper bound of the yearly pay range, must be greater than `minSalary`. Can be used on its own."
              },
              "minRating": {
                "enum": [
                  1,
                  2,
                  3,
                  4
                ],
                "type": "number",
                "description": "Returns jobs from companies rated at least this high. Glassdoor applies the filter approximately, so a few companies rated slightly below the value can appear."
              },
              "minSalary": {
                "type": "number",
                "description": "Lower bound of the yearly pay range. A job is kept when its estimated pay range overlaps the requested one; hourly and monthly pay are converted to yearly. Jobs without a pay estimate are excluded when a salary filter is set."
              },
              "datePosted": {
                "enum": [
                  1,
                  3,
                  7,
                  14,
                  30
                ],
                "type": "number",
                "description": "Returns only jobs posted within the given number of days."
              },
              "remoteOnly": {
                "type": "boolean",
                "description": "Returns only remote jobs. Defaults to false."
              },
              "easyApplyOnly": {
                "type": "boolean",
                "description": "Returns only jobs that can be applied to directly on Glassdoor. Defaults to false."
              },
              "nextPageToken": {
                "type": "string",
                "description": "Token for fetching the next page of jobs, taken from the pagination of a previous response. The token keeps the filters of the search it came from, so they do not need to be sent again."
              }
            }
          },
          "outputSchema": null,
