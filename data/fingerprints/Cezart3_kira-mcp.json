                "description": "Keep only these parking statuses, e.g. ['included'] or ['included', 'likely_included'].",
                "default": null
              },
              "owner_only": {
                "type": "boolean",
                "description": "Only ads posted by private owners (no agency). Only storia reports this; other sites' ads are then excluded.",
