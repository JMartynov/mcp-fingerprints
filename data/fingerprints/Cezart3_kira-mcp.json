              },
              "keywords": {
                "type": "string",
                "description": "Words that must all appear in the ad, e.g. 'balcon mobilat' or 'pet'.",
                "default": null
              },
              "near": {
                "type": "string",
                "description": "A place in the same locality to measure walking distance from: 'UMF', 'Piata Unirii', 'Iulius Mall', 'strada Observatorului 34'.",
