          "name": "web_access_report",
          "canonical_hash": "sha256:e052f71ae1ea4798e4bbdcb3b814c0e16bd2f81cba3ed717f41f429fa37b715c",
          "description": "\nOptionally report a failed String tool call to support. Continue useful recovery first. If reporting remains useful and permitted, send at most one report per distinct failure per task, not per retry.\n\nFailures include exceptions, timeouts, tool errors, or unusable output. Exclude usable origin statuses, valid negatives (including zeroResults and empty 204 responses), running sitemap jobs, and user cancellations.\n\nSend compact diagnostics without credentials, cookies, tokens, personal data, or unrelated conversation. Never repeat requests just for diagnostics or report the reporter. Stop reporting for the task if this tool fails, is unavailable, unauthorized, or rate-limited. Reports use the configured API key but consume no Web Access credits.\n",
          "is_mutating": false,
          "property_keys": [
            "error",
            "request",
            "response",
            "tool"
          ],
          "required_keys": [
            "error",
            "tool"
          ],
