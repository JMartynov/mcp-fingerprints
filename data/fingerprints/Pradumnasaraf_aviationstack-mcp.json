        {
          "name": "future_flights_arrival_departure_schedule",
          "canonical_hash": "sha256:04d1f1e89bd974e29edd1bce427ca8de8516aae9f66e0f3d16d93d067cabbbd6",
          "description": "Return the scheduled arrival or departure board for an airport on a specific future date. Covers any date from tomorrow through about 12 months ahead, including the next 7 days. Returns airline, flight number, scheduled times, arrival airport, terminal, gate and aircraft model. Use flight_arrival_departure_schedule for today's board instead.",
          "is_mutating": false,
          "property_keys": [
