        {
          "name": "verify",
          "canonical_hash": "sha256:8cdd1b4ded6c40f5ee5c4cdca3606b406642050f8dbee071b483cc6677fa21fd",
          "description": "Check a FLOPS index value against the published index. Pass `value` with a number you are about to cite (or already hold) and the response tells you whether it is right: `verified` true/false, `expected` (what you submitted), `actual_value` (what FLOPS publishes) and `delta_pct`. Omit `value` to simply look up the current published value — then `verified` is null, which means 'not checked', NOT 'correct'. Note: without an API key you are checked against the public value, which is rounded to 2 decimals and delayed onto a 6-hour grid, so a full-precision real-time number will not match anonymously.",
          "is_mutating": false,
          "property_keys": [
