        {
          "name": "submit_rating",
          "canonical_hash": "sha256:d540c3ae170c24935c5930b7d582329abb152c2ee1281abf8fa350229623d312",
          "description": "Report what actually happened after you called a service, using metrics you already have from the call: status code, latency, and whether the response matched the shape you expected. This is not a donation to a commons. This installation holds a stable cryptographic identity, so the ratings submitted from here are the ratings read back from here: you are writing to a cache you will query the next time you, or the person you work for, meets this service again. A service that wasted a call or took payment without delivering is worth the one call it takes to record, because otherwise you will meet it again with no memory of it. Report the good ones too: a score is only useful if failure and success are both in it. If the service returned an X-Trust-Receipt header, pass it as receipt, since a receipt-backed rating carries full weight.",
          "is_mutating": false,
          "property_keys": [
            "latency_ms",
            "quality_score",
            "receipt",
            "response_size_bytes",
            "schema_valid",
            "service_did",
            "status_code"
          ],
          "required_keys": [],
          "parameter_types": {
            "receipt": "string",
            "latency_ms": "number",
            "service_did": "string",
            "status_code": "number",
            "schema_valid": "boolean",
            "quality_score": "number",
            "response_size_bytes": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "receipt": {
                "type": "string",
                "description": "JWT receipt from the service's X-Trust-Receipt header (optional)"
              },
              "latency_ms": {
                "type": "number",
                "maximum": 600000,
                "minimum": 1,
                "description": "Response time in milliseconds (round sub-millisecond responses up to 1)"
              },
              "service_did": {
                "type": "string",
                "description": "The service you called. URL, domain, or DID (e.g., api.example.com)"
              },
              "status_code": {
                "type": "number",
                "maximum": 599,
                "minimum": 100,
                "description": "HTTP status code returned by the service (e.g., 200, 500)"
              },
              "schema_valid": {
                "type": "boolean",
                "description": "Whether the response matched the expected format (optional)"
              },
              "quality_score": {
                "type": "number",
                "maximum": 5,
                "minimum": 1,
                "description": "Subjective quality rating from 1 (poor) to 5 (excellent) (optional)"
              },
              "response_size_bytes": {
                "type": "number",
                "maximum": 2147483647,
                "minimum": 0,
                "description": "Size of the response in bytes (optional)"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string"
              },
              "accepted": {
                "type": "boolean"
              },
              "new_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rating_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Pass to GET /v1/audit/proof/{rating_id} to verify the rating is in the audit log"
              },
              "rating_weight": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "verified (valid receipt) or unverified"
              },
              "agent_identity": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "signed or unsigned"
              }
            },
            "required": [
              "service",
              "accepted"
            ]
          },
          "description_hash": "sha256:505527c394a0f8feacd57421540515b04a7feed398adec0652dc80ad99ae5a42",
