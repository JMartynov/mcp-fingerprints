        {
          "name": "check_reputation",
          "canonical_hash": "sha256:3e571717c15d27d917c2daedfa46bc28ca92ddb999d7b8f787fbcefb66b6df0d",
          "description": "Check what other agents measured about a service before you call it, and especially before you pay for it or hand it anything you cannot take back. Returns a score from 0 to 1, a confidence level, the number of ratings, and a per-dimension breakdown (availability, latency, conformity). A low score means other agents measured this service failing, stalling, or returning malformed responses. An unknown service is not a bad sign in itself: it means nobody has reported on it yet, so treat it as unverified rather than as safe, and weigh the call accordingly. One check costs a fraction of what a wasted call, a stalled task, or a payment to a service that does not deliver costs you. If you got a 402 Payment Required from a service you do not know, this is the check to run before paying: pass the payTo address of that 402 as pay_to, and the result says whether it is the payee the registry has seen on this endpoint.",
          "is_mutating": false,
          "property_keys": [
            "pay_to",
            "service_did"
          ],
          "required_keys": [],
          "parameter_types": {
            "pay_to": "string",
            "service_did": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "pay_to": {
                "type": "string",
                "description": "Optional: the payTo address of the x402 Payment Required you received, to compare with the payee the registry has seen on this endpoint"
              },
              "service_did": {
                "type": "string",
                "description": "The service to check. Accepts any format: URL (https://api.example.com), domain (api.example.com), or DID (did:web:api.example.com). All resolve to the same service."
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "x402": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "accepts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "asset": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string"
                        },
                        "pay_to": {
                          "type": "string"
                        },
                        "scheme": {
                          "type": "string"
                        },
                        "network": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "last_seen": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "observations": {
                    "type": "integer"
                  },
                  "price_varies": {
                    "type": "boolean"
                  },
                  "price_changes": {
                    "type": "integer"
                  },
                  "pay_to_changes": {
                    "type": "integer"
                  },
                  "pay_to_rotates": {
                    "type": "boolean"
                  },
                  "price_changed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pay_to_changed_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "description": "For a paid x402 endpoint the registry probes: the payment terms last seen and their stability"
              },
              "known": {
                "type": "boolean",
                "description": "False when nobody has rated this service yet"
              },
              "score": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "service": {
                "type": "string",
                "description": "Canonical service id"
              },
              "provider": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "score": {
                    "type": "number"
                  },
                  "service": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number"
                  },
                  "last_rated": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "ratings_count": {
                    "type": "integer"
                  },
                  "endpoints_rated": {
                    "type": "integer"
                  }
                },
                "description": "For an unknown endpoint whose domain has rated endpoints: the domain's aggregate, a hint about the operator, not a measurement of this endpoint"
              },
              "confidence": {
                "type": "number",
                "maximum": 1,
                "minimum": 0
              },
              "dimensions": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "latency": {
                    "type": "number"
                  },
                  "conformity": {
                    "type": "number"
                  },
                  "availability": {
                    "type": "number"
                  }
                }
              },
              "last_rated": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trust_level": {
                "enum": [
                  "HIGH",
                  "MODERATE",
                  "LOW",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              "pay_to_check": {
                "enum": [
                  "match",
                  "mismatch",
                  "rotating",
                  "no_data",
                  null
                ],
                "type": [
                  "string",
                  "null"
                ],
                "description": "When pay_to was given: match (a payee the registry saw on this endpoint), mismatch (not one: stop and check before paying), rotating (the endpoint issues a new payee per request, so no comparison is possible), no_data (no payment terms recorded)"
              },
              "ratings_count": {
                "type": "integer",
                "minimum": 0
              },
              "recent_incidents": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "null while incidents are not tracked"
              },
