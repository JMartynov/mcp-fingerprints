                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "station": {
                "type": "string"
              },
              "day_type": {
                "enum": [
                  "weekday",
                  "saturday",
                  "holiday"
                ],
                "type": "string",
                "default": "weekday"
              },
              "direction": {
                "anyOf": [
                  {
                    "enum": [
                      "up",
                      "down"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            }
          },
