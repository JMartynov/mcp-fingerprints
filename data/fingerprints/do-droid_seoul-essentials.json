          "name": "find_nearby",
          "canonical_hash": "sha256:ca84ba4dd921f5554e6d2c2c12b240c3a7d77e823269ee7dd0860801407a026d",
          "description": "Find public facilities near GPS coordinates in Seoul, sorted by distance.\n\nArgs:\n    lat: Latitude of the search center point (Seoul range: ~37.4 to ~37.7).\n    lng: Longitude of the search center point (Seoul range: ~126.7 to ~127.2).\n    radius_m: Search radius in meters (100-5000, default 500).\n    type: Optional filter by facility type — \"toilet\", \"pharmacy\", \"wifi\", \"aed\", or \"tourist_info\".\n    limit: Maximum number of results to return (1-20, default 5).\n\nReturns:\n    A list of nearby places sorted by distance, with distance_m field indicating meters from the search point.",
          "is_mutating": false,
          "property_keys": [
            "lat",
            "limit",
            "lng",
            "radius_m",
            "type"
          ],
          "required_keys": [],
          "parameter_types": {
            "lat": "number",
            "lng": "number",
            "limit": "integer",
            "radius_m": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "type": {
                "anyOf": [
                  {
                    "enum": [
                      "toilet",
                      "pharmacy",
                      "wifi",
                      "aed",
                      "tourist_info"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "limit": {
                "type": "integer",
                "default": 5
              },
              "radius_m": {
                "type": "integer",
                "default": 500
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "result": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "result"
            ]
          },
          "description_hash": "sha256:1f2582db1d0275ea0ab4e24c716e1bbf505033cca2e69f46cffd3cdb8f059b4c"
        },
        {
          "name": "find_places",
          "canonical_hash": "sha256:327c1d49d64c68466a54fd0c5bd73f41a8b35a14427de9935f575d2e36e1f655",
          "description": "Search for public facilities in Seoul (restrooms, pharmacies, WiFi hotspots, AED locations, tourist info centers).\n\nArgs:\n    type: Type of facility — \"toilet\", \"pharmacy\", \"wifi\", \"aed\", or \"tourist_info\".\n    district: Seoul district name in English or Korean (e.g., \"gangnam\", \"jongno\", \"강남구\", \"종로구\").\n    filters: Service-specific filters as key-value pairs. Examples: {\"english\": true} for pharmacies with English support, {\"is_24h\": true} for 24-hour restrooms, {\"indoor\": true} for indoor WiFi.\n    limit: Maximum number of results to return (1-50, default 10).\n\nReturns:\n    A list of matching places with location, services, and hours information.",
          "is_mutating": false,
          "property_keys": [
            "district",
            "filters",
            "limit",
            "type"
          ],
          "required_keys": [],
          "parameter_types": {
            "type": "string",
            "limit": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "toilet",
                  "pharmacy",
                  "wifi",
                  "aed",
                  "tourist_info"
                ],
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "default": 10
              },
              "filters": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "district": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "result": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "result"
            ]
          },
          "description_hash": "sha256:c707fa09905120a53d35f2d4840e21fedbdbf3ba529a7027b127593082c1c558"
        },
        {
          "name": "get_place_detail",
          "canonical_hash": "sha256:edeaca6773908ba84ecafdc5ade1f09d3633b9ac505605f6aeddcabb21609da0",
          "description": "Get full details of a specific place or subway station in Seoul by its ID.\n\nArgs:\n    id: The unique place ID (e.g., \"toilet_00001\", \"pharmacy_001\", \"wifi_00001\", \"aed_00001\", \"tourist_info_01\").\n\nReturns:\n    Complete place information including location, services, hours, and accessibility, or an error message if not found.",
          "is_mutating": false,
          "property_keys": [
            "id"
          ],
          "required_keys": [],
