          "description_hash": "sha256:b9064a1aa32053f678784940a9cce9f391f294c38d823c95a1ffff47de45b000"
        },
        {
          "name": "get_subway_timetable",
          "canonical_hash": "sha256:e36d0d4497c18d9e7c6157a52cc4f4a289f72441fb8e52e4a5125b75d3fe0440",
          "description": "Get Seoul subway timetable for a specific station.\n\nArgs:\n    station: Station name in Korean or English (e.g., \"강남\" or \"Gangnam\", \"서울역\" or \"Seoul Station\").\n    line: Line number (e.g., \"1\", \"2\", \"3\"). If omitted for transfer stations, returns all lines.\n    day_type: Schedule type — \"weekday\", \"saturday\", or \"holiday\" (default: \"weekday\").\n    direction: Train direction — \"up\" (toward city center) or \"down\" (away from center). If omitted, returns both.\n\nReturns:\n    Timetable data with departure times, destinations, and transfer line info, or an error message if station not found.",
          "is_mutating": false,
          "property_keys": [
            "day_type",
            "direction",
            "line",
            "station"
          ],
          "required_keys": [],
          "parameter_types": {
