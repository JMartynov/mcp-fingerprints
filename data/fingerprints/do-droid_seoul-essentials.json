                "type": "string"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "result": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "result"
            ]
