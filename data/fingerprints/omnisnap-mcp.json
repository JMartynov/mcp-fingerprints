        {
          "name": "collect_selectors",
          "canonical_hash": "sha256:829dd2b2999a299a92d8011c8704c3af641e70e3bb65a42670578c892d728382",
          "description": "Given a description or a CSS hint, returns every selector that could reach the element, ranked by how likely it is to survive a redeploy and checked against the live page so you know whether it matches one element or several. Prefer the top result. A selector built on a generated class such as css-1x2y3z is scored down because it changes whenever the bundler runs.",
          "is_mutating": false,
