        {
          "name": "audit_page",
          "canonical_hash": "sha256:3b422f6dd6d55168791687c47ad1c66b8c2aa0a83043dfec4dafd1346527faa9",
          "description": "Audits the live page for defects that exist only once it has rendered, and that reading the source cannot find: a control with something painted over it, text cut off by its own container, a page that scrolls sideways, a webfont that never arrived, images with no reserved space, and text too small to read. Use it after a layout change, at a width you do not normally look at, or when a user says a button",
