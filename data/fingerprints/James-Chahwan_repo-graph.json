                "type": "string"
              },
              "context_lines": {
                "type": "string"
              },
              "budget": {
                "type": "string"
              }
            },
            "required": [
              "node"
            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:d0179d47b6ea18e43889cd8ac2d8909e383ffdf30a4a4a9576989ecd71a91a91"
        },
        {
          "name": "refresh",
          "canonical_hash": "sha256:0f7d80f9678e79a1e14594b910e0b7f10b71989fb2f3db2833a6341cd0ff5fc4",
          "description": "(Re)build the structural graph with tree-sitter AST parsing across 20 languages, running the cross-stack resolvers (HTTP, gRPC, GraphQL, WebSocket, queues, events, CLI). Incremental by default — only changed files re-parse — so it's cheap to call after edits; set `full=true` to force a clean reparse. Accepts a local path or a git URL (cloned on demand). Call after a major refactor; routine edits are picked up automatically by the file watcher.",
          "is_mutating": false,
