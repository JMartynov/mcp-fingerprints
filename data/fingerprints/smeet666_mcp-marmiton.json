          "description": "Read one recipe, optionally rescaled to a number of servings.",
          "is_mutating": false,
          "property_keys": [
            "id",
            "servings",
            "url"
          ],
          "required_keys": [],
          "parameter_types": {
            "id": "string",
            "url": "string",
            "servings": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Marmiton recipe id, as returned by search_recipes. Preferred over 'url'."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Full marmiton.org recipe URL. Only marmiton.org is accepted. Ignored when 'id' is given."
