          "name": "convert_image_to_svg",
          "canonical_hash": "sha256:5cc762b90ac444aa48ef37e2f3c3afa8b77811e42e1cf8905d05429e8f31eb77",
          "description": "Convert a raster image (PNG, JPG, or WEBP) to SVG vector format.",
          "is_mutating": false,
          "property_keys": [
            "color_precision",
            "colormode",
            "corner_threshold",
            "filter_speckle",
