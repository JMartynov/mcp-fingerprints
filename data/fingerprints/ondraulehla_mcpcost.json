        {
          "name": "measure_server",
          "description": "Measures one MCP server now: connects to a remote URL, or starts a local command and stops it after tools/list, then reports the result, the protocol version, the tool count and the context-token cost of the tool definitions (o200k_base estimate; the exact Claude count when ANTHROPIC_API_KEY is set). Use it for a server that is not in the official registry, or for a local command; for a registry server prefer lookup_server, which answers from the daily board without a connection. Sends no credentials: a server that needs them comes back with status",
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "window": {
                "type": "integer"
              },
              "target": {
                "type": "string"
              }
            },
            "required": []
          },
          "canonical_hash": "sha256:f45c2dee1c596828f8f357c8dee4885e406d50c1b0cf62bd41d766716f2c8b9d"
        },
        {
          "name": "measure_config",
          "description": "Measures every server in one MCP config file (.mcp.json, Claude Desktop, Cursor, VS Code or Windsurf format): starts each local server the way the client would and stops it after tools/list, connects to each remote one, and reports the tokens per server and the total. Use it to see what a whole config costs the context window; use measure_server for one server. A server that fails to start or needs credentials is reported with its status, never thrown. Up to about 15 s per server.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "window": {
                "type": "integer"
              },
              "noStdio": {
                "type": "boolean"
              },
              "servers": {
                "type": "integer"
              },
