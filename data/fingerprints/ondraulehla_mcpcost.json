        {
          "name": "search_servers",
          "description": "Finds servers on the public board by words in their name, title, description or host, with optional filters, sorted by exact Claude token cost (highest first) by default. With no query and no filter it ranks the whole board, so page 1 is the most expensive servers in the registry and sort=claude-asc the cheapest. Use it to discover servers or to rank them by cost; use lookup_server once you have a name, compare_servers for a few side by side, registry_summary for the totals. Returns up to twenty servers per page with name, host, status, tool count and tokens;",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "sort": {
                "type": "string"
