        {
          "name": "memory_feedback",
          "canonical_hash": "sha256:64c02165b1d60c434584fc88b4a23eabf20ef589369087c3f23faf2f9361dd27",
          "description": "Report feedback on a memory with an outcome (closes the compounding loop — call after actually adopting a memory). Every outcome advances uses and last_used. outcome: 'success' (default, the memory worked), 'failure' (it misled you — confidence drops 0.2, floor 0.05), 'contradiction' (you dispute it — confidence frozen and a review entry is queued pending adjudication), 'obsolete' (it is superseded — archived immediately), 'unknown' (records the event only: confidence does not move). Anything else is rejected. Success raises confidence (+0.1; extra +0.15 when a different agent validates for the first time). agent must be your own source agent id. Memories in a private 'agent-<name>' namespace accept feedback only from the owner (agent = 'agent-<name>' or '<name>'). Archiving is reversed on feedback (except outcome=obsolete, which archives instead).",
          "is_mutating": false,
          "property_keys": [
            "agent",
            "mem_id",
            "outcome"
          ],
          "required_keys": [
