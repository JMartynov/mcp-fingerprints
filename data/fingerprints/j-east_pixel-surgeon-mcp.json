        {
          "name": "trace_to_svg",
          "canonical_hash": "sha256:98e3125905e5aa4a9a9ccc865a067e4192a20ecea532f73274a9d0241f547852",
          "description": "Convert a raster image to SVG using potrace vectorization. Best for line art, diagrams, logos, and high-contrast images. The image must already exist in ${SAVE_DIR} (use save_image to import first).",
          "is_mutating": false,
          "property_keys": [
            "filename",
            "invert",
            "threshold",
            "turdsize"
          ],
          "required_keys": [
            "filename"
          ],
          "parameter_types": {
            "filename": "string",
            "threshold": "string",
            "invert": "string",
            "turdsize": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "description": "Filename of the source image in ${SAVE_DIR}"
              },
              "threshold": {
                "type": "string",
                "description": "Brightness threshold for black/white conversion (0-255). Lower = more black. -1 = auto-detect. Default: auto.",
                "default": -1
              },
