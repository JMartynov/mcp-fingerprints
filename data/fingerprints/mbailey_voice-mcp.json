        {
          "name": "conch",
          "canonical_hash": "sha256:5af550cfa3239739bd28f41b0743fdc7349b6f660b42d2ef95820b66eb3fad24",
          "description": "Observe and manage the conch (VoiceMode's single-speaker lock) over MCP.",
          "is_mutating": false,
          "property_keys": [
            "action",
            "agent",
            "project_path",
            "session_id",
            "target",
            "timeout",
            "voice"
          ],
          "required_keys": [],
          "parameter_types": {
            "action": "string",
            "session_id": "string",
            "target": "string",
            "agent": "string",
            "project_path": "string",
            "voice": "string",
            "timeout": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "description": "One of ``status | wait | queue | heartbeat | leave | give | bump | release`` (default ``status``). • ``status`` — return the current holder and the ordered waiter queue. No ``session_id`` needed. • ``queue`` — **recommended for joining when busy.** Register and return immediately with your position; you discover your grant by heartbeating or polling ``status`` (register-and-**poll**). Stays registered. • ``wait`` — register and block until it's your turn, bounded by ``min(timeout, VOICEMODE_CONCH_MCP_WAIT_CAP)`` (default cap 25 s). On success the conch is free for you — call ``converse()`` next. On timeout you are deregistered. • ``heartbeat`` — refresh your remote-liveness TTL while idle (keeps your place). Send ~every 30 s while queued, and check the response's ``granted`` field every time — that is how a queued waiter discovers its grant. • ``leave`` — deregister (give up your place). • ``give`` — hand the floor to a waiting ``target`` (resolved by session-id or agent name); it acquires when the holder releases. • ``bump`` — drop the current holder and promote the head of the queue. (Use ``release`` for a stale lock with no live holder.) • ``release`` — force-clear a stale/stuck holder lock and any grant. *(``\"callback\"`` was renamed to ``\"queue\"`` — VM-2078. The literal string still resolves, but only to a clear error naming the replacement; it is not a valid action any more.)*",
                "default": "status"
              },
              "session_id": {
                "type": "string",
                "description": "REQUIRED for ``wait``/``queue``/``heartbeat``/``leave`` — the remote agent's stable queue/grant key.",
                "default": null
              },
              "target": {
                "type": "string",
                "description": "REQUIRED for ``give`` — the waiting session id or agent name to hand the floor to. agent / project_path / voice: descriptive fields stored on your waiter entry (shown in ``status``), mirroring the holder payload.",
                "default": null
              },
              "agent": {
                "type": "string",
                "default": null
              },
              "project_path": {
                "type": "string",
                "default": null
              },
              "voice": {
                "type": "string",
                "default": null
              },
              "timeout": {
                "type": "number",
                "description": "``wait`` only — desired max seconds to block; still hard-capped by ``VOICEMODE_CONCH_MCP_WAIT_CAP``.",
                "default": null
              }
            },
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:7e4f9fb94f5bcf45421232ee6fe93711de52674f7d22de26e62b19433faab27e",
          "parameters": [
            {
              "name": "action",
              "type": "string",
              "description": "One of ``status | wait | queue | heartbeat | leave | give | bump | release`` (default ``status``). • ``status`` — return the current holder and the ordered waiter queue. No ``session_id`` needed. • ``queue`` — **recommended for joining when busy.** Register and return immediately with your position; you discover your grant by heartbeating or polling ``status`` (register-and-**poll**). Stays registered. • ``wait`` — register and block until it's your turn, bounded by ``min(timeout, VOICEMODE_CONCH_MCP_WAIT_CAP)`` (default cap 25 s). On success the conch is free for you — call ``converse()`` next. On timeout you are deregistered. • ``heartbeat`` — refresh your remote-liveness TTL while idle (keeps your place). Send ~every 30 s while queued, and check the response's ``granted`` field every time — that is how a queued waiter discovers its grant. • ``leave`` — deregister (give up your place). • ``give`` — hand the floor to a waiting ``target`` (resolved by session-id or agent name); it acquires when the holder releases. • ``bump`` — drop the current holder and promote the head of the queue. (Use ``release`` for a stale lock with no live holder.) • ``release`` — force-clear a stale/stuck holder lock and any grant. *(``\"callback\"`` was renamed to ``\"queue\"`` — VM-2078. The literal string still resolves, but only to a clear error naming the replacement; it is not a valid action any more.)*",
              "required": false,
