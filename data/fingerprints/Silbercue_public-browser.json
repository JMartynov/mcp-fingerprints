                "type": "boolean",
                "default": true,
                "description": "Whether to await Promise results"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:00cb5c6bbf1ffc9bbdc3d5985f3ee4158c1602a5176def7525b603ae3db7ea52"
