        {
          "name": "set_page_data",
          "canonical_hash": "sha256:3990544c10ca8f0c5edbc5f7f5e96356ce3c64ebab6722740279cd6aaf890bab",
          "description": "Write a payload larger than 1 MB into window.__pb_data[key], chunked past the CDP 1 MB message limit. Source: inline (`data`) or file (absolute `path`, read as binary). The page reads window.__pb_data[key] (string or ArrayBuffer per encoding) and window.__pb_data[key + '__complete'] === true. Never write one key from parallel calls — they race. Under ~200 KB use evaluate; for a real <input type=file> use file_upload.",
          "is_mutating": false,
          "property_keys": [
            "chunkSize",
            "encoding",
            "key",
            "source"
          ],
          "required_keys": [],
          "parameter_types": {
            "key": "string",
            "encoding": "string",
            "chunkSize": "integer"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                "description": "Property name under window.__pb_data (JS identifier, see pattern)"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "type": "string",
                        "description": "Payload string (base64 or utf-8)"
                      },
                      "type": {
                        "type": "string",
                        "const": "inline"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "path"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "description": "Absolute file path"
                      },
                      "type": {
                        "type": "string",
                        "const": "file"
                      }
                    }
                  }
                ],
                "description": "inline: pass data. file: pass an absolute path, read as binary"
              },
              "encoding": {
                "enum": [
                  "base64",
                  "utf8",
                  "binary"
                ],
                "type": "string",
                "description": "utf8 (inline default) keeps a string; binary (file default) gives an ArrayBuffer for FileReader/Blob/fetch; base64 keeps the base64 string"
              },
              "chunkSize": {
                "type": "integer",
                "description": "Raw bytes per chunk before base64 (default 500000; max 700000)",
                "exclusiveMinimum": 0
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:d1f20443f1b20c07523fbaed88caed60498f2c4a627ae12383e2f893d09149f3"
        },
