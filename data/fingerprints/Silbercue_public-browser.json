        {
          "name": "run_plan",
          "canonical_hash": "sha256:62fe9929fcfe9a0b52733874e44ad41fe01967d3a569b4be47348a325746ab32",
          "description": "Batch the next 2+ known actions (click, type, scroll, view_page chains) here instead of N separate calls: a sequence of tool steps, executed server-side in one call. Variables via vars and saveAs ($name), conditions (if), suspend/resume to ask the agent mid-plan, and errorStrategy abort | continue | capture_image.",
          "is_mutating": false,
          "property_keys": [
            "errorStrategy",
            "resume",
            "steps",
            "vars"
          ],
          "required_keys": [],
          "parameter_types": {
            "vars": "object",
            "steps": "array",
            "resume": "object",
            "errorStrategy": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "vars": {
                "type": "object",
                "description": "Initial variables, available as $name",
                "additionalProperties": {}
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "tool"
                  ],
                  "properties": {
                    "if": {
                      "type": "string",
                      "description": "Run the step only if this expression is true, e.g. \"$pageTitle === 'Login'\""
                    },
                    "tool": {
                      "type": "string",
                      "description": "Tool name"
                    },
                    "params": {
                      "type": "object",
                      "description": "Tool parameters; $name substitutes a variable",
                      "additionalProperties": {}
                    },
                    "saveAs": {
                      "type": "string",
                      "description": "Save the result as $name for later steps"
                    },
                    "suspend": {
                      "type": "object",
                      "properties": {
                        "context": {
                          "enum": [
                            "capture_image"
                          ],
                          "type": "string",
                          "description": "capture_image: attach a screenshot"
                        },
                        "question": {
                          "type": "string",
                          "description": "Question for the agent"
                        },
                        "condition": {
                          "type": "string",
                          "description": "Suspend after the step if this $-expression is true"
                        }
                      },
                      "description": "Pause here to ask the agent a question"
                    }
                  }
                },
                "description": "Tool steps to run in order"
              },
              "resume": {
                "type": "object",
                "required": [
                  "planId",
                  "answer"
                ],
                "properties": {
                  "answer": {
                    "type": "string",
                    "description": "Answer to the suspend question"
                  },
                  "planId": {
                    "type": "string",
                    "description": "ID of the suspended plan"
                  }
                },
                "description": "Resume a suspended plan"
              },
              "errorStrategy": {
                "enum": [
                  "abort",
                  "continue",
                  "capture_image"
                ],
                "type": "string",
                "default": "abort",
                "description": "abort stops at the first error; continue runs all steps; capture_image screenshots, then aborts"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:887932986959a2117762431c60f71fd07dd4a50e5d86a748911a140180776058"
        },
        {
