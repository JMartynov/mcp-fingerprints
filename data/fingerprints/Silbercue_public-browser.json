                "description": "Substring of document.body.innerText, case-sensitive; required for condition 'text'"
              },
              "assert": {
                "type": "boolean",
                "default": false,
                "description": "Check once, fail if it does not hold; timeout 0, _meta.code 'assertion_failed'"
              },
              "timeout": {
                "type": "number",
