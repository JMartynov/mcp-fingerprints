            "timeout": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "status",
                  "list"
                ],
                "type": "string",
                "default": "status",
                "description": "status waits for pending downloads; list: history, never waits (use for polling)"
              },
              "settle": {
                "type": "number",
                "default": 250,
                "description": "Ms to wait for a download to START before reporting none — Chrome fires downloadWillBegin a few ms after the click; 0 = instant"
              },
              "timeout": {
                "type": "number",
                "default": 30000,
                "description": "Max wait in ms for pending downloads"
              }
            }
