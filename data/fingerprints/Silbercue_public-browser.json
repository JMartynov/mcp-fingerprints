        {
          "name": "observe",
          "canonical_hash": "sha256:e9e23904b2f320c6a57d34883b311a4784a906c4ecbfaa99de82b8526dd50550",
          "description": "Watch an element for changes instead of polling with MutationObserver/setInterval code in evaluate. collect: record text/attribute changes for 'duration' ms. until: wait for a condition, then optionally click at once (then_click). click_first fires the triggering action after the observer is armed, so nothing is missed.",
          "is_mutating": false,
          "property_keys": [
            "click_first",
            "collect",
            "duration",
            "interval",
            "selector",
            "then_click",
            "timeout",
            "until"
          ],
          "required_keys": [],
          "parameter_types": {
            "until": "string",
            "collect": "string",
            "timeout": "number",
            "duration": "number",
            "interval": "number",
            "selector": "string",
            "then_click": "string",
            "click_first": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "until": {
                "type": "string",
                "description": "JS expression checked on each change, 'el' is the element, e.g. el.textContent === '8'"
              },
              "collect": {
                "enum": [
                  "text",
                  "attributes",
                  "all"
                ],
                "type": "string",
                "default": "text",
                "description": "text (textContent) | attributes | all"
              },
              "timeout": {
                "type": "number",
                "default": 10000,
                "description": "Max observation time in ms (max 25000)"
              },
              "duration": {
                "type": "number",
                "description": "Collect window in ms (default 5000); exclusive with until"
              },
              "interval": {
                "type": "number",
                "default": 100,
                "description": "Polling fallback interval in ms"
              },
              "selector": {
                "type": "string",
                "description": "CSS selector or ref of the element to observe"
              },
              "then_click": {
                "type": "string",
                "description": "Selector or ref to click immediately when until holds"
              },
              "click_first": {
                "type": "string",
                "description": "Selector or ref to click once the observer is armed"
              }
            }
