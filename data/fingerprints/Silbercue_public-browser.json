        {
          "name": "click",
          "canonical_hash": "sha256:0cef37863c43047d5d997854c7e99abe70ad0d190c2c4f20a0c6b8c5b1dfe487",
          "description": "Click an element by ref, CSS selector, visible text, or viewport x/y (canvas, pixel-precise targets). Dispatches real CDP mouse events. A click that opens a new tab is reported in the response. The DOM diff (NEW/REMOVED/CHANGED) arrives with the next page action, or here with wait_for_diff: true.",
          "is_mutating": false,
          "property_keys": [
            "ref",
            "selector",
            "text",
            "wait_for_diff",
            "x",
            "y"
          ],
          "required_keys": [],
          "parameter_types": {
            "x": "number",
            "y": "number",
            "ref": "string",
            "text": "string",
            "selector": "string",
            "wait_for_diff": "boolean"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Viewport X in px; with y, not ref/selector"
              },
              "y": {
                "type": "number",
                "description": "Viewport Y in px; use with x"
              },
              "ref": {
                "type": "string",
                "description": "Element ref (preferred)"
              },
              "text": {
                "type": "string",
                "description": "Visible text (a11y name); no view_page needed, prefers interactive"
              },
              "selector": {
                "type": "string",
                "description": "CSS selector (fallback)"
              },
              "wait_for_diff": {
                "type": "boolean",
                "description": "Wait for the DOM diff before returning (default false, slower)"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:32d441217fe5e2f6fff3344ac4e1298f3d3ac5ae903e966f2349f446395644bf"
        },
