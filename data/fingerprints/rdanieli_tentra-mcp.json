                },
                "description": "FULL replacement services array — include everything that should remain (not a patch). Omit to leave the services list untouched."
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "FULL replacement connections array — same replace-not-merge semantics as services. Omit to leave connections untouched."
              }
            },
            "required": [
