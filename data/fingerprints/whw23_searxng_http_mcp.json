              "query": {
                "type": "string",
                "description": "The search query to use"
              },
              "categories": {
                "type": "string",
                "description": "Comma-separated category names to focus on (e.g., 'general,news,science'). Prefer this over 'engines' to narrow results — categories leverage multiple engines automatically. Call engine_info to discover available categories.",
                "default": ""
              },
              "engines": {
                "type": "string",
                "description": "Comma-separated engine names to use (e.g., 'google,arxiv,wikipedia'). Only use when you need a specific source; otherwise prefer 'categories'. Overrides category-based engine selection when set.",
                "default": ""
              },
              "language": {
                "type": "string",
                "description": "Search language code (e.g., 'en', 'zh', 'ja', 'de'). Filters results to the specified language. Omit to search all languages.",
                "default": ""
              },
              "time_range": {
                "type": "string",
                "description": "Restrict results to those published within this time window. Omit for no time restriction.",
