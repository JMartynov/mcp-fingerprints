                "type": "string",
                "description": "Safe search level: 0=off, 1=moderate, 2=strict",
                "default": 0
              },
              "pageno": {
                "type": "integer",
                "description": "Starting page number. Use with 'pages' for pagination.",
                "default": 1
              },
              "pages": {
                "type": "integer",
                "description": "Number of pages to fetch in parallel (multi-page fanout). Higher values return more results but increase latency. Use 2-3 for comprehensive research.",
                "default": 1
              },
              "max_results": {
                "type": "integer",
                "description": "Maximum number of results to return. Applied after aggregation across pages.",
                "default": 10
              },
              "format": {
                "type": "string",
                "description": "Result detail level: 'compact' returns title/url/content only, 'full' includes engines/score/category/date/thumbnails",
                "default": "compact"
              }
