                  "se",
                  "ch",
                  "tw",
                  "tr",
                  "gb",
                  "us"
                ],
                "type": "string",
                "description": "The two-letter country code for the country to search from. Combined with `setLang` to form the DuckDuckGo region. Ignored if `kl` is set."
              },
              "kl": {
                "enum": [
                  "ar-es",
                  "au-en",
                  "at-de",
                  "be-nl",
                  "be-fr",
                  "br-pt",
                  "ca-en",
                  "ca-fr",
                  "cl-es",
                  "dk-da",
                  "fi-fi",
                  "fr-fr",
                  "de-de",
                  "hk-tzh",
