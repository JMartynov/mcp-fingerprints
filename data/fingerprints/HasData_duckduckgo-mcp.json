                  "cn-zh",
                  "pl-pl",
                  "ph-en",
                  "ru-ru",
                  "za-en",
                  "es-es",
                  "se-sv",
                  "ch-de",
                  "tw-tzh",
                  "tr-tr",
                  "uk-en",
                  "us-en",
                  "wt-wt"
                ],
                "type": "string",
                "description": "DuckDuckGo region code in `<country>-<language>` form (e.g. `us-en`, `de-de`). Sets country and interface language at once; takes precedence over `cc`/`setLang`. Use `wt-wt` for no region."
              },
              "setLang": {
                "enum": [
                  "ar",
                  "ca",
                  "zh-hans",
                  "zh-hant",
                  "hr",
                  "cs",
                  "da",
                  "nl",
                  "en",
                  "et",
                  "fi",
                  "fr",
