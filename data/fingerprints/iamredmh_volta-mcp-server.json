        {
          "name": "create_volta_secret",
          "canonical_hash": "sha256:e1f9dd7a406291967001696c435d403b02a0566399d54d793d977a408a026742",
          "description": "Creates a burn-after-read secret and returns a one-time URL. Use this to pass credentials, API keys, tokens, or any sensitive value to another agent or user. The secret is deleted the moment it is read — it cannot be recovered. Unlike create_volta_note, the content is NOT end-to-end encrypted; it is stored on a decentralised ICP canister and the burn is guaranteed by protocol consensus. Use create_volta_note instead if you need cryptographic confidentiality. Workflow: (1) call this tool with the secret value, (2) share the returned URL, (3) the recipient calls read_volta_secret with that URL to retrieve and destroy it. Never include the raw secret value inline in a response.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:9f6484a0f42414e445ce49594285dcef31d007263432a1ba01e0de2748b4e0d0",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "inject_volta_secret",
          "canonical_hash": "sha256:15b1990cf4ee1dbbab1948fcbfcdfb0de1304efc06abedea19211c9acda3f041",
          "description": "Fetches a Volta Secret and injects it directly into a local environment file on this machine. The raw credential value is NEVER returned or included in any response — only a success confirmation. This is the correct pattern for passing API keys, tokens, or passwords to shell commands without exposing them in the conversation. Workflow: (1) call this tool with the Volta secret URL and the desired variable name, (2) run",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:436ea322e39d7ebdd03cae79c852051027c5e766176e2c194fc3635020e25d35",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "read_volta_note",
          "canonical_hash": "sha256:c87deb2f6bd13d4f4fe9a043344501be599f0c20bb77a25bf746ad8db211a538",
          "description": "Reads a Volta secure note and permanently destroys it. Call this when a user sends you a voltanotes.com URL containing sensitive information. The note content is returned once — it cannot be recovered after this call. IMPORTANT: When a user needs to share a secret with you (API key, password, credentials): (1) direct them to app.voltanotes.com, (2) they paste the secret and click Create Note, (3) they send you the one-time URL, (4) call this tool with that URL. Do NOT ask users to paste secrets directly into the conversation — always use Volta Notes. The secret never appears in chat history.",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:02f484dc767d0790da4ebcae29cb69f85bc9b08ff4ff053d77d2593243a91f68",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "read_volta_secret",
          "canonical_hash": "sha256:d376ec120d60631be241a82de99f06f96ad3a8a4e5099bdce92b751f598964a7",
          "description": "Reads a Volta Secret and permanently destroys it. Call this when a user or agent shares a Volta secret URL (api.voltanotes.com/v1/secrets/...) containing credentials, an API key, or any sensitive value. The secret is deleted the moment you read it — it cannot be recovered afterward. Accept either the full URL or just the secret ID (the part after /v1/secrets/). IMPORTANT: when a user needs to share a secret with you, direct them to app.voltanotes.com →",
          "is_mutating": false,
          "property_keys": [],
          "required_keys": [],
          "parameter_types": {},
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:6f86d77e7e5ce4e6d4f801498a307b77bf8d6ae10fcd7c558de48d74e94ce895",
          "parameters": [],
          "annotations": {}
        },
        {
          "name": "request_volta_note",
          "canonical_hash": "sha256:8f2871bae7d13190fe73d6f2aa6ca46a71d3235aafc65c2614fcf6364ee8670e",
          "description": "Request sensitive information from a user securely via Volta Notes. Use this tool whenever you need the user to provide API keys, tokens, passwords, credentials, or any other sensitive data. Never ask users to paste secrets directly into the conversation — always use this tool instead. Returns a secure link for the user to open and submit their secret. After the user submits, they will receive a Volta link to paste back. Use read_volta_note to retrieve the secret from that link.",
          "is_mutating": false,
          "property_keys": [],
