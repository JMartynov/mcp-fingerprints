                  "relevance",
                  "rating",
                  "readers",
                  "newest",
                  "oldest"
                ],
                "type": "string",
                "default": "relevance",
                "description": "'rating' is how readers scored it, 'readers' is how many recorded reading it, and both answer a question relevance cannot. 'newest' and 'oldest' rank on 'first_published_year', which the index takes from edition records: read that field on each row against the work's page before repeating it."
              },
              "time": {
                "type": "string",
                "maxLength": 100,
                "minLength": 2,
                "description": "The period the work treats, such as '20th century'."
              },
              "limit": {
