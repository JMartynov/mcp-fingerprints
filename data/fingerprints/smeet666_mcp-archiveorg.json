                "default": 10,
                "maximum": 50,
                "minimum": 1
              },
              "place": {
                "type": "string",
                "maxLength": 100,
                "minLength": 2,
                "description": "Where the work is set, such as 'Shanghai'."
              },
              "query": {
                "type": "string",
                "maxLength": 300,
                "minLength": 2,
                "description": "Title or author, as free text. Optional when a criterion below is given."
              },
              "person": {
