        {
          "name": "browser_screenshot",
          "canonical_hash": "sha256:01ca35c17be5708325fffc0ce6ab84a68df475b191e362e8fa288de20fd9e742",
          "description": "Capture the visible viewport (or a CSS-pixel rect) of a shared tab and return the image so you can look at it. Output is bounded (longest side <= 1600 px, small JPEG). The result also names a local image file: if you cannot see the inline image, open that file with your image viewer (for example view_image) and answer from what you actually see, never from guesses. The screenshot is a short-lived artifact (artifact_id) that expires when sharing ends. Needs the user to have allowed screenshots.",
          "is_mutating": false,
          "property_keys": [
            "browser_instance_id",
            "context_id",
            "format",
            "include_image",
            "local_file",
            "rect",
            "request_id"
          ],
          "required_keys": [
            "browser_instance_id",
            "context_id",
            "request_id"
          ],
          "parameter_types": {
            "context_id": "string",
            "rect": "object",
            "format": "string",
            "include_image": "boolean",
            "local_file": "boolean",
            "request_id": "string",
            "browser_instance_id": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "context_id": {
                "type": "string"
              },
              "rect": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "description": "Page-relative CSS pixels. Omit for the current viewport."
              },
              "format": {
                "type": "string",
                "description": "Default jpeg (smaller). png is lossless but may be too large to show inline.",
                "enum": [
                  "jpeg",
                  "png"
