            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "Detailed description of the technology, product, or service (min 20 chars). Include any country, region, or sector context directly in the description. More detail = better matches."
              }
            },
            "required": [
              "query"
            ]
          },
