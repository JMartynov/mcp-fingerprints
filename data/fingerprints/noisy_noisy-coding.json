            "text": "string",
            "interrupt": "boolean",
            "speaker": "string",
            "agent_id": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "What to say. Plain conversational prose. Mark the key words the listener must catch with markdown bold (**like this**) — they get vocal emphasis and show bold on the live dashboard. Also supports inline speech tags like [pause] or [laugh] and wrapping tags like <soft>text</soft>."
              },
              "interrupt": {
                "type": "boolean",
                "description": "Cut off any utterance currently playing and speak now.",
                "default": false
              },
              "speaker": {
                "type": "string",
                "description": "ONLY for subagents. If you are a subagent (Task/Agent tool), pass your role name here (e.g. \"researcher\") — the dashboard shows the message under that name with its own portrait, and the daemon gives you a stable voice distinct from the main agent's. The main agent must leave this empty.",
                "default": ""
              },
              "agent_id": {
                "type": "string",
                "description": "Integration-supplied conversation identity. Leave unset; the trusted host hook supplies it when required.",
                "default": null
              }
            },
            "required": [
              "text"
            ]
          },
          "outputSchema": null,
