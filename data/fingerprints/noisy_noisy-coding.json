        {
          "name": "speak",
          "canonical_hash": "sha256:c940f9889c61b65c743c8e4255ad6edf10a6831254d94a8699b82131bd6ff2b1",
          "description": "Speak a short message aloud to the user through their speakers.",
          "is_mutating": false,
          "property_keys": [
            "agent_id",
            "interrupt",
            "speaker",
            "text"
          ],
          "required_keys": [
            "text"
