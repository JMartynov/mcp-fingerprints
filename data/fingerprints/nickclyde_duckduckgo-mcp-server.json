        {
          "name": "expand_link",
          "canonical_hash": "sha256:c77db8e97f7c89df1c192bda216ec05c49875c0fdf64e855fee4f1036b135620",
          "description": "Expand a shortened ref://<id> link token from search results back into the full URL. Search results replace very long URLs with short ref:// tokens to save space. fetch_content accepts those tokens directly, so only call this when you need the real URL, for example to show or cite a link to the user. Never present a ref:// token to the user as if it were a URL.",
          "is_mutating": false,
          "property_keys": [
            "token"
          ],
          "required_keys": [
            "token"
          ],
          "parameter_types": {
            "token": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
