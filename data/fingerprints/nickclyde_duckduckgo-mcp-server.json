            ]
          },
          "outputSchema": null,
          "description_hash": "sha256:135920bfa2700b5456484767206c50ba46249574c849f367120a207023ea3224"
        },
        {
          "name": "fetch_content",
          "canonical_hash": "sha256:742e811f2f381be564e79a25180d35688dcffaaf9bd9cff130e04407ec38afee",
          "description": "Fetch and extract the main text content from a webpage. Strips out navigation, headers, footers, scripts, and styles to return clean readable text. Use this after searching to read the full content of a specific result. Supports pagination for long pages via start_index and max_length. Repeated or paginated reads of the same URL reuse an in-memory cache (default TTL 5 minutes) so the page is downloaded once.",
          "is_mutating": false,
          "property_keys": [
