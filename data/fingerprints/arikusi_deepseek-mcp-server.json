    {
      "version": "1.0.0",
      "toolset_canonical_hash": "sha256:53b806a1dcb0aec9e45aed3b651ce9b9c55c8c7e63b1f2e143c24c1c6aaed2af",
      "release_date": null,
      "dependencies": {
        "zod": "^3.24.1",
        "openai": "^4.77.3",
        "@modelcontextprotocol/sdk": "^1.0.4"
      },
      "connections": [
        {
          "type": "http",
          "deploymentUrl": "https://deepseek-mcp-server--arikusi.run.tools",
          "configSchema": {
            "type": "object",
            "required": [
              "DEEPSEEK_API_KEY"
            ],
            "properties": {
              "DEEPSEEK_API_KEY": {
                "type": "string",
                "x-to": {
                  "header": "Authorization"
                },
                "x-from": {
                  "header": "DEEPSEEK_API_KEY"
                },
                "x-order": 0,
                "description": "Your DeepSeek API key (get one at platform.deepseek.com)"
              }
            }
          }
        }
      ],
      "capabilities": {
        "tools": true,
        "prompts": false,
        "resources": false,
        "verified_tools": true
      },
      "tool_signatures": [
        {
          "name": "deepseek_chat",
          "canonical_hash": "sha256:ea3ac1d9cf56da50e41a376be800ffde01fcb1adb7eb469180f52a72b1b35d7d",
          "description": "Chat with DeepSeek AI models (Chat + Reasoner). Supports function calling, thinking mode, JSON output, cost tracking.",
          "is_mutating": false,
          "property_keys": [
            "json_mode",
            "max_tokens",
            "messages",
            "model",
            "stream",
            "temperature",
            "thinking",
            "tool_choice",
            "tools"
          ],
          "required_keys": [],
          "parameter_types": {
            "model": "string",
            "tools": "array",
            "stream": "boolean",
            "messages": "array",
            "thinking": "object",
            "json_mode": "boolean",
            "max_tokens": "number",
            "temperature": "number"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "model": {
                "enum": [
                  "deepseek-chat",
                  "deepseek-reasoner"
                ],
                "type": "string",
                "default": "deepseek-chat"
              },
              "tools": {
                "type": "array",
                "description": "Tool definitions for function calling"
              },
              "stream": {
                "type": "boolean",
                "default": false
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Conversation messages"
              },
              "thinking": {
                "type": "object",
                "description": "Enable thinking mode"
              },
              "json_mode": {
                "type": "boolean",
                "description": "Enable JSON output mode"
              },
              "max_tokens": {
                "type": "number",
                "description": "Max tokens to generate"
              },
              "temperature": {
                "type": "number",
                "description": "Sampling temperature (0-2)"
              },
              "tool_choice": {
                "description": "Tool choice control"
              }
            }
          },
          "outputSchema": null,
          "description_hash": "sha256:8e74b818828b2b46531e75f039fef756292470cd62c492587c371624d0f12a80"
        }
      ],
