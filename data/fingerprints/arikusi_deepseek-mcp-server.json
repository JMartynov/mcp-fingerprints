{
  "passport_schema_version": "1.1.0",
  "package_name": "@arikusi/deepseek-mcp-server",
  "purl": "pkg:npm/@arikusi%2Fdeepseek-mcp-server",
  "ecosystem": "npm",
  "display_name": "@arikusi/deepseek-mcp-server",
  "description": "MCP server for DeepSeek AI models (Chat + Reasoner). Supports multi-turn sessions, model fallback with circuit breaker, function calling, thinking mode, JSON output, multimodal input, and cost tracking.",
  "repository_url": "https://deepseek-mcp-server--arikusi.run.tools",
  "homepage_url": null,
  "license": null,
  "keywords": [],
