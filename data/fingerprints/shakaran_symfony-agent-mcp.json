              },
              "allowed_paths": {
                "type": "string",
                "title": "Allowed paths",
                "x-order": 2,
                "description": "Colon-separated list of directories the server may read, e.g. /srv/app:/srv/other. Any path outside them is refused. Left empty, no allowlist is enforced."
              },
              "dynamic_tools": {
                "type": "boolean",
                "title": "Progressive tool discovery",
                "default": true,
                "x-order": 0,
                "description": "Leave on and the server advertises five discovery meta-tools; the other 1,672 become callable once you activate a category, so connecting costs ~828 tokens instead of ~154,000. Turn off to advertise every tool up front."
              },
              "session_secret": {
                "type": "string",
                "title": "Session secret",
                "x-order": 3,
                "description": "Set to require a session token on every call. Left empty, authentication is off."
              }
            }
