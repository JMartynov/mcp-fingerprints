        {
          "name": "driftLedger",
          "canonical_hash": "sha256:ab5bb0b512bbec46e59fe1a518631eac11a078cc87fb750e6b155da7d0f266bc",
          "description": "Contract diffs listed by fingerprint (keyed hashes of public registry names under a published key; recomputable, not anonymous) - a contract-diff record, not a safety verdict. Schema mcpindex.drift.ledger/4. One section per request: events (tool contract changes), context_events (server instructions and prompt metadata) or fleet_events (publisher-wide changes, counted once). When ledger_schema is mcpindex.drift.ledger/3, events omits tools whose only change was part of a publisher-wide change; look those up with /api/v1/drift/any. events and context_events pages hold up to 1,000 rows, newest first; fleet_events pages are packed by size. With no parameters this returns page 0 of events. To read a whole section, request ?section=<name> and follow next_cursor until it is null. A cursor stays in the generation it was issued for, so every page of one walk comes from the same hourly publish; a superseded generation stays readable for at least an hour after the next publish, then its cursors answer 410. The /3 single-response dump is retired.",
          "is_mutating": false,
          "property_keys": [
            "cursor",
            "section"
          ],
          "required_keys": [],
          "parameter_types": {
            "section": "string",
            "cursor": "string"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "section": {
                "type": "string",
                "description": "Which list to page through. With a cursor it may be omitted; a value that differs from the cursor's section is 400."
              },
              "cursor": {
                "type": "string",
                "description": "Opaque. Pass next_cursor from the previous page exactly as returned. A malformed cursor is 400."
              }
            },
            "required": []
          },
          "outputSchema": null,
          "description_hash": "sha256:d3d8e84f0f616bc18daccca96eb2e5ca13ef6b63b137a99a53f224477263d81c",
          "parameters": [
            {
              "name": "cursor",
              "type": "string",
              "description": "Opaque. Pass next_cursor from the previous page exactly as returned. A malformed cursor is 400.",
              "required": false,
              "default": null,
              "enum": null,
              "format": null,
              "items_type": null,
              "nested_properties": null
            },
            {
              "name": "section",
